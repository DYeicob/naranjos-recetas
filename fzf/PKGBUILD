# Receta de NaranjOS — generada por naranjos-tanda-6o7.sh
pkgname=fzf
pkgver=0.75.0
pkgrel=1
pkgdesc='Buscador difuso para la terminal (Ctrl+R, Ctrl+T…)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('MIT')
depends=()
makedepends=('go')
source=('https://github.com/junegunn/fzf/archive/v0.75.0/fzf-0.75.0.tar.gz')
sha256sums=('165f6e0c1b9ba082346233681e3f1d1374e37f9fd3c1d7b6dfe09659ab893faa')
build() {
  cd fzf-$pkgver
  export CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS="-trimpath -mod=mod" GOPATH="$srcdir/gopath" GOCACHE="$srcdir/gocache"
  go build -ldflags "-s -w -X main.version=$pkgver -X main.revision=naranjos" -o fzf .
}
package() { cd fzf-$pkgver; install -Dm755 fzf "$pkgdir/usr/bin/fzf"; install -Dm644 LICENSE "$pkgdir/usr/share/licenses/fzf/LICENSE"; }
