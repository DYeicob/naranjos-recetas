# Receta de NaranjOS — generada por naranjos-tanda-6o.sh
pkgname=wf-recorder
pkgver=0.6.0
pkgrel=1
pkgdesc='Grabar la pantalla en Wayland'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('MIT')
depends=('ffmpeg' 'wayland' 'pipewire' 'mesa' 'libdrm')
makedepends=('meson' 'ninja' 'wayland-protocols' 'scdoc')
source=('https://github.com/ammen99/wf-recorder/archive/v0.6.0/wf-recorder-0.6.0.tar.gz')
sha256sums=('52d2c952506d63708f9a8f1aacd4d6ca176287caf3507c8ff2882fa0390cb391')
build() {
  cd wf-recorder-$pkgver
  meson setup build --prefix=/usr --buildtype=release -D pulse=disabled -D pipewire=enabled -D default_audio_backend=pipewire
  ninja -C build
}
package() { cd wf-recorder-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
