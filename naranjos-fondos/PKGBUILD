package() {
  install -dm755 "$pkgdir/usr/share/backgrounds/naranjos" "$pkgdir/usr/share/naranjos/logo"
  install -m644 naranjos-0*.jpg naranjos-bloqueo.jpg "$pkgdir/usr/share/backgrounds/naranjos/"
  install -m644 naranjos-logo*.png "$pkgdir/usr/share/naranjos/logo/"
