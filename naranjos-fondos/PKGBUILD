package() {
  install -dm755 "$pkgdir/usr/share/backgrounds/naranjos" "$pkgdir/usr/share/naranjos/logo"
  install -m644 naranjos-0*.jpg naranjos-bloqueo.jpg "$pkgdir/usr/share/backgrounds/naranjos/"
  install -m644 naranjos-logo*.png "$pkgdir/usr/share/naranjos/logo/"
  # icono del sistema (versión plana, se lee mejor en tamaños pequeños)
  for n in 16 24 32 48 64 128 256 512; do
    install -Dm644 "naranjos-logo-plano-$n.png" "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/naranjos.png"
  done
  install -Dm644 naranjos-logo-256.png "$pkgdir/usr/share/pixmaps/naranjos.png"
  # el arte de NaranjOS (logo y fondos) se publica con CC BY-SA 4.0
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # fondos de los temas cítricos (recolorea.py, a partir de los originales; misma licencia)
  local f t
  for f in naranjos-*-*.jpg; do
    t=${f%.jpg}; t=${t##*-}
    install -Dm644 "$f" "$pkgdir/usr/share/backgrounds/naranjos/temas/$t/${f%-$t.jpg}.jpg"
  done
}
