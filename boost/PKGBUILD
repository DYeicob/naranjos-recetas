# Receta de NaranjOS — generada por naranjos-tanda-6q3.sh
pkgname=boost
pkgver=1.92.0
pkgrel=1
pkgdesc='Bibliotecas de C++ Boost (cabeceras e iostreams; las usa la escritura en chino)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('BSL-1.0')
depends=('zlib' 'bzip2' 'xz' 'zstd')
makedepends=()
source=('https://github.com/boostorg/boost/releases/download/boost-1.92.0/boost-1.92.0-b2-nodocs.tar.xz')
sha256sums=('ea7b982002cc9dfbe59b0b217b206f470dc75f3de0bb2973d844118934d82411')
build() {
  cd boost-$pkgver
  ./bootstrap.sh --prefix=/usr --with-libraries=iostreams
  ./b2 stage -j"$(nproc)" threading=multi link=shared variant=release
}
package() {
  cd boost-$pkgver
  ./b2 install --prefix="$pkgdir/usr" threading=multi link=shared variant=release
  install -Dm644 LICENSE_1_0.txt "$pkgdir/usr/share/licenses/boost/LICENSE"
}
