# Receta de NaranjOS — generada por naranjos-tanda-6f5.sh
pkgname=kbd
pkgver=2.10.0
pkgrel=1
pkgdesc='Teclados y tipos de letra de la consola (loadkeys, setfont…)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=()
source=('https://www.kernel.org/pub/linux/utils/kbd/kbd-2.10.0.tar.xz' 'https://www.linuxfromscratch.org/patches/lfs/13.1/kbd-2.10.0-backspace-1.patch')
sha256sums=('6e5ca4f8d76ee9e3a8db700b667f13e12aac9933828a64e1aaad93d26be9b479' '8be28dcb11420624a500f2ea4fe975f771174bffee50e54ec8cd295a2dec104e')
prepare() {
  cd kbd-$pkgver
  patch -Np1 -i ../kbd-2.10.0-backspace-1.patch
  sed -i '/RESIZECONS_PROGS=/s/yes/no/' configure
  sed -i 's/resizecons.8 //' docs/man/man8/Makefile.in
}
build()   { cd kbd-$pkgver; ./configure --prefix=/usr --disable-vlock; make; }
check()   { cd kbd-$pkgver; make check || echo "kbd: alguna prueba falló"; }
package() {
  cd kbd-$pkgver
  make DESTDIR="$pkgdir" install
  install -d "$pkgdir/usr/share/doc/kbd-$pkgver"
  cp -R docs/doc/. "$pkgdir/usr/share/doc/kbd-$pkgver"
}
