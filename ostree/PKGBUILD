# Receta de NaranjOS — generada por naranjos-tanda-5d.sh
pkgname=ostree
pkgver=2026.4
pkgrel=1
pkgdesc='OSTree: almacén de versiones del sistema (lo usa Flatpak)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('LGPL-2.0-or-later')
depends=('glib2' 'curl' 'openssl' 'libarchive' 'gpgme' 'fuse3' 'xz' 'zlib')
makedepends=()
source=('https://github.com/ostreedev/ostree/releases/download/v2026.4/libostree-2026.4.tar.xz')
sha256sums=('b26c9016eb03bb4ee52cc00c642d56e00fc79ae7faac6bf4aa317d7451339ef7')
build() { cd libostree-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libexecdir=/usr/lib --disable-static \
    --with-curl --without-soup --without-soup3 --with-openssl --with-libarchive --with-gpgme \
    --without-composefs --without-avahi --without-selinux --without-smack --without-ed25519-libsodium \
    --with-libsystemd --with-dracut=no --with-mkinitcpio=no --disable-man --disable-gtk-doc --disable-introspection
  make; }
package() { cd libostree-$pkgver; make DESTDIR="$pkgdir" install; }
