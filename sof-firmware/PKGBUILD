license=('BSD-3-Clause' 'custom')
depends=()
makedepends=()
source=('https://github.com/thesofproject/sof-bin/releases/download/v2026.09.2/sof-bin-2026.09.2.tar.gz')
sha256sums=('5f7bc30b2b5c1e6b0da55a33fc44e2b7f56ae9b06952edcde614f51ef6b943e1')
