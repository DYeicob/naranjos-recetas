package() {
  cd sof-bin-$pkgver
  install -dm755 "$pkgdir/usr/lib/firmware/intel"
  cp -a sof* "$pkgdir/usr/lib/firmware/intel/"
  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  cp -a LICENCE* Notice* "$pkgdir/usr/share/licenses/$pkgname/"
}
