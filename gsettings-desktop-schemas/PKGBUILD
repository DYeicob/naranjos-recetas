prepare() { cd gsettings-desktop-schemas-$pkgver; sed -i -r 's:"(/system):"/org/gnome\1:g' schemas/*.in; }
build()   { cd gsettings-desktop-schemas-$pkgver; meson setup build --prefix=/usr --buildtype=plain -D introspection=false; meson compile -C build; }
package() { cd gsettings-desktop-schemas-$pkgver; DESTDIR="$pkgdir" meson install -C build; }
