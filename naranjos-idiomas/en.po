msgid "VPN desconectada (kill switch quitado)"
msgstr "VPN disconnected (kill switch removed)"

#: peel/naranjos-peel:452
msgid "Perfil «%s» borrado"
msgstr "Profile «%s» deleted"

#: peel/naranjos-peel:459
msgid "La VPN se conectará sola al encender (con el último perfil usado)"
msgstr "The VPN will connect by itself at boot (with the last profile used)"

#: peel/naranjos-peel:462
msgid "La VPN ya no se conecta sola al encender"
msgstr "The VPN no longer connects by itself at boot"

#: peel/naranjos-peel:469
msgid "VPN gratis con Proton VPN (0 €, sin tarjeta):"
msgstr "Free VPN with Proton VPN (0 €, no card):"

#: peel/naranjos-peel:470
msgid "Crea una cuenta gratuita en https://account.protonvpn.com"
msgstr "Create a free account at https://account.protonvpn.com"

#: peel/naranjos-peel:471
msgid ""
"Downloads → WireGuard configuration → plataforma «GNU/Linux» → un servidor "
"gratuito → Create"
msgstr ""
"Downloads → WireGuard configuration → platform «GNU/Linux» → a free server →"
" Create"

