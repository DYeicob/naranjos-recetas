msgstr "Connecting to «%s»…"

#: peel/naranjos-peel:424
msgid "VPN conectada: %s (kill switch activo)"
msgstr "VPN connected: %s (kill switch on)"

#: peel/naranjos-peel:426
msgid ""
"el servidor aún no responde; Internet queda bloqueado hasta que conecte o "
"desconectes"
msgstr ""
"the server is not answering yet; the Internet stays blocked until it "
"connects or you disconnect"

#: peel/naranjos-peel:443
msgid "VPN desconectada (kill switch quitado)"
msgstr "VPN disconnected (kill switch removed)"

#: peel/naranjos-peel:469
msgid "Perfil «%s» borrado"
msgstr "Profile «%s» deleted"

