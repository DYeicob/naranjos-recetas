msgid ""
"Modo portal en %s: usa el DNS de la red (%s). Abre el navegador e inicia "
"sesión."
msgstr ""
"Portal mode on %s: using the network's DNS (%s). Open the browser and log "
"in."

#: peel/naranjos-peel:205
msgid "Cuando termines:"
msgstr "When you are done:"

#: peel/naranjos-peel:209
msgid "Falta lynis (zumo instala lynis)"
msgstr "lynis is missing (zumo instala lynis)"

#: peel/naranjos-peel:212
msgid "Informe completo:"
msgstr "Full report:"

#: peel/naranjos-peel:222
msgid ""
"Red local visible: impresoras, Chromecast y equipos por nombre (vuelve con: "
"naranjos-peel red-local no)"
msgstr ""
"Local network visible: printers, Chromecast and computers by name (undo "
"with: naranjos-peel red-local no)"

#: peel/naranjos-peel:226
msgid "Red local invisible: tu equipo no anuncia su nombre"
msgstr "Local network invisible: your computer does not announce its name"

#: peel/naranjos-peel:254 peel/naranjos-peel:436
msgid "conectada"
msgstr "connected"

#: peel/naranjos-peel:255
msgid "kill switch activo: si el túnel se cae, no sale nada a Internet"
msgstr ""
"kill switch on: if the tunnel goes down, nothing goes out to the Internet"

#: peel/naranjos-peel:259
msgid "último contacto con el servidor: hace %s s"
msgstr "last contact with the server: %s s ago"

#: peel/naranjos-peel:260
msgid "todavía sin contacto con el servidor"
msgstr "no contact with the server yet"

#: peel/naranjos-peel:267 peel/naranjos-peel:439
msgid ""
"sin perfiles. Importa uno con: naranjos-peel vpn importa <fichero.conf>"
msgstr "no profiles. Import one with: naranjos-peel vpn importa <file.conf>"

#: peel/naranjos-peel:278
msgid "Nombre de perfil no válido"
msgstr "Invalid profile name"

#: peel/naranjos-peel:305
msgid "El fichero no tiene una clave privada de WireGuard válida"
msgstr "The file has no valid WireGuard private key"

#: peel/naranjos-peel:306
msgid "El fichero no tiene la clave pública del servidor"
msgstr "The file has no server public key"

#: peel/naranjos-peel:307
msgid "La clave precompartida no es válida"
msgstr "The preshared key is not valid"

#: peel/naranjos-peel:308
msgid "Faltan la dirección (Address) o el servidor (Endpoint)"
msgstr "The address (Address) or the server (Endpoint) is missing"

