msgid "Perfil «%s» importado. Conéctate con: naranjos-peel vpn conecta %s"
msgstr "Profile «%s» imported. Connect with: naranjos-peel vpn conecta %s"

#: peel/naranjos-peel:324
msgid ""
"Ya puedes borrar el fichero original: la clave queda guardada solo para "
"root."
msgstr ""
"You can delete the original file now: the key is stored for root only."

#: peel/naranjos-peel:332
msgid ""
"No hay perfiles de VPN. Importa uno con: naranjos-peel vpn importa "
"<fichero.conf>"
msgstr ""
"There are no VPN profiles. Import one with: naranjos-peel vpn importa "
"<file.conf>"

#: peel/naranjos-peel:334 peel/naranjos-peel:446
msgid "No existe el perfil «%s»"
msgstr "Profile «%s» does not exist"

#: peel/naranjos-peel:336
msgid "El kernel no tiene WireGuard (módulo «wireguard»)"
msgstr "The kernel has no WireGuard («wireguard» module)"

#: peel/naranjos-peel:346
msgid "No encuentro la dirección del servidor %s"
msgstr "Cannot find the address of server %s"

#: peel/naranjos-peel:390
msgid "No se pudo poner el kill switch; no se ha conectado"
msgstr "Could not set the kill switch; not connected"

