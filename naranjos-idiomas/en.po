msgid "falta el nombre del paquete. Ejemplo: zumo %s firefox"
msgstr "the package name is missing. Example: zumo %s firefox"

#: zumo:23
msgid "el gestor de paquetes de %s"
msgstr "the %s package manager"

#: zumo:24
msgid "orden"
msgstr "command"

#: zumo:24
msgid "paquetes"
msgstr "packages"

#: zumo:25
msgid "Instalar y quitar"
msgstr "Install and remove"

#: zumo:28
msgid "Instala paquetes (y sus dependencias)"
msgstr "Installs packages (and their dependencies)"

#: zumo:29
msgid "Desinstala paquetes y lo que ya no haga falta"
msgstr "Removes packages and whatever is no longer needed"

