msgstr "imports a WireGuard profile (Proton VPN, etc.)"

#: peel/naranjos-peel:701
msgid "conecta (con kill switch)"
msgstr "connects (with kill switch)"

#: peel/naranjos-peel:702
msgid "desconecta"
msgstr "disconnects"

#: peel/naranjos-peel:703
msgid "perfiles guardados / borrar uno"
msgstr "saved profiles / delete one"

#: peel/naranjos-peel:704
