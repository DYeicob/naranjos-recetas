#: peel/naranjos-peel:508
msgid "conecta (con kill switch)"
msgstr "connects (with kill switch)"

#: peel/naranjos-peel:509
msgid "desconecta"
msgstr "disconnects"

#: peel/naranjos-peel:510
msgid "perfiles guardados / borrar uno"
msgstr "saved profiles / delete one"

#: peel/naranjos-peel:511
msgid "conectar sola al encender"
msgstr "connect automatically at boot"

#: peel/naranjos-peel:512
msgid "DNS siempre cifrado (si la red lo bloquea, no hay DNS)"
msgstr "always-encrypted DNS (if the network blocks it, there is no DNS)"

#: peel/naranjos-peel:513
