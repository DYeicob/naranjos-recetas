# Paquete propio de NaranjOS — generado por naranjos-tanda-6e2.sh (NO editar a mano)
pkgname=naranjos-idiomas
pkgver=0.1.7
pkgrel=1
pkgdesc='Idiomas de NaranjOS: orden naranjos-idioma, traducciones y guía para traducir'
arch=('any')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-3.0-or-later')
depends=('gettext' 'glibc')
makedepends=('gettext')
source=('en.po' 'naranjos-i18n.sh' 'naranjos-idioma' 'naranjos.pot' 'traducir.md')
sha256sums=('d56a8651d9b213a5d8dd55b51066533cac46ba413555c54f8a5a6d9a7f960d63' '7ddf7023754efbdfb55e2220b6e711ea2965ba28aa398bae55fab09169dbeecf' 'cf2cbe3401f2aad2a6745c0549084cc522683cce535340ba8cfa9001b4f0c63e' '89cb16705a91af484be178d4783723f5d7cd9565b057e6f3d8a98506178617a0' '16974bcae3c0d40d0d1f25137ab783e38e5024b6a87e433797f6f99642b11148')
package() {
  install -Dm755 naranjos-idioma   "$pkgdir/usr/bin/naranjos-idioma"
  install -Dm644 naranjos-i18n.sh  "$pkgdir/usr/lib/naranjos/naranjos-i18n.sh"
  install -Dm644 naranjos.pot      "$pkgdir/usr/share/naranjos/idiomas/naranjos.pot"
  install -Dm644 traducir.md       "$pkgdir/usr/share/doc/naranjos/traducir.md"
  local po l
  for po in *.po; do
    l=${po%.po}
    install -dm755 "$pkgdir/usr/share/locale/$l/LC_MESSAGES"
    msgfmt --check -o "$pkgdir/usr/share/locale/$l/LC_MESSAGES/naranjos.mo" "$po"
    install -Dm644 "$po" "$pkgdir/usr/share/naranjos/idiomas/$po"
  done
}
