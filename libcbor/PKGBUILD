# Receta de NaranjOS — generada por naranjos-tanda-6o.sh
pkgname=libcbor
pkgver=0.15.0
pkgrel=1
pkgdesc='Formato CBOR (lo usan las llaves FIDO2)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('MIT')
depends=()
makedepends=('cmake')
source=('https://github.com/PJK/libcbor/archive/v0.15.0/libcbor-0.15.0.tar.gz')
sha256sums=('c94145d3c22e67cff9a3325dc036b4545a49a42231553995be4947d52cf2ef57')
build() {
  cmake -S libcbor-$pkgver -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_BUILD_TYPE=Release \
    -D BUILD_SHARED_LIBS=ON -D WITH_EXAMPLES=OFF
  cmake --build build
}
package() { DESTDIR="$pkgdir" cmake --install build; }
