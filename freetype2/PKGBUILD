# Receta de NaranjOS — generada por naranjos-tanda-5a1.sh a partir de BLFS 13.1-systemd
pkgname=freetype2
pkgver=2.14.3
pkgrel=1
pkgdesc='Motor de tipografías FreeType'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('custom')
depends=('libpng' 'zlib' 'bzip2')
makedepends=()
source=('https://downloads.sourceforge.net/freetype/freetype-2.14.3.tar.xz')
sha256sums=('36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f')
provides=('freetype' 'libfreetype.so')
prepare() { cd freetype-$pkgver
  sed -ri "s:.*(AUX_MODULES.*valid):\1:" modules.cfg
  sed -r "s:.*(#.*SUBPIXEL_RENDERING) .*:\1:" -i include/freetype/config/ftoption.h; }
build()   { cd freetype-$pkgver
  ./configure --prefix=/usr --disable-static --enable-freetype-config --with-harfbuzz=dynamic; make; }
package() { cd freetype-$pkgver; make DESTDIR="$pkgdir" install; }
