# Receta de NaranjOS — generada por naranjos-tanda-6f2.sh
pkgname=readline
pkgver=8.3
pkgrel=1
pkgdesc='Edición de la línea de órdenes (la usan bash, python…)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-3.0-or-later')
depends=('glibc' 'ncurses')
makedepends=()
source=('https://ftpmirror.gnu.org/readline/readline-8.3.tar.gz')
sha256sums=('fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc')
prepare() {
  cd readline-$pkgver
  sed -i '/MV.*old/d' Makefile.in
  sed -i '/{OLDSUFF}/c:' support/shlib-install
  sed -i 's/-Wl,-rpath,[^ ]*//' support/shobj-conf
  sed -e '270a\
     else\
       chars_avail = 1;'      \
      -e '288i\   result = -1;' \
      -i.orig input.c
}
build() {
  cd readline-$pkgver
  ./configure --prefix=/usr --disable-static --with-curses --docdir=/usr/share/doc/readline-$pkgver
  make SHLIB_LIBS="-lncursesw"
}
package() {
  cd readline-$pkgver
  make SHLIB_LIBS="-lncursesw" DESTDIR="$pkgdir" install
  install -d "$pkgdir/usr/share/doc/readline-$pkgver"
  install -m644 doc/*.{ps,pdf,html,dvi} "$pkgdir/usr/share/doc/readline-$pkgver"
}
