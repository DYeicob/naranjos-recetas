[Unit]
Description=NaranjOS peel: protección USB
Documentation=file:/usr/share/doc/naranjos/peel.md
DefaultDependencies=no
After=systemd-udevd.service local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/naranjos/naranjos-usb aplica

[Install]
WantedBy=sysinit.target
