#!/bin/bash
# naranjos-peel — la piel de NaranjOS: centro de seguridad
# (cortafuegos, DNS cifrado, endurecimiento del kernel, MAC aleatoria y auditoría)
set -u
VERSION="0.1.0"
O=$'\e[1;38;5;208m'; G=$'\e[1;32m'; R=$'\e[1;31m'; A=$'\e[1;33m'; D=$'\e[2m'; Z=$'\e[0m'
[ -t 1 ] || { O=; G=; R=; A=; D=; Z=; }
PUERTOS=/etc/nftables.d/naranjos-puertos.nft
DNS_ESTRICTO=/etc/systemd/resolved.conf.d/60-naranjos-peel-estricto.conf
IWD=/etc/iwd/main.conf
STUB=/run/systemd/resolve/stub-resolv.conf

bien(){  printf '  %s✔%s %-20s %s\n' "$G" "$Z" "$1" "$2"; }
aviso(){ printf '  %s!%s %-20s %s\n' "$A" "$Z" "$1" "$2"; }
mal(){   printf '  %s✘%s %-20s %s\n' "$R" "$Z" "$1" "$2"; }
die(){   echo "${R}naranjos-peel:${Z} $*" >&2; exit 1; }
como_root(){ [ "$(id -u)" = 0 ] || exec sudo "$0" "$@"; }
sysctl_val(){ local f="/proc/sys/${1//.//}"; [ -r "$f" ] && cat "$f" || echo "?"; }

# lo que comprueba el endurecimiento del kernel (clave:valor esperado)
SYSCTL_NARANJOS="kernel.kptr_restrict:2 kernel.dmesg_restrict:1 kernel.unprivileged_bpf_disabled:1
  net.core.bpf_jit_harden:2 fs.protected_symlinks:1 fs.protected_hardlinks:1 fs.protected_fifos:2
  fs.protected_regular:2 fs.suid_dumpable:0 net.ipv4.conf.all.accept_redirects:0
  net.ipv6.conf.all.accept_redirects:0 net.ipv4.conf.all.send_redirects:0
  net.ipv4.conf.all.accept_source_route:0 net.ipv4.tcp_syncookies:1 net.ipv4.conf.all.rp_filter:2"

recargar_cortafuegos(){
  nft -c -f /etc/nftables.conf || die "Las reglas tienen un error; no se ha cambiado nada"
  systemctl reload-or-restart nftables.service || die "No se pudo recargar el cortafuegos"
}

puertos_abiertos(){
  [ -s "$PUERTOS" ] && sed -n 's/^add rule inet naranjos abiertos \([a-z]*\) dport \([0-9]*\).*/\2\/\1/p' "$PUERTOS" | paste -sd' ' -
}

# ------------------------------------------------------------------------------------------
estado(){
  echo "${O}NaranjOS · peel${Z} ${D}(la piel que protege la naranja)${Z}"
  echo
  echo "${O}Cortafuegos${Z}"
  if systemctl is-active -q nftables.service 2>/dev/null; then
    bien "cortafuegos" "activo (entrante cerrado, saliente abierto)"
  else
    mal "cortafuegos" "APAGADO → sudo systemctl enable --now nftables"
  fi
  local p; p=$(puertos_abiertos)
  if [ -n "$p" ]; then aviso "puertos abiertos" "$p"; else bien "puertos abiertos" "ninguno"; fi

  echo; echo "${O}DNS${Z}"
  if [ "$(readlink -f /etc/resolv.conf)" != "$STUB" ]; then
    mal "DNS del sistema" "/etc/resolv.conf no usa systemd-resolved (el DNS NO va cifrado)"
  elif [ -f "$DNS_ESTRICTO" ]; then
    bien "DNS cifrado" "estricto (solo DNS-over-TLS)"
  else
    bien "DNS cifrado" "flexible (cifra siempre que la red lo permite)"
  fi
  local srv; srv=$(resolvectl dns 2>/dev/null | awk -F': ' '/^Global/{print $2}')
  [ -n "$srv" ] && echo "    ${D}servidores: $srv${Z}"
  resolvectl status 2>/dev/null | grep -q '+DNSOverTLS' || \
    echo "    ${D}(systemd-resolved no dice que soporte DNS-over-TLS: puede ir sin cifrar)${Z}"

  echo; echo "${O}WiFi${Z}"
  if grep -q '^AddressRandomization=network' "$IWD" 2>/dev/null; then
    bien "MAC aleatoria" "sí (una distinta por cada red; se aplica al reiniciar iwd)"
  else
    aviso "MAC aleatoria" "no configurada"
  fi

  echo; echo "${O}Kernel${Z}"
  local k v ok=0 tot=0 fallan=""
  for k in $SYSCTL_NARANJOS; do
    tot=$((tot+1)); v=$(sysctl_val "${k%%:*}")
    if [ "$v" = "${k##*:}" ]; then ok=$((ok+1)); else fallan="$fallan ${k%%:*}"; fi
  done
  if [ "$ok" = "$tot" ]; then bien "endurecimiento" "aplicado ($ok/$tot)"
  else aviso "endurecimiento" "$ok/$tot (reinicia para aplicarlo todo)"; echo "    ${D}faltan:$fallan${Z}"; fi
  local sb; sb=$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | awk '{print $NF}')
  case "$sb" in 1) bien "Secure Boot" "activo";; 0) aviso "Secure Boot" "desactivado";; *) aviso "Secure Boot" "desconocido";; esac

  echo; echo "${O}Auditoría${Z}"
  if [ -r /var/log/lynis-report.dat ]; then
    local idx; idx=$(sed -n 's/^hardening_index=//p' /var/log/lynis-report.dat)
    bien "última auditoría" "puntuación Lynis: ${idx:-?}/100"
  elif [ -e /var/log/lynis-report.dat ]; then
    echo "    ${D}Hay una auditoría hecha; para ver la puntuación: sudo naranjos-peel${Z}"
  else
    echo "    ${D}Haz una con: naranjos-peel auditoria${Z}"
  fi
  echo
  echo "${D}Más: naranjos-peel ayuda${Z}"
}

# Para la barra (Waybar): JSON con el escudo
barra(){
  local cls=ok txt tip p
  if systemctl is-active -q nftables.service 2>/dev/null; then
    tip="Cortafuegos activo"
    p=$(puertos_abiertos); [ -n "$p" ] && { tip="$tip · abiertos: $p"; cls=aviso; }
  else
    tip="¡Cortafuegos APAGADO!"; cls=mal
  fi
  [ "$(readlink -f /etc/resolv.conf)" = "$STUB" ] && tip="$tip\\nDNS cifrado" || { tip="$tip\\nDNS sin cifrar"; [ "$cls" = ok ] && cls=aviso; }
  txt=$(printf '\xef\x84\xb2')   # escudo (Nerd Font)
  printf '{"text":"%s","class":"%s","tooltip":"NaranjOS peel\\n%s\\n(clic: centro de seguridad · Super + Ctrl + S)"}\n' "$txt" "$cls" "$tip"
}

# ------------------------------------------------------------------------------------------
puerto_valido(){
  local p="${1%%/*}" pr="tcp"; [[ "$1" == */* ]] && pr="${1##*/}"
  [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || die "Puerto no válido: $1 (ejemplo: 22/tcp)"
  [[ "$pr" == tcp || "$pr" == udp ]] || die "Protocolo no válido: $pr (tcp o udp)"
  REGLA="add rule inet naranjos abiertos $pr dport $p accept comment \"naranjos-peel\""
}
abre(){
  [ $# -ge 1 ] || die "Uso: naranjos-peel abre <puerto>[/tcp|/udp]"
  como_root abre "$@"
  puerto_valido "$1"; mkdir -p /etc/nftables.d; touch "$PUERTOS"
  grep -qxF "$REGLA" "$PUERTOS" && { echo "Ese puerto ya estaba abierto."; return; }
  cp "$PUERTOS" "$PUERTOS.antes"; echo "$REGLA" >> "$PUERTOS"
  if ! nft -c -f /etc/nftables.conf; then mv "$PUERTOS.antes" "$PUERTOS"; die "Regla no válida; no se ha cambiado nada"; fi
  rm -f "$PUERTOS.antes"; recargar_cortafuegos; echo "${G}✔${Z} Abierto: $1"
}
cierra(){
  [ $# -ge 1 ] || die "Uso: naranjos-peel cierra <puerto>[/tcp|/udp]"
  como_root cierra "$@"
  puerto_valido "$1"; [ -f "$PUERTOS" ] && grep -qxF "$REGLA" "$PUERTOS" || { echo "Ese puerto no estaba abierto."; return; }
  grep -vxF "$REGLA" "$PUERTOS" > "$PUERTOS.nuevo" || true; mv "$PUERTOS.nuevo" "$PUERTOS"
  recargar_cortafuegos; echo "${G}✔${Z} Cerrado: $1"
}

# ------------------------------------------------------------------------------------------
dns(){
  case "${1:-}" in
    estricto)
      como_root dns estricto; mkdir -p "${DNS_ESTRICTO%/*}"
      printf '# NaranjOS peel · DNS cifrado estricto (lo creó «naranjos-peel dns estricto»)\n[Resolve]\nDNSOverTLS=yes\n' > "$DNS_ESTRICTO"
      systemctl restart systemd-resolved
      echo "${G}✔${Z} DNS estricto: si la red bloquea DNS-over-TLS no habrá DNS (vuelve con: naranjos-peel dns flexible)";;
    flexible)
      como_root dns flexible; rm -f "$DNS_ESTRICTO"
      systemctl restart systemd-resolved; echo "${G}✔${Z} DNS flexible: cifrado siempre que la red lo permita";;
    *) die "Uso: naranjos-peel dns estricto|flexible";;
  esac
}

# Redes con «portal cautivo» (hoteles, trenes…): usan su propio DNS para mostrar la página de acceso
portal(){
  como_root portal "$@"
  local dev gw
  dev=$(ip route show default 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="dev"){print $(i+1); exit}}')
  gw=$(ip route show default 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="via"){print $(i+1); exit}}')
  [ -n "$dev" ] || die "No hay conexión de red"
  if [ "${1:-}" = "fin" ]; then
    resolvectl revert "$dev"; echo "${G}✔${Z} Vuelve el DNS cifrado de NaranjOS en $dev"; return
  fi
  [ -n "$gw" ] || die "No encuentro el router de $dev"
  resolvectl dns "$dev" "$gw" && resolvectl domain "$dev" '~.' && resolvectl dnsovertls "$dev" no
  echo "${G}✔${Z} Modo portal en $dev: usa el DNS de la red ($gw). Abre el navegador e inicia sesión."
  echo "  Cuando termines: ${O}naranjos-peel portal fin${Z}"
}

auditoria(){
  command -v lynis >/dev/null || die "Falta lynis (zumo instala lynis)"
  como_root auditoria "$@"
  lynis audit system "$@"
  echo; echo "${O}Informe completo:${Z} /var/log/lynis-report.dat · registro: /var/log/lynis.log"
}

bloqueados(){
  como_root bloqueados "$@"
  journalctl -k -g 'naranjos-cortafuegos' --since "${1:-today}" --no-pager | tail -n 40
}

ayuda(){
  cat << EOF
${O}naranjos-peel${Z} $VERSION — centro de seguridad de NaranjOS

  ${O}naranjos-peel${Z}                     estado de todo (cortafuegos, DNS, WiFi, kernel…)
  ${O}naranjos-peel abre 22/tcp${Z}         abre un puerto de entrada (tcp por defecto)
  ${O}naranjos-peel cierra 22/tcp${Z}       lo vuelve a cerrar
  ${O}naranjos-peel bloqueados${Z}          lo último que ha frenado el cortafuegos (hoy)
  ${O}naranjos-peel dns estricto${Z}        DNS siempre cifrado (si la red lo bloquea, no hay DNS)
  ${O}naranjos-peel dns flexible${Z}        cifrado cuando se puede (por defecto)
  ${O}naranjos-peel portal${Z} [fin]        para WiFi de hotel/tren con página de acceso
  ${O}naranjos-peel auditoria${Z}           auditoría completa del sistema con Lynis

En el escritorio: Super + Ctrl + S, o clic en el escudo de la barra.
Más información: /usr/share/doc/naranjos/peel.md
EOF
}

case "${1:-estado}" in
  estado)              estado ;;
  barra)               barra ;;
  abre)      shift;    abre "$@" ;;
  cierra)    shift;    cierra "$@" ;;
  bloqueados) shift;   bloqueados "$@" ;;
  dns)       shift;    dns "$@" ;;
  portal)    shift;    portal "$@" ;;
  auditoria|auditoría) shift; auditoria "$@" ;;
  ayuda|-h|--help)     ayuda ;;
  version|--version)   echo "naranjos-peel $VERSION" ;;
  *) ayuda; exit 1 ;;
esac
