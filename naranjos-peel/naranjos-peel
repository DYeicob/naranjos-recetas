  _ 'VPN: Super + Ctrl + V, o clic derecho en el escudo.'; echo
  printf '%s %s\n' "$(_ 'Más información:')" "$(naranjos_traducido /usr/share/doc/naranjos peel.md)"
}

case "${1:-estado}" in
  estado|status)       estado ;;
  barra)               barra ;;
  abre|open)  shift;   abre "$@" ;;
  cierra|close) shift; cierra "$@" ;;
  bloqueados|blocked) shift; bloqueados "$@" ;;
  dns)       shift;    dns "$@" ;;
  portal)    shift;    portal "$@" ;;
