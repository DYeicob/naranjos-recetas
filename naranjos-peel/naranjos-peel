#!/bin/bash
# naranjos-peel — la piel de NaranjOS: centro de seguridad
# (cortafuegos, VPN, antivirus, DNS cifrado, endurecimiento del kernel, MAC aleatoria y auditoría)
# Textos traducibles con gettext (dominio «naranjos»): /usr/share/locale/<idioma>/LC_MESSAGES/naranjos.mo
set -u
VERSION="0.3.0"
. /usr/lib/naranjos/naranjos-i18n.sh
O=$'\e[1;38;5;208m'; G=$'\e[1;32m'; R=$'\e[1;31m'; A=$'\e[1;33m'; D=$'\e[2m'; Z=$'\e[0m'
[ -t 1 ] || { O=; G=; R=; A=; D=; Z=; }
PUERTOS=/etc/nftables.d/naranjos-puertos.nft
DNS_ESTRICTO=/etc/systemd/resolved.conf.d/60-naranjos-peel-estricto.conf
IWD=/etc/iwd/main.conf
RED_LOCAL_DNS=/etc/systemd/resolved.conf.d/60-naranjos-peel-red-local.conf
RED_LOCAL_FW=/etc/nftables.d/naranjos-red-local.nft
STUB=/run/systemd/resolve/stub-resolv.conf

bien(){  printf '  %s✔%s %-22s %s\n' "$G" "$Z" "$1" "$2"; }
aviso(){ printf '  %s!%s %-22s %s\n' "$A" "$Z" "$1" "$2"; }
mal(){   printf '  %s✘%s %-22s %s\n' "$R" "$Z" "$1" "$2"; }
nota(){  printf '    %s%s%s\n' "$D" "$1" "$Z"; }
titulo(){ printf '\n%s%s%s\n' "$O" "$1" "$Z"; }
hecho(){ printf '%s✔%s %s\n' "$G" "$Z" "$1"; }
die(){   printf '%snaranjos-peel:%s %s\n' "$R" "$Z" "$1" >&2; exit 1; }
como_root(){ [ "$(id -u)" = 0 ] || exec sudo "$0" "$@"; }
sysctl_val(){ local f="/proc/sys/${1//.//}"; [ -r "$f" ] && cat "$f" || echo "?"; }

# lo que comprueba el endurecimiento del kernel (clave:valor esperado)
SYSCTL_NARANJOS="kernel.kptr_restrict:2 kernel.dmesg_restrict:1 kernel.unprivileged_bpf_disabled:1
  net.core.bpf_jit_harden:2 fs.protected_symlinks:1 fs.protected_hardlinks:1 fs.protected_fifos:2
  fs.protected_regular:2 fs.suid_dumpable:0 net.ipv4.conf.all.accept_redirects:0
  net.ipv6.conf.all.accept_redirects:0 net.ipv4.conf.all.send_redirects:0
  net.ipv4.conf.all.accept_source_route:0 net.ipv4.tcp_syncookies:1 net.ipv4.conf.all.rp_filter:2"

recargar_cortafuegos(){
  nft -c -f /etc/nftables.conf || die "$(_ 'Las reglas tienen un error; no se ha cambiado nada')"
  systemctl reload-or-restart nftables.service || die "$(_ 'No se pudo recargar el cortafuegos')"
}

puertos_abiertos(){
  [ -s "$PUERTOS" ] && sed -n 's/^add rule inet naranjos abiertos \([a-z]*\) dport \([0-9]*\).*/\2\/\1/p' "$PUERTOS" | paste -sd' ' -
}

# ------------------------------------------------------------------------------------------
estado(){
  printf '%sNaranjOS · peel%s %s%s%s\n' "$O" "$Z" "$D" "$(_ '(la piel que protege la naranja)')" "$Z"

  titulo "$(_ 'Cortafuegos')"
  if systemctl is-active -q nftables.service 2>/dev/null; then
    bien "$(_ 'cortafuegos')" "$(_ 'activo (entrante cerrado, saliente abierto)')"
  else
    mal "$(_ 'cortafuegos')" "$(_ 'APAGADO')  →  sudo systemctl enable --now nftables"
  fi
  local p; p=$(puertos_abiertos)
  if [ -n "$p" ]; then aviso "$(_ 'puertos abiertos')" "$p"; else bien "$(_ 'puertos abiertos')" "$(_ 'ninguno')"; fi

  titulo "VPN"
  vpn_estado

  titulo "$(_ 'Antivirus')"
  av_estado

  titulo "DNS"
  if [ "$(readlink -f /etc/resolv.conf)" != "$STUB" ]; then
    mal "$(_ 'DNS del sistema')" "$(_ '/etc/resolv.conf no usa systemd-resolved (el DNS NO va cifrado)')"
  elif [ -f "$DNS_ESTRICTO" ]; then
    bien "$(_ 'DNS cifrado')" "$(_ 'estricto (solo DNS-over-TLS)')"
  else
    bien "$(_ 'DNS cifrado')" "$(_ 'flexible (cifra siempre que la red lo permite)')"
  fi
  local srv; srv=$(resolvectl dns 2>/dev/null | awk -F': ' '/^Global/{print $2}')
  # shellcheck disable=SC2059
  [ -n "$srv" ] && nota "$(printf "$(_ 'servidores: %s')" "$srv")"
  resolvectl status 2>/dev/null | grep -qE '\+DNSOverTLS|DNSOverTLS=opportunistic' || \
    nota "$(_ '(systemd-resolved no dice que use DNS-over-TLS: puede ir sin cifrar)')"
  if [ -f "$RED_LOCAL_DNS" ]; then
    aviso "$(_ 'red local')" "$(_ 'visible (LLMNR/mDNS encendidos)')  →  naranjos-peel red-local no"
  else
    bien "$(_ 'red local')" "$(_ 'invisible (tu nombre de equipo no se anuncia)')"
  fi

  titulo "WiFi"
  if grep -q '^AddressRandomization=network' "$IWD" 2>/dev/null; then
    bien "$(_ 'MAC aleatoria')" "$(_ 'sí (una distinta por cada red; se aplica al reiniciar iwd)')"
  else
    aviso "$(_ 'MAC aleatoria')" "$(_ 'no configurada')"
  fi

  titulo "Kernel"
  local k v ok=0 tot=0 fallan="" ocultos=0
  for k in $SYSCTL_NARANJOS; do
    v=$(sysctl_val "${k%%:*}")
    # algunos ajustes solo los puede leer root: sin sudo no se cuentan
    [ "$v" = "?" ] && { ocultos=$((ocultos+1)); continue; }
    tot=$((tot+1))
    if [ "$v" = "${k##*:}" ]; then ok=$((ok+1)); else fallan="$fallan ${k%%:*}"; fi
  done
  # shellcheck disable=SC2059
  if [ "$ok" = "$tot" ]; then
    bien "$(_ 'endurecimiento')" "$(printf "$(_ 'aplicado (%s/%s)')" "$ok" "$tot")"
    [ "$ocultos" -gt 0 ] && nota "$(printf "$(_ '(%s más solo se pueden comprobar con: sudo naranjos-peel)')" "$ocultos")"
  else
    aviso "$(_ 'endurecimiento')" "$(printf "$(_ '%s/%s (reinicia para aplicarlo todo)')" "$ok" "$tot")"
    nota "$(_ 'faltan:')$fallan"
  fi
  local sb; sb=$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | awk '{print $NF}')
  case "$sb" in
    1) bien  "Secure Boot" "$(_ 'activo')";;
    0) aviso "Secure Boot" "$(_ 'desactivado')";;
    *) aviso "Secure Boot" "$(_ 'desconocido')";;
  esac

  titulo "$(_ 'Auditoría')"
  if [ -r /var/log/lynis-report.dat ]; then
    local idx; idx=$(sed -n 's/^hardening_index=//p' /var/log/lynis-report.dat)
    # shellcheck disable=SC2059
    bien "$(_ 'última auditoría')" "$(printf "$(_ 'puntuación Lynis: %s/100')" "${idx:-?}")"
  elif [ -e /var/log/lynis-report.dat ]; then
    nota "$(_ 'Hay una auditoría hecha; para ver la puntuación: sudo naranjos-peel')"
  else
    nota "$(_ 'Haz una con: naranjos-peel auditoria')"
  fi
  echo
  nota "$(_ 'Más: naranjos-peel ayuda')"
}

# Para la barra (Waybar): JSON con el escudo
barra(){
  local cls=ok tip p
  if systemctl is-active -q nftables.service 2>/dev/null; then
    tip="$(_ 'Cortafuegos activo')"
    p=$(puertos_abiertos); [ -n "$p" ] && { tip="$tip · $(_ 'abiertos:') $p"; cls=aviso; }
  else
    tip="$(_ '¡Cortafuegos APAGADO!')"; cls=mal
  fi
  local txt a; txt=$(printf '\xef\x84\xb2'); a=$(vpn_activa)
  if [ -n "$a" ] && vpn_tunel; then
    txt="$txt $(printf '\xef\x80\xa3')"; tip="$tip\\nVPN: $a"; [ "$cls" = ok ] && cls=vpn
  elif [ -n "$a" ]; then
    tip="$tip\\nVPN: $(_ 'caída') — $(_ 'Internet bloqueado por el kill switch')"; cls=mal
  else
    tip="$tip\\nVPN: $(_ 'desconectada')"
  fi
  if [ "$(readlink -f /etc/resolv.conf)" = "$STUB" ]; then tip="$tip\\n$(_ 'DNS cifrado')"
  else tip="$tip\\n$(_ 'DNS sin cifrar')"; [ "$cls" = ok ] && cls=aviso; fi
  if command -v clamscan >/dev/null; then
    local fa nq; fa=$(av_firmas_fecha); nq=$(av_n_cuarentena)
    if [ -z "$fa" ] || [ $(( $(date +%s) - fa )) -gt 259200 ]; then
      tip="$tip\\n$(_ 'Antivirus: firmas sin actualizar')"; [ "$cls" = mal ] || cls=aviso
    else tip="$tip\\n$(_ 'Antivirus: al día')"; fi
    # shellcheck disable=SC2059
    [ "$nq" -gt 0 ] && { tip="$tip\\n$(printf "$(_ 'Cuarentena: %s fichero(s)')" "$nq")"; [ "$cls" = mal ] || cls=aviso; }
  fi
  tip="$tip\\n($(_ 'clic: centro de seguridad') · Super + Ctrl + S)"
  tip="$tip\\n($(_ 'clic derecho: conectar/desconectar la VPN') · Super + Ctrl + V)"
  printf '{"text":"%s","class":"%s","tooltip":"NaranjOS peel\\n%s"}\n' "$txt" "$cls" "${tip//\"/\'}"
}

# ------------------------------------------------------------------------------------------
puerto_valido(){
  local p="${1%%/*}" pr="tcp"; [[ "$1" == */* ]] && pr="${1##*/}"
  # shellcheck disable=SC2059
  [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || die "$(printf "$(_ 'Puerto no válido: %s (ejemplo: 22/tcp)')" "$1")"
  # shellcheck disable=SC2059
  [[ "$pr" == tcp || "$pr" == udp ]] || die "$(printf "$(_ 'Protocolo no válido: %s (tcp o udp)')" "$pr")"
  REGLA="add rule inet naranjos abiertos $pr dport $p accept comment \"naranjos-peel\""
}
abre(){
  [ $# -ge 1 ] || die "$(_ 'Uso:') naranjos-peel abre <puerto>[/tcp|/udp]"
  como_root abre "$@"
  puerto_valido "$1"; mkdir -p /etc/nftables.d; touch "$PUERTOS"
  grep -qxF "$REGLA" "$PUERTOS" && { _ 'Ese puerto ya estaba abierto.'; echo; return; }
  cp "$PUERTOS" "$PUERTOS.antes"; echo "$REGLA" >> "$PUERTOS"
  if ! nft -c -f /etc/nftables.conf; then mv "$PUERTOS.antes" "$PUERTOS"; die "$(_ 'Regla no válida; no se ha cambiado nada')"; fi
  rm -f "$PUERTOS.antes"; recargar_cortafuegos; hecho "$(_ 'Abierto:') $1"
}
cierra(){
  [ $# -ge 1 ] || die "$(_ 'Uso:') naranjos-peel cierra <puerto>[/tcp|/udp]"
  como_root cierra "$@"
  puerto_valido "$1"; [ -f "$PUERTOS" ] && grep -qxF "$REGLA" "$PUERTOS" || { _ 'Ese puerto no estaba abierto.'; echo; return; }
  grep -vxF "$REGLA" "$PUERTOS" > "$PUERTOS.nuevo" || true; mv "$PUERTOS.nuevo" "$PUERTOS"
  recargar_cortafuegos; hecho "$(_ 'Cerrado:') $1"
}

# ------------------------------------------------------------------------------------------
dns(){
  case "${1:-}" in
    estricto)
      como_root dns estricto; mkdir -p "${DNS_ESTRICTO%/*}"
      printf '# NaranjOS peel · DNS-over-TLS estricto (naranjos-peel dns estricto)\n[Resolve]\nDNSOverTLS=yes\n' > "$DNS_ESTRICTO"
      systemctl restart systemd-resolved
      hecho "$(_ 'DNS estricto: si la red bloquea DNS-over-TLS no habrá DNS (vuelve con: naranjos-peel dns flexible)')";;
    flexible)
      como_root dns flexible; rm -f "$DNS_ESTRICTO"
      systemctl restart systemd-resolved; hecho "$(_ 'DNS flexible: cifrado siempre que la red lo permita')";;
    *) die "$(_ 'Uso:') naranjos-peel dns estricto|flexible";;
  esac
}

# Redes con «portal cautivo» (hoteles, trenes…): usan su propio DNS para mostrar la página de acceso
portal(){
  como_root portal "$@"
  local dev gw
  dev=$(ip route show default 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="dev"){print $(i+1); exit}}')
  gw=$(ip route show default 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="via"){print $(i+1); exit}}')
  [ -n "$dev" ] || die "$(_ 'No hay conexión de red')"
  # shellcheck disable=SC2059
  if [ "${1:-}" = "fin" ]; then
    resolvectl revert "$dev"; hecho "$(printf "$(_ 'Vuelve el DNS cifrado de NaranjOS en %s')" "$dev")"; return
  fi
  # shellcheck disable=SC2059
  [ -n "$gw" ] || die "$(printf "$(_ 'No encuentro el router de %s')" "$dev")"
  resolvectl dns "$dev" "$gw" && resolvectl domain "$dev" '~.' && resolvectl dnsovertls "$dev" no
  # shellcheck disable=SC2059
  hecho "$(printf "$(_ 'Modo portal en %s: usa el DNS de la red (%s). Abre el navegador e inicia sesión.')" "$dev" "$gw")"
  printf '  %s %snaranjos-peel portal fin%s\n' "$(_ 'Cuando termines:')" "$O" "$Z"
}

auditoria(){
  command -v lynis >/dev/null || die "$(_ 'Falta lynis (zumo instala lynis)')"
  como_root auditoria "$@"
  lynis audit system "$@"
  printf '\n%s%s%s /var/log/lynis-report.dat · /var/log/lynis.log\n' "$O" "$(_ 'Informe completo:')" "$Z"
}

red_local(){
  case "${1:-}" in
    si|sí|yes|on)
      como_root red-local si; mkdir -p "${RED_LOCAL_DNS%/*}" /etc/nftables.d
      printf '# NaranjOS peel · red local visible (naranjos-peel red-local si)\n[Resolve]\nLLMNR=yes\nMulticastDNS=yes\n' > "$RED_LOCAL_DNS"
      printf '# NaranjOS peel · red local (LLMNR y mDNS) — naranjos-peel red-local si\nadd rule inet naranjos abiertos udp dport { 5353, 5355 } accept comment "naranjos-peel red-local"\nadd rule inet naranjos abiertos tcp dport 5355 accept comment "naranjos-peel red-local"\n' > "$RED_LOCAL_FW"
      recargar_cortafuegos; systemctl restart systemd-resolved
      hecho "$(_ 'Red local visible: impresoras, Chromecast y equipos por nombre (vuelve con: naranjos-peel red-local no)')";;
    no|off)
      como_root red-local no; rm -f "$RED_LOCAL_DNS" "$RED_LOCAL_FW"
      recargar_cortafuegos; systemctl restart systemd-resolved
      hecho "$(_ 'Red local invisible: tu equipo no anuncia su nombre')";;
    *) die "$(_ 'Uso:') naranjos-peel red-local si|no";;
  esac
}

# ==========================================================================================
#  VPN de NaranjOS (WireGuard + systemd-networkd, sin wg-quick)
#   · perfiles en /etc/naranjos/vpn/<nombre>.perfil (+ .key / .psk, solo root y systemd-network)
#   · al conectar: interfaz «naranjos-vpn» en /run (desaparece al reiniciar) y kill switch:
#     si el túnel se cae, no sale nada a Internet hasta que desconectes
# ==========================================================================================
VPN_DIR=/etc/naranjos/vpn
VPN_IF=naranjos-vpn
VPN_MARCA=0x6e6a            # «nj»: marca de los paquetes del propio túnel
VPN_TABLA=28266             # tabla de rutas del túnel (0x6e6a)
VPN_RUN=/run/naranjos
VPN_NET=/run/systemd/network
VPN_KS="$VPN_RUN/nftables/vpn.nft"
VPN_ULTIMA=/etc/naranjos/vpn-ultima   # último perfil usado (solo el nombre, lo pueden leer todos)

# ¿existe el túnel? (sin «ip», que está en /usr/sbin y los usuarios no lo tienen en el PATH)
vpn_tunel(){ [ -e "/sys/class/net/$VPN_IF" ]; }
vpn_activa(){ [ -r "$VPN_RUN/vpn-activa" ] && cat "$VPN_RUN/vpn-activa"; }
vpn_perfiles(){ local f; for f in "$VPN_DIR"/*.perfil; do [ -e "$f" ] && basename "$f" .perfil; done; }
vpn_valor(){ sed -n "s/^$2=//p" "$VPN_DIR/$1.perfil" 2>/dev/null | head -n1; }
vpn_nombre_valido(){ [[ "$1" =~ ^[A-Za-z0-9_-]{1,32}$ ]]; }

vpn_estado(){
  local a; a=$(vpn_activa)
  if [ -n "$a" ] && vpn_tunel; then
    bien "VPN" "$(_ 'conectada') · $a"
    nota "$(_ 'kill switch activo: si el túnel se cae, no sale nada a Internet')"
    if [ "$(id -u)" = 0 ] && command -v wg >/dev/null; then
      local hs; hs=$(wg show "$VPN_IF" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
      # shellcheck disable=SC2059
      if [ -n "$hs" ] && [ "$hs" != 0 ]; then nota "$(printf "$(_ 'último contacto con el servidor: hace %s s')" "$(( $(date +%s) - hs ))")"
      else nota "$(_ 'todavía sin contacto con el servidor')"; fi
    fi
  elif [ -n "$a" ]; then
    mal "VPN" "$(_ 'caída') ($a) — $(_ 'Internet bloqueado por el kill switch')  →  naranjos-peel vpn desconecta"
  elif [ -e "$VPN_ULTIMA" ]; then
    aviso "VPN" "$(_ 'desconectada')  →  naranjos-peel vpn conecta"
  else
    nota "VPN: $(_ 'sin perfiles. Importa uno con: naranjos-peel vpn importa <fichero.conf>')"
  fi
}

# importa un fichero de WireGuard (el formato estándar que dan Proton VPN y casi todos)
vpn_importa(){
  local f="${1:-}" nombre="${2:-}"
  [ -r "$f" ] || die "$(_ 'Uso:') naranjos-peel vpn importa <fichero.conf> [nombre]"
  f=$(readlink -f "$f")
  [ -n "$nombre" ] || nombre=$(basename "$f" .conf)
  nombre=$(printf '%s' "$nombre" | tr -c 'A-Za-z0-9_-' '-' | cut -c1-32)
  vpn_nombre_valido "$nombre" || die "$(_ 'Nombre de perfil no válido')"
  como_root vpn importa "$f" "$nombre"
  local datos; datos=$(awk -F= '
    function limpia(s){ gsub(/^[ \t]+|[ \t\r]+$/, "", s); return s }
    /^[ \t]*#/ || /^[ \t]*$/ { next }
    /^\[/ { sec=tolower($0); gsub(/[ \t\r]/, "", sec); if (sec=="[peer]") np++; next }
    { k=tolower(limpia($1)); v=$0; sub(/^[^=]*=/, "", v); v=limpia(v)
      if (sec=="[interface]") {
        if (k=="privatekey") print "PRIVKEY=" v
        else if (k=="address") addr = addr (addr? ",":"") v
        else if (k=="dns") dns = dns (dns? ",":"") v
        else if (k=="mtu") print "MTU=" v
      } else if (sec=="[peer]" && np==1) {
        if (k=="publickey") print "PUBKEY=" v
        else if (k=="presharedkey") print "PSK=" v
        else if (k=="allowedips") aips = aips (aips? ",":"") v
        else if (k=="endpoint") print "ENDPOINT=" v
        else if (k=="persistentkeepalive") print "KEEPALIVE=" v
      } }
    END { print "ADDRESS=" addr; print "DNS=" dns; print "ALLOWEDIPS=" aips; print "PEERS=" np+0 }' "$f")
  local priv pub psk addr ep aips dns mtu ka peers
  priv=$(sed -n 's/^PRIVKEY=//p' <<< "$datos"); pub=$(sed -n 's/^PUBKEY=//p' <<< "$datos")
  psk=$(sed -n 's/^PSK=//p' <<< "$datos");      addr=$(sed -n 's/^ADDRESS=//p' <<< "$datos")
  ep=$(sed -n 's/^ENDPOINT=//p' <<< "$datos");  aips=$(sed -n 's/^ALLOWEDIPS=//p' <<< "$datos")
  dns=$(sed -n 's/^DNS=//p' <<< "$datos");      mtu=$(sed -n 's/^MTU=//p' <<< "$datos")
  ka=$(sed -n 's/^KEEPALIVE=//p' <<< "$datos"); peers=$(sed -n 's/^PEERS=//p' <<< "$datos")
  local clave='^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw480]=$'
  if [[ "$priv" =~ ^\*+$ ]]; then
    printf '%s\n' "$(_ 'Este fichero no trae la clave: Proton la tapa con ***** si lo descargas más tarde desde la lista.')" >&2
    printf '%s\n' "$(_ 'Crea una configuración NUEVA y pulsa Download en la ventana que sale justo después de Create.')" >&2
    exit 1
  fi
  [[ "$priv" =~ $clave ]] || die "$(_ 'El fichero no tiene una clave privada de WireGuard válida')"
  [[ "$pub" =~ $clave ]]  || die "$(_ 'El fichero no tiene la clave pública del servidor')"
  [ -z "$psk" ] || [[ "$psk" =~ $clave ]] || die "$(_ 'La clave precompartida no es válida')"
  [ -n "$addr" ] && [ -n "$ep" ] || die "$(_ 'Faltan la dirección (Address) o el servidor (Endpoint)')"
  [ "$peers" = 1 ] || aviso "VPN" "$(_ 'el fichero tiene varios servidores; NaranjOS usa el primero')"
  aips="${aips// /}"; [ -n "$aips" ] || aips="0.0.0.0/0,::/0"
  install -dm750 -o root -g systemd-network "$VPN_DIR"
  local base="${VPN_DIR:?}/${nombre:?}"
  ( umask 077
    printf '%s\n' "$priv" > "$base.key"
    if [ -n "$psk" ]; then printf '%s\n' "$psk" > "$base.psk"; fi
    { echo "# NaranjOS · perfil de VPN «$nombre» (importado de $(basename "$f"))"
      echo "ADDRESS=$addr"; echo "DNS=$dns"; echo "PUBKEY=$pub"; echo "ENDPOINT=$ep"
      echo "ALLOWEDIPS=$aips"; echo "MTU=$mtu"; echo "KEEPALIVE=${ka:-25}"; } > "$base.perfil" )
  chgrp systemd-network "$base.key"; chmod 640 "$base.key"
  if [ -e "$base.psk" ]; then chgrp systemd-network "$base.psk"; chmod 640 "$base.psk"; fi
  echo "$nombre" > "$VPN_ULTIMA"; chmod 644 "$VPN_ULTIMA"
  # shellcheck disable=SC2059
  hecho "$(printf "$(_ 'Perfil «%s» importado. Conéctate con: naranjos-peel vpn conecta %s')" "$nombre" "$nombre")"
  nota "$(_ 'Ya puedes borrar el fichero original: la clave queda guardada solo para root.')"
}

vpn_conecta(){
  local nombre="${1:-}"
  como_root vpn conecta "$@"
  [ -n "$nombre" ] || nombre=$(cat "$VPN_ULTIMA" 2>/dev/null)
  [ -n "$nombre" ] || nombre=$(vpn_perfiles | head -n1)
  [ -n "$nombre" ] || { vpn_ayuda_proton; die "$(_ 'No hay perfiles de VPN. Importa uno con: naranjos-peel vpn importa <fichero.conf>')"; }
  # shellcheck disable=SC2059
  { vpn_nombre_valido "$nombre" && [ -r "$VPN_DIR/$nombre.perfil" ]; } || die "$(printf "$(_ 'No existe el perfil «%s»')" "$nombre")"
  [ -z "$(vpn_activa)" ] || vpn_desconecta silencio
  modprobe wireguard 2>/dev/null || die "$(_ 'El kernel no tiene WireGuard (módulo «wireguard»)')"
  local addr dns pub ep aips mtu ka host puerto ip
  addr=$(vpn_valor "$nombre" ADDRESS); dns=$(vpn_valor "$nombre" DNS); pub=$(vpn_valor "$nombre" PUBKEY)
  ep=$(vpn_valor "$nombre" ENDPOINT); aips=$(vpn_valor "$nombre" ALLOWEDIPS)
  mtu=$(vpn_valor "$nombre" MTU); ka=$(vpn_valor "$nombre" KEEPALIVE)
  # el servidor como IP ahora (con el kill switch puesto ya no se podría preguntar al DNS)
  puerto="${ep##*:}"; host="${ep%:*}"; host="${host#[}"; host="${host%]}"
  if [[ "$host" =~ ^[0-9.]+$ || "$host" == *:* ]]; then ip="$host"
  else ip=$(getent ahosts "$host" | awk 'NR==1{print $1}'); fi
  # shellcheck disable=SC2059
  [ -n "$ip" ] || die "$(printf "$(_ 'No encuentro la dirección del servidor %s')" "$host")"
  [[ "$ip" == *:* ]] && ip="[$ip]"

  mkdir -p "$VPN_NET" "$VPN_RUN/nftables"
  { echo "# NaranjOS · VPN «$nombre» (naranjos-peel vpn)"
    echo "[NetDev]"; echo "Name=$VPN_IF"; echo "Kind=wireguard"; [ -n "$mtu" ] && echo "MTUBytes=$mtu"
    echo; echo "[WireGuard]"; echo "PrivateKeyFile=$VPN_DIR/$nombre.key"
    echo "FirewallMark=$VPN_MARCA"; echo "RouteTable=$VPN_TABLA"
    echo; echo "[WireGuardPeer]"; echo "PublicKey=$pub"
    [ -e "$VPN_DIR/$nombre.psk" ] && echo "PresharedKeyFile=$VPN_DIR/$nombre.psk"
    echo "AllowedIPs=$aips"; echo "Endpoint=$ip:$puerto"; echo "PersistentKeepalive=${ka:-25}"
  } > "$VPN_NET/90-naranjos-vpn.netdev"
  { echo "# NaranjOS · VPN «$nombre» (naranjos-peel vpn)"
    echo "[Match]"; echo "Name=$VPN_IF"
    echo; echo "[Network]"
    local a d; IFS=, read -ra a <<< "$addr"; for d in "${a[@]}"; do echo "Address=${d// /}"; done
    IFS=, read -ra a <<< "$dns";  for d in "${a[@]}"; do [ -n "${d// /}" ] && echo "DNS=${d// /}"; done
    echo "Domains=~."; echo "DNSDefaultRoute=yes"
    echo; echo "# todo lo que no sea del propio túnel va por el túnel"
    echo "[RoutingPolicyRule]"; echo "FirewallMark=$VPN_MARCA"; echo "InvertRule=yes"
    echo "Table=$VPN_TABLA"; echo "Priority=10"; echo "Family=both"
    echo; echo "# salvo la red local (rutas más concretas que la de por defecto)"
    echo "[RoutingPolicyRule]"; echo "Table=main"; echo "SuppressPrefixLength=0"
    echo "Priority=9"; echo "Family=both"
  } > "$VPN_NET/90-naranjos-vpn.network"
  chmod 644 "$VPN_NET/90-naranjos-vpn.netdev" "$VPN_NET/90-naranjos-vpn.network"

  # kill switch: solo puede salir el túnel, lo que va por él y lo imprescindible de la red local
  {
    echo "# NaranjOS peel · kill switch de la VPN (naranjos-peel vpn desconecta lo quita)"
    echo "table inet naranjos_vpn {"
    echo "	chain salida {"
    echo "		type filter hook output priority filter + 10; policy drop;"
    echo "		oifname \"lo\" accept"
    echo "		oifname \"$VPN_IF\" accept"
    echo "		meta mark $VPN_MARCA accept"
    echo "		udp dport { 67, 547 } accept"
    echo "		meta l4proto ipv6-icmp accept"
    echo "		limit rate 3/minute burst 5 packets log prefix \"naranjos-killswitch: \" level info"
    echo "	}"
    echo "}"
  } > "$VPN_KS"
  if ! nft -f "$VPN_KS"; then
    vpn_limpia
    die "$(_ 'No se pudo poner el kill switch; no se ha conectado')"
  fi
  echo "$nombre" > "$VPN_RUN/vpn-activa"; echo "$nombre" > "$VPN_ULTIMA"
  networkctl reload
  # shellcheck disable=SC2059
  printf '%s\n' "$(printf "$(_ 'Conectando a «%s»…')" "$nombre")"
  local _i hs=""
  for _i in $(seq 1 15); do
    sleep 1
    if command -v wg >/dev/null; then
      hs=$(wg show "$VPN_IF" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
      [ -n "$hs" ] && [ "$hs" != 0 ] && break
    elif vpn_tunel; then hs=sin-wg; break
    fi
  done
  if vpn_tunel && [ -n "$hs" ] && [ "$hs" != 0 ]; then
    # shellcheck disable=SC2059
    hecho "$(printf "$(_ 'VPN conectada: %s (kill switch activo)')" "$nombre")"
  else
    aviso "VPN" "$(_ 'el servidor aún no responde; Internet queda bloqueado hasta que conecte o desconectes')"
    nota "naranjos-peel vpn desconecta"
  fi
}

# quita el túnel, sus reglas de red y el kill switch (sin mensajes)
vpn_limpia(){
  rm -f /run/systemd/network/90-naranjos-vpn.netdev /run/systemd/network/90-naranjos-vpn.network
  networkctl delete "$VPN_IF" >/dev/null 2>&1 || ip link delete "$VPN_IF" 2>/dev/null
  networkctl reload >/dev/null 2>&1
  nft delete table inet naranjos_vpn 2>/dev/null
  rm -f /run/naranjos/nftables/vpn.nft /run/naranjos/vpn-activa
}

vpn_desconecta(){
  como_root vpn desconecta "$@"
  vpn_limpia
  [ "${1:-}" = silencio ] || hecho "$(_ 'VPN desconectada (kill switch quitado)')"
}

vpn_alterna(){ if [ -n "$(vpn_activa)" ]; then vpn_desconecta; else vpn_conecta "$@"; fi; }

vpn_lista(){
  [ "$(id -u)" = 0 ] || exec sudo "$0" vpn lista
  local p a n=0; a=$(vpn_activa)
  for p in $(vpn_perfiles); do
    n=$((n+1))
    if [ "$p" = "$a" ]; then printf '  %s●%s %s  %s(%s)%s\n' "$G" "$Z" "$p" "$D" "$(_ 'conectada')" "$Z"
    else printf '  ○ %s\n' "$p"; fi
  done
  [ "$n" -gt 0 ] || { nota "$(_ 'sin perfiles. Importa uno con: naranjos-peel vpn importa <fichero.conf>')"; vpn_ayuda_proton; }
}

vpn_borra(){
  local nombre="${1:-}"; [ -n "$nombre" ] || die "$(_ 'Uso:') naranjos-peel vpn borra <nombre>"
  como_root vpn borra "$nombre"
  # shellcheck disable=SC2059
  { vpn_nombre_valido "$nombre" && [ -e "$VPN_DIR/$nombre.perfil" ]; } || die "$(printf "$(_ 'No existe el perfil «%s»')" "$nombre")"
  [ "$(vpn_activa)" = "$nombre" ] && vpn_desconecta silencio
  local base="${VPN_DIR:?}/${nombre:?}"
  rm -f "$base.perfil" "$base.key" "$base.psk"
  [ "$(cat "$VPN_ULTIMA" 2>/dev/null)" = "$nombre" ] && rm -f /etc/naranjos/vpn-ultima
  # shellcheck disable=SC2059
  hecho "$(printf "$(_ 'Perfil «%s» borrado')" "$nombre")"
}

vpn_arranque(){
  case "${1:-}" in
    si|sí|yes|on)
      como_root vpn arranque si
      systemctl enable naranjos-vpn.service >/dev/null 2>&1 && hecho "$(_ 'La VPN se conectará sola al encender (con el último perfil usado)')";;
    no|off)
      como_root vpn arranque no
      systemctl disable naranjos-vpn.service >/dev/null 2>&1; hecho "$(_ 'La VPN ya no se conecta sola al encender')";;
    *) die "$(_ 'Uso:') naranjos-peel vpn arranque si|no";;
  esac
}

vpn_ayuda_proton(){
  echo
  printf '%s%s%s\n' "$O" "$(_ 'VPN gratis con Proton VPN (0 €, sin tarjeta):')" "$Z"
  printf '  1. %s\n' "$(_ 'Crea una cuenta gratuita en https://account.protonvpn.com')"
  printf '  2. %s\n' "$(_ 'Downloads → WireGuard configuration → plataforma «GNU/Linux» → un servidor gratuito → Create')"
  printf '  3. %s\n' "$(_ 'Descarga el fichero .conf y en una terminal:')"
  printf '     %snaranjos-peel vpn importa ~/Descargas/<fichero>.conf proton%s\n' "$O" "$Z"
  printf '  4. %snaranjos-peel vpn conecta%s  %s\n' "$O" "$Z" "$(_ '(o Super + Ctrl + V)')"
}

vpn(){
  case "${1:-}" in
    ""|estado|status) printf '%sVPN%s\n' "$O" "$Z"; vpn_estado; [ -e "$VPN_ULTIMA" ] || vpn_ayuda_proton ;;
    importa|import)   shift; vpn_importa "$@" ;;
    conecta|connect|on)  shift; vpn_conecta "$@" ;;
    desconecta|disconnect|off) shift; vpn_desconecta "$@" ;;
    alterna|toggle)   shift; vpn_alterna "$@" ;;
    lista|list)       vpn_lista ;;
    borra|delete)     shift; vpn_borra "$@" ;;
    arranque|boot)    shift; vpn_arranque "$@" ;;
    proton)           vpn_ayuda_proton ;;
    *) die "$(_ 'Uso:') naranjos-peel vpn [importa|conecta|desconecta|lista|borra|arranque|proton]" ;;
  esac
}

# ==========================================================================================
#  Antivirus de NaranjOS (motor ClamAV, el resto es de NaranjOS)
#   · firmas: naranjos-firmas.timer (sistema) las pone al día cada día con freshclam
#   · vigilancia de Descargas: naranjos-vigia.path (de cada usuario) analiza lo nuevo que llega
#   · análisis semanal de tu carpeta: naranjos-analisis.timer (de cada usuario)
#   · cuarentena: ~/.local/share/naranjos/cuarentena (los ficheros quedan sin permisos)
# ==========================================================================================
AV_BD=/var/lib/clamav
AV_ESTADO="${XDG_STATE_HOME:-$HOME/.local/state}/naranjos"
AV_CUARENTENA="${XDG_DATA_HOME:-$HOME/.local/share}/naranjos/cuarentena"

av_firmas_fecha(){  # fecha (segundos) de las firmas más nuevas, o vacío si no hay
  local f n=0 t
  for f in "$AV_BD"/daily.cvd "$AV_BD"/daily.cld "$AV_BD"/main.cvd "$AV_BD"/main.cld; do
    [ -e "$f" ] || continue; t=$(stat -c %Y "$f"); [ "$t" -gt "$n" ] && n=$t
  done
  [ "$n" -gt 0 ] && echo "$n"
}
av_descargas(){ naranjos_carpeta DOWNLOAD; }
av_n_cuarentena(){ find "$AV_CUARENTENA" -maxdepth 1 -type f ! -name '*.info' 2>/dev/null | wc -l; }

av_estado(){
  local f d n
  if ! command -v clamscan >/dev/null; then mal "$(_ 'antivirus')" "$(_ 'no instalado') (zumo instala clamav)"; return; fi
  f=$(av_firmas_fecha)
  if [ -z "$f" ]; then
    aviso "$(_ 'firmas')" "$(_ 'aún no descargadas')  →  naranjos-peel antivirus actualiza"
  else
    d=$(( ($(date +%s) - f) / 86400 ))
    # shellcheck disable=SC2059
    if [ "$d" -le 3 ]; then bien "$(_ 'firmas')" "$(printf "$(_ 'al día (%s)')" "$(date -d "@$f" '+%d/%m %H:%M')")"
    else aviso "$(_ 'firmas')" "$(printf "$(_ 'de hace %s días')" "$d")  →  naranjos-peel antivirus actualiza"; fi
  fi
  if systemctl --user is-active -q naranjos-vigia.path 2>/dev/null; then
    bien "$(_ 'vigilancia')" "$(_ 'activa en') $(av_descargas | sed "s|^$HOME|~|")"
  else
    aviso "$(_ 'vigilancia')" "$(_ 'apagada')  →  naranjos-peel antivirus vigila si"
  fi
  n=$(av_n_cuarentena)
  # shellcheck disable=SC2059
  if [ "$n" -gt 0 ]; then aviso "$(_ 'cuarentena')" "$(printf "$(_ '%s fichero(s)')" "$n")  →  naranjos-peel antivirus cuarentena"
  else bien "$(_ 'cuarentena')" "$(_ 'vacía')"; fi
  [ -r "$AV_ESTADO/ultimo-analisis" ] && nota "$(_ 'último análisis:') $(cat "$AV_ESTADO/ultimo-analisis")"
}

# mete un fichero infectado en la cuarentena (sin permisos, con nota de dónde estaba)
av_cuarentena_mete(){
  local f="$1" virus="$2" dest
  mkdir -p "$AV_CUARENTENA"; chmod 700 "$AV_CUARENTENA"
  dest="$AV_CUARENTENA/$(date +%Y%m%d-%H%M%S)-$(basename "$f")"
  if mv -f "$f" "$dest" 2>/dev/null; then
    chmod 000 "$dest"
    printf 'ORIGEN=%s\nVIRUS=%s\nFECHA=%s\n' "$f" "$virus" "$(date '+%F %T')" > "$dest.info"
    return 0
  fi
  return 1
}

# analiza rutas; lo infectado va a la cuarentena y se avisa. Devuelve 1 si encontró algo.
av_analiza_rutas(){
  local salida linea f virus n=0 res
  command -v clamscan >/dev/null || die "$(_ 'Falta el motor del antivirus (zumo instala clamav)')"
  [ -n "$(av_firmas_fecha)" ] || die "$(_ 'Aún no hay firmas. Descárgalas con: naranjos-peel antivirus actualiza')"
  salida=$(nice -n 10 clamscan --recursive --infected --no-summary --stdout \
           --exclude-dir='/\.cache/' --exclude-dir='/naranjos/cuarentena' --exclude='\.part$' --exclude='\.crdownload$' \
           -- "$@" 2>/dev/null); res=$?
  while IFS= read -r linea; do
    [[ "$linea" == *": "*" FOUND" ]] || continue
    f="${linea%%: *}"; virus="${linea#*: }"; virus="${virus% FOUND}"
    n=$((n+1))
    if av_cuarentena_mete "$f" "$virus"; then
      mal "$(_ 'amenaza')" "$(basename "$f") · $virus → $(_ 'cuarentena')"
      naranjos-notifica "$(_ 'NaranjOS peel: amenaza bloqueada')" "$(basename "$f") · $virus — $(_ 'está en cuarentena')" 2>/dev/null
    else
      mal "$(_ 'amenaza')" "$f · $virus ($(_ 'no se pudo mover a la cuarentena'))"
      naranjos-notifica "$(_ 'NaranjOS peel: amenaza encontrada')" "$f · $virus" 2>/dev/null
    fi
  done <<< "$salida"
  mkdir -p "$AV_ESTADO"; date '+%d/%m %H:%M' > "$AV_ESTADO/ultimo-analisis"
  [ "$res" -le 1 ] || aviso "$(_ 'antivirus')" "$(_ 'algunos ficheros no se pudieron leer')"
  [ "$n" -eq 0 ]
}

av_analiza(){
  [ "$(id -u)" != 0 ] || die "$(_ 'Analiza como tu usuario, sin sudo')"
  local r=("$@"); [ ${#r[@]} -gt 0 ] || r=("$(av_descargas)")
  # shellcheck disable=SC2059
  printf '%s\n' "$(printf "$(_ 'Analizando %s… (cargar las firmas tarda unos segundos)')" "${r[*]/#$HOME/\~}")"
  if av_analiza_rutas "${r[@]}"; then hecho "$(_ 'Todo limpio')"; else return 1; fi
}

# lo llama naranjos-vigia.service cuando cambia la carpeta de descargas
av_vigia(){
  local d sello nuevos=()
  d=$(av_descargas); sello="$AV_ESTADO/vigia.sello"; mkdir -p "$AV_ESTADO"
  sleep 2                                         # deja terminar de escribir la descarga
  if [ -e "$sello" ]; then
    mapfile -d '' nuevos < <(find "$d" -type f -newer "$sello" ! -name '*.part' ! -name '*.crdownload' -print0 2>/dev/null)
  else                                            # la primera vez: lo de los últimos 10 minutos
    mapfile -d '' nuevos < <(find "$d" -type f -mmin -10 ! -name '*.part' ! -name '*.crdownload' -print0 2>/dev/null)
  fi
  touch "$sello"
  [ ${#nuevos[@]} -gt 0 ] || exit 0
  av_analiza_rutas "${nuevos[@]}" >/dev/null || true
}

# análisis semanal de toda tu carpeta personal (lo lanza naranjos-analisis.timer)
av_completo(){
  av_analiza_rutas "$HOME" >/dev/null || true
}

av_actualiza(){
  # shellcheck disable=SC2059
  printf '%s\n' "$(_ 'Descargando las firmas del antivirus (la primera vez son unos 200 MB)…')"
  sudo systemctl start naranjos-firmas.service || die "$(_ 'No se pudieron descargar las firmas (mira: journalctl -u naranjos-firmas)')"
  hecho "$(_ 'Firmas al día')"
}

# enlace fijo a tu carpeta de descargas (sea cual sea su nombre): lo vigila naranjos-vigia.path
av_enlace(){ mkdir -p "$AV_ESTADO"; ln -sfn "$(av_descargas)" "$AV_ESTADO/descargas"; }

av_vigila(){
  case "${1:-}" in
    si|sí|yes|on)  av_enlace; systemctl --user enable --now naranjos-vigia.path naranjos-analisis.timer >/dev/null 2>&1 \
                     && hecho "$(_ 'Vigilancia de descargas activada (y análisis semanal)')";;
    no|off)        systemctl --user disable --now naranjos-vigia.path naranjos-analisis.timer >/dev/null 2>&1
                   hecho "$(_ 'Vigilancia de descargas apagada')";;
    *) die "$(_ 'Uso:') naranjos-peel antivirus vigila si|no";;
  esac
}

av_lista_cuarentena(){
  local f n=0 orig virus fecha
  for f in "$AV_CUARENTENA"/*.info; do
    [ -e "$f" ] || continue; n=$((n+1))
    orig=$(sed -n 's/^ORIGEN=//p' "$f"); virus=$(sed -n 's/^VIRUS=//p' "$f"); fecha=$(sed -n 's/^FECHA=//p' "$f")
    printf '  %s%s%s\n     %s · %s · %s\n' "$O" "$(basename "$f" .info)" "$Z" "$virus" "$fecha" "${orig/#$HOME/\~}"
  done
  [ "$n" -gt 0 ] || nota "$(_ 'La cuarentena está vacía')"
}

av_restaura(){
  local n="${1:-}" f orig
  [ -n "$n" ] || die "$(_ 'Uso:') naranjos-peel antivirus restaura <nombre> ($(_ 'míralo con: naranjos-peel antivirus cuarentena'))"
  f="${AV_CUARENTENA:?}/${n:?}"
  # shellcheck disable=SC2059
  [ -e "$f" ] && [ -e "$f.info" ] || die "$(printf "$(_ 'No está en la cuarentena: %s')" "$n")"
  orig=$(sed -n 's/^ORIGEN=//p' "$f.info")
  [ ! -e "$orig" ] || orig="$orig.restaurado"
  chmod 600 "$f" && mkdir -p "$(dirname "$orig")" && mv "$f" "$orig" && rm -f "$f.info" || die "$(_ 'No se pudo restaurar')"
  aviso "$(_ 'restaurado')" "${orig/#$HOME/\~} — $(_ 'el antivirus lo consideraba peligroso: ábrelo solo si estás seguro')"
}

av_vacia(){
  local n; n=$(av_n_cuarentena)
  [ "$n" -gt 0 ] || { nota "$(_ 'La cuarentena está vacía')"; return; }
  rm -rf "${AV_CUARENTENA:?}"
  # shellcheck disable=SC2059
  hecho "$(printf "$(_ 'Cuarentena vaciada (%s fichero(s) borrados)')" "$n")"
}

antivirus(){
  case "${1:-}" in
    ""|estado|status) printf '%s%s%s\n' "$O" "$(_ 'Antivirus')" "$Z"; av_estado ;;
    analiza|scan)     shift; av_analiza "$@" ;;
    actualiza|update) av_actualiza ;;
    vigila|watch)     shift; av_vigila "$@" ;;
    cuarentena|quarantine) av_lista_cuarentena ;;
    restaura|restore) shift; av_restaura "$@" ;;
    vacia|empty)      av_vacia ;;
    vigia)            av_vigia ;;
    completo)         av_completo ;;
    *) die "$(_ 'Uso:') naranjos-peel antivirus [analiza|actualiza|vigila|cuarentena|restaura|vacia]" ;;
  esac
}

bloqueados(){
  como_root bloqueados "$@"
  journalctl -k -g 'naranjos-cortafuegos' --since "${1:-today}" --no-pager | tail -n 40
}

