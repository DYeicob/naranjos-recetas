  printf "$f" "$O" "naranjos-peel vpn desconecta"  "$Z" "$(_ 'desconecta')"
  printf "$f" "$O" "naranjos-peel vpn lista|borra" "$Z" "$(_ 'perfiles guardados / borrar uno')"
  printf "$f" "$O" "naranjos-peel vpn arranque si|no" "$Z" "$(_ 'conectar sola al encender')"
  printf "$f" "$O" "naranjos-peel antivirus"       "$Z" "$(_ 'estado del antivirus')"
  printf "$f" "$O" "naranjos-peel antivirus analiza [ruta]" "$Z" "$(_ 'analiza (por defecto, tus descargas)')"
  printf "$f" "$O" "naranjos-peel antivirus actualiza" "$Z" "$(_ 'pone al día las firmas')"
  printf "$f" "$O" "naranjos-peel antivirus vigila si|no" "$Z" "$(_ 'vigilar las descargas (por defecto: sí)')"
