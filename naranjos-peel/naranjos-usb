#!/bin/bash
# /usr/lib/naranjos/naranjos-usb — protección USB de NaranjOS (lo llaman udev y naranjos-usb.service)
#   naranjos-usb nuevo <1-3>   un dispositivo recién enchufado (udev)
#   naranjos-usb aplica        aplica el modo (al arrancar y al cambiarlo con naranjos-peel usb modo)
PATH=/usr/bin:/usr/sbin
[ -r /etc/locale.conf ] && { set -a; . /etc/locale.conf; set +a; }
. /usr/lib/naranjos/naranjos-i18n.sh 2>/dev/null || _(){ printf '%s' "$1"; }
DIR=/etc/naranjos/usb; RUN=/run/naranjos/usb; AVISOS=/run/naranjos/avisos
S=/sys/bus/usb/devices

modo(){ cat "$DIR/modo" 2>/dev/null || echo abierto; }
dato(){ cat "$S/$1/$2" 2>/dev/null; }
id_de(){ echo "$(dato "$1" idVendor):$(dato "$1" idProduct)|$(dato "$1" serial)"; }
nombre(){ local n; n="$(dato "$1" manufacturer) $(dato "$1" product)"; n="${n# }"; n="${n% }"; echo "${n:-USB}"; }
permitido(){ local i; i=$(id_de "$1"); grep -qF "$i|" "$DIR/permitidos" 2>/dev/null; }
autoriza(){ echo "$2" > "$S/$1/authorized" 2>/dev/null; }

bloquea(){  # apunta el bloqueo y avisa a los usuarios
  local k="$1" n; n=$(nombre "$k")
  mkdir -p "$RUN" "$AVISOS"; chmod 755 "$RUN" "$AVISOS"
  grep -q "^$k|" "$RUN/bloqueados" 2>/dev/null || echo "$k|$(id_de "$k")|$n" >> "$RUN/bloqueados"
  chmod 644 "$RUN/bloqueados"
  printf '%s\n%s\n' "$(_ 'NaranjOS peel: USB bloqueado')" \
    "$n ($(id_de "$k" | cut -d'|' -f1)) — $(_ 'si lo has enchufado tú, permítelo con Super + Ctrl + U')" \
    > "$AVISOS/usb-$(date +%s%N)"
  chmod 644 "$AVISOS"/usb-*
}

nuevo(){
  local k="$1"
  [ -d "$S/$k" ] || exit 0
  if [ "$(modo)" != protegido ]; then exit 0; fi
  if permitido "$k"; then autoriza "$k" 1
  else autoriza "$k" 0; bloquea "$k"; fi
}

aplica(){
  local h k
  if [ "$(modo)" = protegido ]; then
    for h in "$S"/usb*; do [ -e "$h/authorized_default" ] && echo 0 > "$h/authorized_default"; done
    # los ya conectados: los permitidos siguen, el resto se bloquea (de arriba abajo en el árbol)
    # shellcheck disable=SC2010
    for k in $(ls "$S" | grep -E '^[0-9]+-[0-9.]+$' | awk '{print length, $0}' | sort -n | cut -d' ' -f2); do
      if permitido "$k"; then [ "$(dato "$k" authorized)" = 1 ] || autoriza "$k" 1
      elif [ "$(dato "$k" authorized)" = 1 ]; then autoriza "$k" 0; bloquea "$k"; fi
    done
  else
    for h in "$S"/usb*; do [ -e "$h/authorized_default" ] && echo 1 > "$h/authorized_default"; done
    # shellcheck disable=SC2010
    for k in $(ls "$S" | grep -E '^[0-9]+-[0-9.]+$'); do [ "$(dato "$k" authorized)" = 0 ] && autoriza "$k" 1; done
    rm -f /run/naranjos/usb/bloqueados
  fi
}

case "${1:-}" in
  nuevo) nuevo "${2:?}" ;;
  aplica) aplica ;;
  *) echo "Uso: naranjos-usb nuevo <dispositivo> | aplica" >&2; exit 1 ;;
esac
