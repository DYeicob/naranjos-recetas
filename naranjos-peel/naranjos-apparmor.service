[Unit]
Description=NaranjOS peel: perfiles de AppArmor
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
# (sin ConditionSecurity=apparmor: el systemd de LFS se compila sin AppArmor y la daría siempre por falsa;
#  naranjos-apparmor ya comprueba él mismo si AppArmor está activo en el kernel)
RequiresMountsFor=/var/cache/apparmor

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/naranjos/naranjos-apparmor
ExecReload=/usr/lib/naranjos/naranjos-apparmor

[Install]
WantedBy=sysinit.target
