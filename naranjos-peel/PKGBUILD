package() {
  local U="$pkgdir/usr/lib/systemd/user" S="$pkgdir/usr/lib/systemd/system"
  install -Dm755 naranjos-peel                    "$pkgdir/usr/bin/naranjos-peel"
  install -Dm755 naranjos-usb                     "$pkgdir/usr/lib/naranjos/naranjos-usb"
  install -Dm644 60-naranjos-usb.rules            "$pkgdir/usr/lib/udev/rules.d/60-naranjos-usb.rules"
  install -Dm644 nftables.conf                    "$pkgdir/etc/nftables.conf"
  install -Dm644 00-naranjos.nft                  "$pkgdir/etc/nftables.d/00-naranjos.nft"
  install -Dm644 nftables.service                 "$S/nftables.service"
  install -Dm644 naranjos-vpn.service             "$S/naranjos-vpn.service"
  install -Dm644 naranjos-usb.service             "$S/naranjos-usb.service"
  install -Dm644 naranjos-firmas.service          "$S/naranjos-firmas.service"
  install -Dm644 naranjos-firmas.timer            "$S/naranjos-firmas.timer"
  install -Dm644 naranjos-integridad.service      "$S/naranjos-integridad.service"
  install -Dm644 naranjos-integridad.timer        "$S/naranjos-integridad.timer"
  install -Dm644 naranjos-vigia.path              "$U/naranjos-vigia.path"
  install -Dm644 naranjos-vigia.service           "$U/naranjos-vigia.service"
  install -Dm644 naranjos-analisis.service        "$U/naranjos-analisis.service"
  install -Dm644 naranjos-analisis.timer          "$U/naranjos-analisis.timer"
  install -Dm644 naranjos-avisos.path             "$U/naranjos-avisos.path"
  install -Dm644 naranjos-avisos.service          "$U/naranjos-avisos.service"
  install -Dm644 freshclam.conf                   "$pkgdir/etc/clamav/freshclam.conf"
  install -Dm644 naranjos-clamav.sysusers         "$pkgdir/usr/lib/sysusers.d/naranjos-clamav.conf"
  install -Dm644 naranjos-clamav.tmpfiles         "$pkgdir/usr/lib/tmpfiles.d/naranjos-clamav.conf"
  install -Dm644 naranjos-peel.tmpfiles           "$pkgdir/usr/lib/tmpfiles.d/naranjos-peel.conf"
  install -Dm644 60-naranjos-peel.sysctl          "$pkgdir/usr/lib/sysctl.d/60-naranjos-peel.conf"
  install -Dm644 50-naranjos-peel.resolved        "$pkgdir/usr/lib/systemd/resolved.conf.d/50-naranjos-peel.conf"
  install -Dm644 60-naranjos-peel-dns.network.conf \
                 "$pkgdir/usr/lib/systemd/network/25-naranjos-wifi.network.d/60-naranjos-peel-dns.conf"
