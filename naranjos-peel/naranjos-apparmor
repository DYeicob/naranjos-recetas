#!/bin/bash
# NaranjOS peel · carga los perfiles de AppArmor (lo lanza naranjos-apparmor.service al arrancar)
#   modo «aprendiz» (por defecto): los perfiles solo avisan de lo que bloquearían (complain)
#   modo «estricto»: los perfiles bloquean de verdad (enforce)
set -u
PERFILES=/etc/apparmor.d
CACHE=/var/cache/apparmor
MODO_F=/etc/naranjos/apparmor/modo
ESTADO=/run/naranjos/apparmor
[ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = Y ] || { echo "AppArmor no está activo en el kernel"; exit 0; }
command -v apparmor_parser >/dev/null || { echo "Falta apparmor_parser"; exit 0; }
modo=$(cat "$MODO_F" 2>/dev/null || echo aprendiz)
op=(--replace --write-cache "--cache-loc=$CACHE" --quiet)
[ "$modo" = estricto ] || op+=(--Complain)
mkdir -p "$CACHE" "$ESTADO"
fs=()
for f in "$PERFILES"/*; do
  [ -f "$f" ] || continue
  case "$f" in *.pacnew|*.pacsave|*.dpkg-*|*.rpm*|*~|*.orig|*.bak|*/README) continue ;; esac
  fs+=("$f")
done
[ ${#fs[@]} -gt 0 ] || { echo "No hay perfiles en $PERFILES"; exit 0; }
# Los perfiles «flags=(unconfined)» (flatpak, chrome, steam…) no encierran nada: solo dan permiso para
# crear espacios de nombres de usuario (las «cajas» de Flatpak). Forzarlos a «complain» les quita ese
# permiso y rompe Flatpak («bwrap: setting up uid map: Permission denied»), así que se cargan tal cual.
libres=() resto=()
for f in "${fs[@]}"; do
  if grep -q 'flags=([^)]*unconfined' "$f"; then libres+=("$f"); else resto+=("$f"); fi
done
# los que no se pueden cargar (p. ej. de programas que NaranjOS no tiene) se apuntan y se siguen los demás
: > "$ESTADO/errores"
[ ${#libres[@]} -gt 0 ] && { apparmor_parser --replace --write-cache "--cache-loc=$CACHE" --quiet "${libres[@]}" 2>> "$ESTADO/errores" || true; }
[ ${#resto[@]} -gt 0 ]  && { apparmor_parser "${op[@]}" "${resto[@]}" 2>> "$ESTADO/errores" || true; }
n=$(grep -c . /sys/kernel/security/apparmor/profiles 2>/dev/null || echo 0)
printf '%s %s %s\n' "$modo" "$n" "$(date +%s)" > "$ESTADO/cargados"
echo "AppArmor: $n perfiles cargados (modo $modo)"
