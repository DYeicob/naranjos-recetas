# Receta de NaranjOS — generada por naranjos-tanda-6f7.sh
pkgname=coreutils
pkgver=9.11
pkgrel=1
pkgdesc='Órdenes básicas de GNU (ls, cp, mv, cat…)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-3.0-or-later')
depends=('acl' 'attr' 'libcap' 'openssl')
makedepends=()
source=('https://ftpmirror.gnu.org/coreutils/coreutils-9.11.tar.xz' 'coreutils-9.11-i18n-1.patch')
sha256sums=('394024eda0a5955217ceda9cd1201e65dc8fa3aa29c2951135a49521d57c3cc3' '7c2aecf9ae24b87b019595e382b9f41d2c96de7f95abe95ad8cacc7e2ce1bbcc')
prepare() {
  cd coreutils-$pkgver
  patch -Np1 -i ../coreutils-9.11-i18n-1.patch
  autoreconf -fv
  automake -af
}
build() { cd coreutils-$pkgver; ./configure --prefix=/usr; make; }
check() { cd coreutils-$pkgver; make -k check < /dev/null || echo "coreutils: alguna prueba falló"; }
package() {
  cd coreutils-$pkgver
  make DESTDIR="$pkgdir" install
  install -d "$pkgdir/usr/sbin" "$pkgdir/usr/share/man/man8"
  mv "$pkgdir/usr/bin/chroot" "$pkgdir/usr/sbin/chroot"
  mv "$pkgdir/usr/share/man/man1/chroot.1" "$pkgdir/usr/share/man/man8/chroot.8"
  sed -i 's/"1"/"8"/' "$pkgdir/usr/share/man/man8/chroot.8"
}
