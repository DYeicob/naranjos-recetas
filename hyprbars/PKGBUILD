# Receta de NaranjOS — generada por naranjos-tanda-6q3.sh
pkgname=hyprbars
pkgver=0.57.0
pkgrel=1
pkgdesc='Barras de título para Hyprland (compilado para Hyprland 0.57.2)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('BSD-3-Clause')
depends=('hyprland=0.57.2' 'pixman' 'libdrm' 'libinput' 'systemd' 'wayland' 'libxkbcommon')
makedepends=('meson' 'ninja')
source=('https://github.com/hyprwm/hyprland-plugins/archive/v0.57.0/hyprland-plugins-0.57.0.tar.gz')
sha256sums=('5518cb008dcf7cbb7ab2c1292d1f9c7973f10014d15ca5e80fcac758a5c066ee')
# el meson.build de hyprbars busca *.cpp con «find .»: la carpeta de compilación tiene que estar FUERA de hyprbars/
build() { cd hyprland-plugins-$pkgver; meson setup build-hyprbars hyprbars --prefix=/usr --buildtype=release; meson compile -C build-hyprbars; }
package() {
  cd hyprland-plugins-$pkgver
  install -Dm755 build-hyprbars/libhyprbars.so "$pkgdir/usr/lib/hyprland/plugins/hyprbars.so"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/hyprbars/LICENSE"
}
