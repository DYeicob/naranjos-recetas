# Receta de NaranjOS — generada por naranjos-tanda-6f3.sh
pkgname=libcap
pkgver=2.78
pkgrel=1
pkgdesc='Capacidades POSIX de los procesos (libcap, setcap, getcap)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('BSD-3-Clause' 'GPL-2.0-only')
depends=('glibc' 'attr')
makedepends=()
source=('https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-2.78.tar.xz')
sha256sums=('0d621e562fd932ccf67b9660fb018e468a683d7b827541df27813228c996bb11')
prepare() { cd libcap-$pkgver; sed -i '/install -m.*STA/d' libcap/Makefile; }
build()   { cd libcap-$pkgver; make GOLANG=no prefix=/usr lib=lib; }
check()   { cd libcap-$pkgver; make GOLANG=no test; }
package() {
  cd libcap-$pkgver
  # RAISE_SETFCAP=no: el paquete se hace sin ser root (setcap no se puede aplicar aquí)
  make GOLANG=no prefix=/usr lib=lib DESTDIR="$pkgdir" RAISE_SETFCAP=no install
}
