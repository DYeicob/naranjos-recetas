# Receta de NaranjOS — generada por naranjos-tanda-6f7.sh
pkgname=bash
pkgver=5.3
pkgrel=1
pkgdesc='El intérprete de órdenes bash'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-3.0-or-later')
depends=('readline' 'ncurses' 'glibc')
makedepends=()
source=('https://ftpmirror.gnu.org/bash/bash-5.3.tar.gz')
sha256sums=('0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba')
provides=('sh')
build() {
  cd bash-$pkgver
  ./configure --prefix=/usr --without-bash-malloc --with-installed-readline --docdir=/usr/share/doc/bash-$pkgver
  make
}
package() {
  cd bash-$pkgver
  make DESTDIR="$pkgdir" install
  ln -sf bash "$pkgdir/usr/bin/sh"
}
