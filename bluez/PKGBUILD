# Receta de NaranjOS — generada por naranjos-tanda-5c3.sh
pkgname=bluez
pkgver=5.87
pkgrel=1
pkgdesc='Bluetooth (BlueZ): servicio y bluetoothctl'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-only AND LGPL-2.1-or-later')
depends=('dbus' 'glib2' 'readline')
makedepends=()
source=('https://www.kernel.org/pub/linux/bluetooth/bluez-5.87.tar.xz')
sha256sums=('26bdcf2cebd7310c6f598850606b037ef0c515fe6608ebc54d22c50c4c32b35f')
provides=('bluez-utils' 'bluez-libs')
backup=('etc/bluetooth/main.conf')
build()   { cd bluez-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --enable-library --disable-obex --disable-manpages
  make; }
package() { cd bluez-$pkgver; make DESTDIR="$pkgdir" install
  install -dm755 "$pkgdir/usr/sbin"; ln -sf ../libexec/bluetooth/bluetoothd "$pkgdir/usr/sbin/bluetoothd"
  install -dm555 "$pkgdir/etc/bluetooth"; install -m644 src/main.conf "$pkgdir/etc/bluetooth/main.conf"
  # el adaptador se enciende solo al arrancar
  sed -i 's/^#AutoEnable=true/AutoEnable=true/' "$pkgdir/etc/bluetooth/main.conf"; }
