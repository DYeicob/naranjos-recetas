build()   { cd json-glib-$pkgver; meson setup build --prefix=/usr --buildtype=plain --wrap-mode=nodownload -D introspection=disabled -D documentation=disabled -D gtk_doc=disabled -D man=false -D tests=false; meson compile -C build; }
package() { cd json-glib-$pkgver; DESTDIR="$pkgdir" meson install -C build; }
