prepare() { cd mise-$pkgver; export CARGO_HOME="$srcdir/cargo"; cargo fetch --locked; }
build() { cd mise-$pkgver; export CARGO_HOME="$srcdir/cargo"; cargo build --release --frozen; }
package() { cd mise-$pkgver; install -Dm755 target/release/mise "$pkgdir/usr/bin/mise"; install -Dm644 LICENSE "$pkgdir/usr/share/licenses/mise/LICENSE"; }
