# Receta de NaranjOS — generada por naranjos-tanda-6f2.sh
pkgname=file
pkgver=5.48
pkgrel=1
pkgdesc='Reconoce el tipo de cada fichero (file y libmagic)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('BSD-2-Clause')
depends=('glibc' 'zlib' 'bzip2' 'xz' 'zstd')
makedepends=()
source=('https://astron.com/pub/file/file-5.48.tar.gz')
sha256sums=('ed14656883b23a364b4057c05595d93252da9bc473d30106519519d0da141283')
build()   { cd file-$pkgver; ./configure --prefix=/usr; make; }
check()   { cd file-$pkgver; make check; }
package() { cd file-$pkgver; make DESTDIR="$pkgdir" install; }
