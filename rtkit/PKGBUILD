# Receta de NaranjOS — generada por naranjos-tanda-6r2.sh
pkgname=rtkit
pkgver=0.13
pkgrel=1
pkgdesc='Prioridad en tiempo real para el sonido (sin cortes)'
install=rtkit.install
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-3.0-or-later' 'MIT')
depends=('dbus' 'polkit' 'libcap' 'systemd')
makedepends=('meson' 'ninja' 'vim')
source=('https://github.com/heftig/rtkit/archive/v0.13/rtkit-0.13.tar.gz')
sha256sums=('0f9508530868109f0348e044cc1b20893672875467ace6d847ba6364274de003')
build() {
  cd rtkit-$pkgver
  meson setup build --prefix=/usr --buildtype=release -D installed_tests=false -D libsystemd=enabled
  ninja -C build
}
package() {
  cd rtkit-$pkgver
  DESTDIR="$pkgdir" ninja -C build install
  install -d "$pkgdir/usr/lib/sysusers.d"
  echo 'u rtkit - "RealtimeKit (prioridad del sonido)" /proc' > "$pkgdir/usr/lib/sysusers.d/rtkit.conf"
}
