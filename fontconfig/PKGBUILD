# Receta de NaranjOS — generada por naranjos-tanda-5a1.sh a partir de BLFS 13.1-systemd
pkgname=fontconfig
pkgver=2.18.3
pkgrel=1
pkgdesc='Configuración y búsqueda de tipografías'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('HPND AND Unicode-DFS-2016')
depends=('freetype2' 'expat')
makedepends=()
source=('https://gitlab.freedesktop.org/api/v4/projects/890/packages/generic/fontconfig/2.18.3/fontconfig-2.18.3.tar.xz')
sha256sums=('4f7b554a38cdf78c033f666c8871f3749e14a094f65a07f630c91ed0b43d35e3')
backup=('etc/fonts/fonts.conf')
build()   { cd fontconfig-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-docs \
              --docdir=/usr/share/doc/fontconfig-$pkgver; make; }
package() { cd fontconfig-$pkgver; make DESTDIR="$pkgdir" install; }
