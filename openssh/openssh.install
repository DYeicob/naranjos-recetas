# el servidor SSH necesita su usuario sin privilegios (como en BLFS)
post_install() {
  getent group sshd >/dev/null || /usr/sbin/groupadd -g 50 sshd 2>/dev/null || /usr/sbin/groupadd -r sshd
  getent passwd sshd >/dev/null || /usr/sbin/useradd -c 'sshd PrivSep' -d /var/lib/sshd -g sshd -s /bin/false -u 50 sshd 2>/dev/null \
    || /usr/sbin/useradd -r -c 'sshd PrivSep' -d /var/lib/sshd -g sshd -s /bin/false sshd
  systemctl daemon-reload >/dev/null 2>&1 || true
}
post_upgrade() { post_install; }
