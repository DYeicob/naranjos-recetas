build() { cd libhangul-libhangul-$pkgver; cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -Wno-dev -DENABLE_UNIT_TEST=OFF; ninja -C build; }
package() { cd libhangul-libhangul-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
