# Receta de NaranjOS — generada por naranjos-tanda-6f7.sh
pkgname=util-linux
pkgver=2.42.2
pkgrel=1
pkgdesc='Utilidades básicas de Linux (mount, fdisk, lsblk, rfkill…) y sus bibliotecas'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later' 'BSD-3-Clause')
depends=('glibc' 'ncurses' 'readline' 'zlib' 'libcap' 'systemd-libs')
makedepends=()
source=('https://www.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-2.42.2.tar.xz')
sha256sums=('03a05d3adf9602ef128f2da05b84b3205ce60c351e5737c0370f74000679ce8a')
provides=('util-linux-libs')
build() {
  cd util-linux-$pkgver
  ./configure --bindir=/usr/bin --libdir=/usr/lib --runstatedir=/run --sbindir=/usr/sbin \
              --disable-chfn-chsh --disable-login --disable-nologin --disable-su --disable-setpriv \
              --disable-runuser --disable-pylibmount --disable-liblastlog2 --disable-static \
              --without-python ADJTIME_PATH=/var/lib/hwclock/adjtime \
              --docdir=/usr/share/doc/util-linux-$pkgver
  make
}
package() { cd util-linux-$pkgver; make DESTDIR="$pkgdir" install; }
