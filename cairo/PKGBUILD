pkgrel=1
pkgdesc='Gráficos vectoriales 2D'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('custom')
depends=('libpng' 'pixman' 'fontconfig' 'freetype2' 'glib2' 'libx11' 'libxext' 'libxrender' 'libxcb')
makedepends=()
source=('https://www.cairographics.org/releases/cairo-1.18.4.tar.xz')
