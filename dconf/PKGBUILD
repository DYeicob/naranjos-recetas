# Receta de NaranjOS — generada por naranjos-tanda-6k3c.sh
pkgname=dconf
pkgver=0.49.0
pkgrel=1
pkgdesc='Base de datos de ajustes de GNOME/GTK (GSettings guarda aquí el tema)'
install=dconf.install
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('LGPL-2.1-or-later')
depends=('glib2' 'dbus')
makedepends=('meson' 'ninja')
source=('https://download.gnome.org/sources/dconf/0.49/dconf-0.49.0.tar.xz')
sha256sums=('16a47e49a58156dbb96578e1708325299e4c19eea9be128d5bd12fd0963d6c36')
build() {
  cd dconf-$pkgver
  meson setup build --prefix=/usr --buildtype=release -D bash_completion=false -D man=false -D vapi=false
  ninja -C build
}
package() {
  cd dconf-$pkgver
  DESTDIR="$pkgdir" ninja -C build install
}
