# Receta de NaranjOS — generada por naranjos-tanda-6e1.sh
pkgname=intel-ucode
pkgver=20260812
pkgrel=1
pkgdesc='Microcódigo de los procesadores Intel (lo carga el initramfs de NaranjOS al arrancar)'
arch=('any')
url='https://github.com/DYeicob/naranjos-recetas'
license=('LicenseRef-Intel-Microcode')
depends=()
makedepends=()
source=('https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/archive/microcode-20260812/Intel-Linux-Processor-Microcode-Data-Files-microcode-20260812.tar.gz')
sha256sums=('7614616d7b2988c278060486f47de716ef44c19317928cb45ac9e288fafd5bd1')
package() {
  cd Intel-Linux-Processor-Microcode-Data-Files-microcode-$pkgver
  install -d "$pkgdir/usr/lib/firmware/intel-ucode"
  install -m644 intel-ucode/* "$pkgdir/usr/lib/firmware/intel-ucode/"
  install -Dm644 "$(ls -1 | grep -im1 '^license')" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
