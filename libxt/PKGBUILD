pkgname=libxt
pkgver=1.3.1
pkgrel=1
pkgdesc='Biblioteca X11 libXt'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('MIT')
depends=('libsm' 'libx11' )
makedepends=('xorg-util-macros' 'xorgproto' 'xtrans')
source=('https://www.x.org/pub/individual/lib/libXt-1.3.1.tar.xz')
sha256sums=('e0a774b33324f4d4c05b199ea45050f87206586d81655f8bef4dba434d931288')
build()   { cd libXt-1.3.1; ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --docdir=/usr/share/doc/libXt-1.3.1 --with-appdefaultdir=/etc/X11/app-defaults; make; }
package() { cd libXt-1.3.1; make DESTDIR="$pkgdir" install; }
