build()   { cd wl-clipboard-$pkgver
  meson setup build --prefix=/usr --buildtype=plain -D zshcompletiondir=/usr/share/zsh/site-functions -D fishcompletiondir=no
  meson compile -C build; }
package() { cd wl-clipboard-$pkgver; DESTDIR="$pkgdir" meson install -C build; }
