install=naranjos-adornos.install
package() {
  local s
  for s in naranjos-barras naranjos-fondo-video naranjos-escritura naranjos-sincroniza; do install -Dm755 "$s" "$pkgdir/usr/bin/$s"; done
  install -Dm644 adornos.lua      "$pkgdir/usr/share/naranjos/hypr/adornos.lua"
  install -Dm644 fcitx5-tema.conf "$pkgdir/usr/share/naranjos/fcitx5-tema.conf"
  # (7e) apps gratis y sin cuenta, NVIDIA, git, estilo, consola de IA; red, discos y vídeo
  for s in naranjos-extra naranjos-graficos naranjos-git naranjos-estilo naranjos-consola-ia; do install -Dm755 "$s" "$pkgdir/usr/bin/$s"; done
  install -Dm644 60-naranjos-red.conf "$pkgdir/usr/lib/sysctl.d/60-naranjos-red.conf"
  install -Dm644 60-naranjos-planificador.rules "$pkgdir/usr/lib/udev/rules.d/60-naranjos-planificador.rules"
  for s in naranjos-extra-pdf naranjos-extra-disco naranjos-extra-juegos naranjos-graficos naranjos-git; do
    install -Dm644 "$s.desktop" "$pkgdir/usr/share/applications/$s.desktop"
  done
}
