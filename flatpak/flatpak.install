post_install() {
  systemd-sysusers >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true
  # la tienda: Flathub, para todo el sistema
  flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 \
    && echo "  NaranjOS: Flathub añadido. Instala Firefox con:  flatpak install flathub org.mozilla.firefox" \
    || echo "  NaranjOS: añade Flathub cuando tengas red:  sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo"
}
post_upgrade() { post_install; }
