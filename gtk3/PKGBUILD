pkgname=gtk3
pkgver=3.24.52
pkgrel=1
install=gtk3.install
pkgdesc='GTK 3: kit gráfico (lo usan Waybar y muchas aplicaciones)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('LGPL-2.1-or-later')
depends=('at-spi2-core' 'gdk-pixbuf2' 'libepoxy' 'pango' 'cairo' 'fribidi' 'harfbuzz' 'libxkbcommon' 'wayland' 'libx11' 'libxext' 'libxi' 'libxrandr' 'libxcursor' 'libxinerama' 'libxdamage' 'libxcomposite' 'libxfixes' 'hicolor-icon-theme' 'iso-codes' 'gsettings-desktop-schemas')
makedepends=('wayland-protocols')
source=('https://download.gnome.org/sources/gtk/3.24/gtk-3.24.52.tar.xz')
sha256sums=('80931fa472a77b9a164f6740e3c0b444fac6770054632d35a7ff9d679e5e7b9f')
provides=('gtk3-wayland' 'gtk-update-icon-cache')
build()   { cd gtk-$pkgver
  meson setup build --prefix=/usr --buildtype=plain \
    -D x11_backend=true -D wayland_backend=true -D broadway_backend=false \
    -D introspection=false -D man=false -D gtk_doc=false \
    -D demos=false -D examples=false -D tests=false \
    -D colord=no -D cloudproviders=false -D print_backends=file
  meson compile -C build; }
package() { cd gtk-$pkgver; DESTDIR="$pkgdir" meson install -C build; }
