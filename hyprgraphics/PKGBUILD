build()   { cd hyprgraphics-$pkgver; cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -W no-dev -G Ninja; ninja -C build; }
package() { cd hyprgraphics-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
