#!/bin/bash
# naranjos-instala — instala NaranjOS desde la ISO en vivo (fase 7c)
#   · disco entero o el espacio libre de un disco (junto a Windows u otro Linux)
#   · cifrado LUKS2 + Btrfs con los subvolúmenes de NaranjOS (@, @home, @log, @cache, @srv, @swap, @fotos)
#   · /boot aparte (ext4, sin cifrar: ahí lee GRUB el kernel) y la partición EFI
#   · el arranque de NaranjOS (shim 16.1 → GRUB firmado → kernel firmado) con una clave MOK PROPIA de este equipo
# Solo funciona en la sesión en vivo. Lo que se borra, se avisa antes y hay que escribir SI.
#   naranjos-instala              (desde el menú: «Instalar NaranjOS»)
#   naranjos-instala --bienvenida (aviso al entrar en la sesión en vivo)
set -uo pipefail
VERSION=0.3.0
O=$'\e[1;38;5;208m'; G=$'\e[1;32m'; R=$'\e[1;31m'; A=$'\e[1;33m'; D=$'\e[2m'; B=$'\e[1m'; Z=$'\e[0m'
VIVO=/run/naranjos-vivo; ABAJO=$VIVO/abajo
DEST=/mnt/naranjos-destino; MAPA=naranjos-instala
ESP_TIPO=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
MIN_GB=25
# textos traducibles (dominio «naranjos» de naranjos-idiomas); _f: con %s
. /usr/lib/naranjos/naranjos-i18n.sh 2>/dev/null || _(){ printf '%s' "$1"; }
_f(){ local m; m=$(_ "$1"); shift; printf "$m" "$@"; }

if [ "${1:-}" = --bienvenida ]; then
  [ -r /run/naranjos-vivo.estado ] || exit 0
  command -v notify-send >/dev/null && notify-send -a NaranjOS -t 20000 "$(_ 'NaranjOS en vivo')" \
    "$(_ 'Pruébalo sin miedo: nada se guarda. Para instalarlo: Super + Espacio → «Instalar NaranjOS».')"
  exit 0
fi
# desde el menú (sin terminal): se abre en una terminal de NaranjOS
if [ ! -t 0 ] && command -v foot >/dev/null; then exec foot --app-id=naranjos-instala -T "$(_ 'Instalar NaranjOS')" -e "$0" "$@"; fi

titulo(){ printf '\n%s━━ %s ━━%s\n' "$O" "$1" "$Z"; }
di(){ printf '%s▸%s %s\n' "$O" "$Z" "$*"; }
bien(){ printf '%s✔%s %s\n' "$G" "$Z" "$*"; }
aviso(){ printf '%s!%s %s\n' "$A" "$Z" "$*"; }
fin_mal(){ printf '\n%s✘ %s%s\n' "$R" "$1" "$Z"; deshaz; echo "  ${D}$(_ '(todo lo que ha pasado está en /tmp/naranjos-instala.log)')${Z}"; echo; read -rsn1 -p "$(_ 'Pulsa una tecla para cerrar…')"; exit 1; }
S(){ sudo "$@"; }

[ -r /run/naranjos-vivo.estado ] && [ -d "$ABAJO/usr" ] || { _ 'naranjos-instala solo funciona en la sesión en vivo de la ISO de NaranjOS.'; echo; exit 1; }
[ -d /sys/firmware/efi ] || { _ 'Este equipo ha arrancado en modo BIOS (sin UEFI): NaranjOS necesita UEFI.'; echo; read -rsn1; exit 1; }
sudo -n true 2>/dev/null || { _ 'Hace falta sudo sin contraseña (la sesión en vivo lo trae).'; echo; exit 1; }

# elige <título> <opción>… → el número de la opción (desde 0) en ELEGIDO; fuzzel si hay escritorio, si no, en la terminal
elige(){
  local t="$1"; shift; local n=$#
  if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v fuzzel >/dev/null; then
    ELEGIDO=$(printf '%s\n' "$@" | fuzzel --dmenu --index --prompt "$t ❯ " --lines $(( n < 15 ? n : 15 )) --width 70) || return 1
  else
    local i=0 o; echo "$B$t$Z"; for o in "$@"; do printf '  %d) %s\n' $((i + 1)) "$o"; i=$((i + 1)); done
    read -rp "$(_ 'Número:') " o; [[ "$o" =~ ^[0-9]+$ ]] && [ "$o" -ge 1 ] && [ "$o" -le $n ] || return 1; ELEGIDO=$((o - 1))
  fi
  [[ "$ELEGIDO" =~ ^[0-9]+$ ]]
}
pregunta_clave(){  # pregunta_clave <qué> → CLAVE (dos veces, mínimo 6 caracteres)
  local a b
  while :; do
    read -rsp "  $1: " a; echo; read -rsp "  $(_ 'Otra vez:') " b; echo
    [ "$a" = "$b" ] || { aviso "$(_ 'No coinciden. Otra vez.')"; continue; }
    [ ${#a} -ge 6 ] || { aviso "$(_ 'Mínimo 6 caracteres.')"; continue; }
    CLAVE=$a; return 0
  done
}
gib(){ awk -v b="$1" 'BEGIN{printf "%.0f", b / 1073741824}'; }

MONTADO=0; ABIERTO=0
deshaz(){  # deja el equipo como estaba (desmonta y cierra el cifrado); no borra nada
  sync
  if [ "$MONTADO" = 1 ]; then S umount -R "$DEST" 2>/dev/null || S umount -lR "$DEST" 2>/dev/null; MONTADO=0; fi
  if [ "$ABIERTO" = 1 ]; then S cryptsetup close "$MAPA" 2>/dev/null; ABIERTO=0; fi
  S rm -f /run/naranjos-instala.claves
}
trap 'deshaz' EXIT
# todo lo que sale en pantalla queda también en /tmp/naranjos-instala.log (las contraseñas no: no se ven)
REG=/tmp/naranjos-instala.log; : > "$REG"
exec > >(tee -a "$REG") 2>&1
trap 'echo; fin_mal "$(_ 'Cancelado.')"' INT

clear
# --- 0. idioma ----------------------------------------------------------------------------------------------
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v fuzzel >/dev/null; then
  i=$(printf 'Español\nEnglish\n' | fuzzel --dmenu --index --prompt "Idioma · Language ❯ " --lines 2 --width 40) || i=0
else
  printf 'Idioma · Language\n  1) Español\n  2) English\n'; read -rp "[1]: " i; i=$(( ${i:-1} - 1 ))
fi
if [ "$i" = 1 ]; then LENGUA=en; LOCAL=en_US.UTF-8; else LENGUA=es; LOCAL=es_ES.UTF-8; fi
export LANGUAGE=$LENGUA
printf '%s' "$O"
cat << 'LOGO'
      ▄▄▄▄
    ▄█████▀   NaranjOS
   ███████
   ▀█████▀
LOGO
printf '%s' "$Z"
echo "  $(_ 'Vamos a instalar NaranjOS en este equipo. Primero te pregunto todo;')"
echo "  $(_ 'no se toca ningún disco hasta el final, cuando escribas SI.')"

# --- 1. teclado y zona horaria ------------------------------------------------------------------------------
titulo "$(_ '1 · Teclado')"
TECLADOS=("$(_ 'Español (España)')|es|es" "$(_ 'Español (Latinoamérica)')|latam|la-latin1" "$(_ 'Inglés (EE. UU.)')|us|us" "$(_ 'Inglés (Reino Unido)')|gb|uk"
          "$(_ 'Francés')|fr|fr" "$(_ 'Alemán')|de|de" "$(_ 'Italiano')|it|it" "$(_ 'Portugués (Portugal)')|pt|pt-latin1" "$(_ 'Portugués (Brasil)')|br|br-abnt2")
[ "$LENGUA" = en ] && TECLADOS=("${TECLADOS[2]}" "${TECLADOS[3]}" "${TECLADOS[0]}" "${TECLADOS[@]:4}" "${TECLADOS[1]}")
elige "$(_ 'Teclado')" "${TECLADOS[@]%%|*}" || fin_mal "$(_ 'Cancelado.')"
IFS='|' read -r TEC_NOMBRE XKB KEYMAP <<< "${TECLADOS[$ELEGIDO]}"
bien "$TEC_NOMBRE"

titulo "$(_ '2 · Zona horaria')"
mapfile -t ZONAS < <(cd /usr/share/zoneinfo && find . -type f -path './[A-Z]*/*' ! -path './Etc/*' ! -path './right/*' ! -path './posix/*' \
                     | sed 's|^\./||' | sort)
ZONAS=("Europe/Madrid" "Atlantic/Canary" "${ZONAS[@]}")
elige "$(_ 'Zona horaria')" "${ZONAS[@]}" || fin_mal "$(_ 'Cancelado.')"
ZONA=${ZONAS[$ELEGIDO]}; bien "$ZONA"

# --- 2. el disco --------------------------------------------------------------------------------------------
titulo "$(_ '3 · Disco')"
MEDIO=$(sed -n 's/^dev=//p' /run/naranjos-vivo.estado)
MEDIO_DISCO=$(lsblk -dnro PKNAME "$MEDIO" 2>/dev/null); [ -n "$MEDIO_DISCO" ] || MEDIO_DISCO=$(basename "$MEDIO")
mapfile -t DISCOS < <(lsblk -dbpnro NAME,TYPE,RO,SIZE | awk '$2=="disk" && $3==0 && $1 !~ /zram|loop/ {print $1" "$4}')
OPC=(); LISTA=()
for l in "${DISCOS[@]}"; do
  read -r d tam <<< "$l"
  [ "$(basename "$d")" = "$MEDIO_DISCO" ] && continue
  [ "$tam" -ge $((MIN_GB * 1073741824)) ] || continue
  mod=$(lsblk -dno MODEL "$d" 2>/dev/null | sed 's/ *$//')
  que=$(lsblk -rno FSTYPE "$d" | awk 'NF' | sort -u | tr '\n' ' ')
  hay=""
  [[ "$que" == *ntfs* || "$que" == *BitLocker* ]] && hay+="Windows "
  [[ "$que" =~ ext4|btrfs|xfs|crypto_LUKS ]] && hay+="Linux "
  [ -z "$que" ] && hay="$(_ 'vacío')"
  OPC+=("$(basename "$d") · $(gib "$tam") GB · ${mod:-$(_ 'disco')} · ${hay:-$(_ 'con datos')}"); LISTA+=("$d")
done
[ ${#LISTA[@]} -gt 0 ] || fin_mal "$(_f 'No hay ningún disco de al menos %s GB (sin contar el USB/DVD de NaranjOS).' "$MIN_GB")"
elige "$(_ 'Disco donde instalar')" "${OPC[@]}" || fin_mal "$(_ 'Cancelado.')"
DISCO=${LISTA[$ELEGIDO]}; bien "${OPC[$ELEGIDO]}"
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DISCO" | sed 's/^/    /'
if lsblk -rno MOUNTPOINTS "$DISCO" | grep -q .; then fin_mal "$(_ 'Algo de ese disco está en uso (montado). Desmóntalo y vuelve a empezar.')"; fi

# el mayor hueco libre (GPT), alineado a 1 MiB
SS=$(blockdev --getss "$DISCO" 2>/dev/null || echo 512)
ES_GPT=0; S sfdisk -d "$DISCO" 2>/dev/null | grep -q '^label: gpt' && ES_GPT=1
HUECO_INI=0; HUECO_SEC=0
if [ "$ES_GPT" = 1 ]; then
  read -r HUECO_INI HUECO_SEC < <(S env LC_ALL=C sfdisk -F "$DISCO" 2>/dev/null | awk '$1 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {print $1, $3}' | sort -k2 -n | tail -n1)
fi
AL=$((1048576 / SS))
HI=$(( ( ${HUECO_INI:-0} + AL - 1 ) / AL * AL )); HF=$(( ( ${HUECO_INI:-0} + ${HUECO_SEC:-0} ) / AL * AL ))
LIBRE=$(( (HF - HI) * SS )); [ "$LIBRE" -gt 0 ] || LIBRE=0
ESP_EXISTE=$(lsblk -rpno NAME,PARTTYPE,FSTYPE "$DISCO" | awk -v t="$ESP_TIPO" 'tolower($2)==t && $3=="vfat" {print $1; exit}')
MODOS=("$(_ 'Borrar TODO el disco e instalar NaranjOS')")
PUEDE_LIBRE=0
if [ "$ES_GPT" = 1 ] && [ -n "$ESP_EXISTE" ] && [ "$LIBRE" -ge $((MIN_GB * 1073741824)) ]; then
  PUEDE_LIBRE=1; MODOS=("$(_f 'Usar el espacio libre (%s GB) y dejar lo demás como está' "$(gib "$LIBRE")")" "${MODOS[@]}")
fi
elige "$(_f 'Cómo usar %s' "$(basename "$DISCO")")" "${MODOS[@]}" || fin_mal "$(_ 'Cancelado.')"
if [ "$PUEDE_LIBRE" = 1 ] && [ "$ELEGIDO" = 0 ]; then MODO=libre; else MODO=entero; fi
if [ "$MODO" = entero ]; then
  bien "$(_f 'Disco entero: SE BORRARÁ TODO lo que hay en %s' "$(basename "$DISCO")")"
else
  bien "$(_f 'Espacio libre: %s GB (se usa la partición EFI que ya hay: %s)' "$(gib "$LIBRE")" "$ESP_EXISTE")"
fi
if [ "$PUEDE_LIBRE" = 0 ]; then
  echo "  ${D}$(_f '(para instalar junto a otro sistema hace falta un hueco libre de %s GB o más en un disco GPT con partición EFI;' "$MIN_GB")"
  echo "   $(_ 'hazlo antes desde ese sistema, p. ej. «Administración de discos» en Windows → Reducir volumen)')${Z}"
fi
WINDOWS=0; [[ "$(lsblk -rno FSTYPE)" =~ ntfs|BitLocker ]] && WINDOWS=1

# --- 3. tú --------------------------------------------------------------------------------------------------
titulo "$(_ '4 · Tu usuario')"
while :; do read -rp "  $(_ 'Tu nombre (p. ej. Ana García):') " NOMBRE; [ -n "$NOMBRE" ] && [[ "$NOMBRE" != *:* ]] && break; done
SUG=$(printf '%s' "${NOMBRE%% *}" | iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9')
while :; do
  read -rp "  $(_ 'Nombre de usuario') [${SUG:-yo}]: " USUARIO; USUARIO=${USUARIO:-${SUG:-yo}}
  [[ "$USUARIO" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && [ "$USUARIO" != root ] && [ "$USUARIO" != naranjos ] && break
  aviso "$(_ 'Solo minúsculas, números, - y _, empezando por una letra (y que no sea root ni naranjos).')"
done
pregunta_clave "$(_f 'Contraseña de %s' "$USUARIO")"; CLAVE_USU=$CLAVE
while :; do
  read -rp "  $(_ 'Nombre del equipo') [naranjos-$USUARIO]: " EQUIPO; EQUIPO=${EQUIPO:-naranjos-$USUARIO}
  [[ "$EQUIPO" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,62}$ ]] && break; aviso "$(_ 'Letras, números y guiones.')"
done

titulo "$(_ '5 · Cifrado del disco')"
echo "  $(_ 'NaranjOS cifra el disco: sin la contraseña, nadie puede leer tus datos aunque se lleve el equipo.')"
echo "  $(_ 'Se pide al encender.') ${B}$(_ 'Si la olvidas, los datos se pierden para siempre.')${Z}"
elige "$(_ 'Contraseña del disco')" "$(_f 'La misma que la de %s' "$USUARIO")" "$(_ 'Otra distinta')" || fin_mal "$(_ 'Cancelado.')"
if [ "$ELEGIDO" = 0 ]; then CLAVE_DISCO=$CLAVE_USU; else pregunta_clave "$(_ 'Contraseña del disco')"; CLAVE_DISCO=$CLAVE; fi
unset CLAVE

HORA_LOCAL=0
if [ "$WINDOWS" = 1 ]; then
  titulo "$(_ '6 · La hora (hay Windows)')"
  echo "  $(_ 'Windows guarda la hora del reloj del equipo en hora local; Linux, en UTC. Si no coinciden, al pasar')"
  echo "  $(_ 'de uno a otro la hora sale mal (1 o 2 horas).')"
  elige "$(_ 'Hora del reloj del equipo')" "$(_ 'Hora local, como Windows (recomendado con Windows)')" "$(_ 'UTC (lo normal en Linux)')" || fin_mal "$(_ 'Cancelado.')"
  [ "$ELEGIDO" = 0 ] && HORA_LOCAL=1
fi

SB=0; [ "$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | awk '{print $NF}')" = 1 ] && SB=1

# --- 4. resumen y confirmación ------------------------------------------------------------------------------
titulo "$(_ 'Resumen')"
echo "  $(_ 'Idioma:')      $([ "$LENGUA" = en ] && echo English || echo Español)      $(_ 'Teclado:') $TEC_NOMBRE"
echo "  $(_ 'Zona:')        $ZONA$([ "$HORA_LOCAL" = 1 ] && echo "  ($(_ 'reloj en hora local'))")"
echo "  $(_ 'Usuario:')     $USUARIO ($NOMBRE)      $(_ 'Equipo:') $EQUIPO"
echo "  $(_ 'Disco:')       $DISCO  ($(gib "$(lsblk -dbno SIZE "$DISCO")") GB)"
if [ "$MODO" = entero ]; then
  echo "  ${R}${B}$(_f 'SE BORRA TODO EL DISCO %s' "$DISCO")${Z} $(_ 'y se crean: EFI 1 GB · /boot 1 GB · NaranjOS cifrado (el resto)')"
else
  echo "  $(_f 'En el espacio libre (%s GB): /boot 1 GB · NaranjOS cifrado (el resto). Lo demás no se toca.' "$(gib "$LIBRE")")"
  echo "  $(_f 'El arranque se añade a la partición EFI que ya hay (%s), en EFI/naranjos (nada más).' "$ESP_EXISTE")"
fi
echo "  Secure Boot: $([ "$SB" = 1 ] && _ 'activo → al reiniciar tendrás que registrar la clave de este equipo (te explico cómo)' || _ 'apagado')"
echo
read -rp "  $(_ 'Escribe SI (en mayúsculas) para instalar:') " r
[ "$r" = SI ] || fin_mal "$(_ 'No se ha tocado nada.')"

# --- 5. particiones -----------------------------------------------------------------------------------------
titulo "$(_ 'Instalando')"
GIB=$((1073741824 / SS))
if [ "$MODO" = entero ]; then
  di "$(_ 'Creando las particiones…')"
  S wipefs -aq "$DISCO" >/dev/null 2>&1
  printf 'label: gpt\nstart=%s, size=%s, type=U, name="EFI"\nsize=%s, type=L, name="NaranjOS boot"\ntype=L, name="NaranjOS"\n' "$AL" "$GIB" "$GIB" \
    | S sfdisk -q --wipe always --wipe-partitions always "$DISCO" >/dev/null || fin_mal "$(_ 'sfdisk no pudo crear las particiones')"
else
  di "$(_ 'Creando las particiones en el espacio libre…')"
  T2=$(( (HF - HI - GIB) / AL * AL ))
  printf 'start=%s, size=%s, type=L, name="NaranjOS boot"\nstart=%s, size=%s, type=L, name="NaranjOS"\n' "$HI" "$GIB" "$((HI + GIB))" "$T2" \
    | S sfdisk -q --append --wipe-partitions always "$DISCO" >/dev/null || fin_mal "$(_ 'sfdisk no pudo crear las particiones')"
fi
S partx -u "$DISCO" 2>/dev/null; S udevadm settle --timeout=15
pnum(){ local n; n=$(lsblk -dno PARTN "$1" 2>/dev/null | tr -d ' '); [ -n "$n" ] || n=${1##*[!0-9]}; echo "$n"; }
# la partición que empieza en el sector <n> (por sfdisk: no depende de udev)
part_en(){ S sfdisk -d "$DISCO" 2>/dev/null | sed -n "s|^\(/dev/[^ ]*\) : start= *$1,.*|\1|p"; }
if [ "$MODO" = entero ]; then
  P_ESP=$(part_en "$AL"); P_BOOT=$(part_en $((AL + GIB))); P_RAIZ=$(part_en $((AL + 2 * GIB)))
  [ -b "$P_ESP" ] && [ -b "$P_BOOT" ] && [ -b "$P_RAIZ" ] || fin_mal "$(_ 'No veo las particiones nuevas')"
  S mkfs.fat -F 32 -n NARANJOSEFI "$P_ESP" >/dev/null || fin_mal "mkfs.fat falló"
else
  P_ESP=$ESP_EXISTE
  P_BOOT=$(part_en "$HI"); P_RAIZ=$(part_en "$((HI + GIB))")
  [ -b "$P_BOOT" ] && [ -b "$P_RAIZ" ] || fin_mal "$(_ 'No veo las particiones nuevas')"
fi
S mkfs.ext4 -q -F -L NARANJOSBOOT "$P_BOOT" || fin_mal "mkfs.ext4 falló"
bien "$(_ 'Particiones:') EFI $P_ESP · /boot $P_BOOT · NaranjOS $P_RAIZ"

di "$(_f 'Cifrando %s (LUKS2)…' "$P_RAIZ")"
printf '%s' "$CLAVE_DISCO" | S cryptsetup luksFormat --type luks2 --batch-mode --label NARANJOS_CIFRADO --key-file=- "$P_RAIZ" \
  || fin_mal "cryptsetup no pudo cifrar la partición"
printf '%s' "$CLAVE_DISCO" | S cryptsetup open --key-file=- "$P_RAIZ" "$MAPA" || fin_mal "cryptsetup no pudo abrirla"
ABIERTO=1; unset CLAVE_DISCO
MAP=/dev/mapper/$MAPA
S mkfs.btrfs -q -f -L NARANJOS "$MAP" >/dev/null || fin_mal "mkfs.btrfs falló"
S mkdir -p "$DEST"
S mount -o subvolid=5 "$MAP" "$DEST" || fin_mal "No pude montar el Btrfs"
for v in @ @home @log @cache @srv @swap @fotos; do S btrfs subvolume create "$DEST/$v" >/dev/null || fin_mal "No pude crear $v"; done
S umount "$DEST"
OPC_BTRFS="noatime,compress=zstd:1"
S mount -o "subvol=/@,$OPC_BTRFS" "$MAP" "$DEST" || fin_mal "No pude montar @"; MONTADO=1
S mkdir -p "$DEST"/{home,var/log,var/cache,srv,swap,boot}
S mount -o "subvol=/@home,$OPC_BTRFS" "$MAP" "$DEST/home"
S mount -o "subvol=/@log,$OPC_BTRFS" "$MAP" "$DEST/var/log"
S mount -o "subvol=/@cache,$OPC_BTRFS" "$MAP" "$DEST/var/cache"
S mount -o "subvol=/@srv,$OPC_BTRFS" "$MAP" "$DEST/srv"
S mount -o "subvol=/@swap,noatime" "$MAP" "$DEST/swap"
S mount "$P_BOOT" "$DEST/boot" || fin_mal "No pude montar /boot"
S mkdir -p "$DEST/boot/efi"; S mount -o umask=0077 "$P_ESP" "$DEST/boot/efi" || fin_mal "No pude montar la partición EFI"
bien "$(_ 'Cifrado y Btrfs listos')"

# --- 6. copiar el sistema -----------------------------------------------------------------------------------
di "$(_ 'Copiando NaranjOS al disco (unos minutos)…')"
( S tar -C "$ABAJO" --xattrs --xattrs-include='*' --one-file-system -cf - . 2>/tmp/naranjos-instala-tar1.log \
    | S tar -C "$DEST" --xattrs --xattrs-include='*' -xpf - 2>/tmp/naranjos-instala-tar2.log; echo $? > /tmp/naranjos-instala-tar.rc ) &
hilo=$!
usado(){ df -B1 --output=used "$DEST" "$DEST/boot" 2>/dev/null | awk 'NR>1 {s+=$1} END {print s+0}'; }
base=$(usado)
while kill -0 "$hilo" 2>/dev/null; do
  printf "\r  $(_ '%s escritos en el disco (comprimidos)…')   " "$(numfmt --to=iec $(( $(usado) - base )))"; sleep 3
done
wait "$hilo"; echo
[ "$(cat /tmp/naranjos-instala-tar.rc 2>/dev/null)" = 0 ] || { tail -5 /tmp/naranjos-instala-tar2.log; fin_mal "$(_ 'La copia falló')"; }
bien "$(_ 'Sistema copiado')"

# --- 7. fstab -----------------------------------------------------------------------------------------------
U_BTRFS=$(S blkid -s UUID -o value "$MAP"); U_BOOT=$(S blkid -s UUID -o value "$P_BOOT"); U_ESP=$(S blkid -s UUID -o value "$P_ESP")
{
  echo "# NaranjOS · /etc/fstab (lo creó naranjos-instala $VERSION)"
  echo "# La raíz está cifrada (LUKS2): la abre el initramfs al arrancar."
  echo "UUID=$U_BTRFS  /          btrfs  subvol=/@,$OPC_BTRFS        0 0"
  echo "UUID=$U_BTRFS  /home      btrfs  subvol=/@home,$OPC_BTRFS    0 0"
  echo "UUID=$U_BTRFS  /var/log   btrfs  subvol=/@log,$OPC_BTRFS     0 0"
  echo "UUID=$U_BTRFS  /var/cache btrfs  subvol=/@cache,$OPC_BTRFS   0 0"
  echo "UUID=$U_BTRFS  /srv       btrfs  subvol=/@srv,$OPC_BTRFS     0 0"
  echo "UUID=$U_BTRFS  /swap      btrfs  subvol=/@swap,noatime       0 0"
  echo "UUID=$U_BOOT   /boot      ext4   defaults,noatime            0 2"
  echo "UUID=$U_ESP    /boot/efi  vfat   umask=0077,noatime          0 2"
} | S tee "$DEST/etc/fstab" >/dev/null
bien "fstab"

# --- 8. dentro del sistema nuevo ----------------------------------------------------------------------------
di "$(_ 'Configurando el sistema nuevo…')"
S mkdir -p "$DEST"/{dev,proc,sys,run,tmp}   # la raíz de la ISO no trae /sys (a propósito): aquí sí hace falta
S mount --rbind /dev "$DEST/dev"; S mount --make-rslave "$DEST/dev"
S mount --rbind /sys "$DEST/sys"; S mount --make-rslave "$DEST/sys"
S mount -t proc proc "$DEST/proc"; S mount -t tmpfs -o mode=0755 run "$DEST/run"
S mkdir -p "$DEST/run/udev"; S mount --bind /run/udev "$DEST/run/udev"   # lsblk ve UUIDs y PARTUUIDs (los usa el arranque)
printf '%s:%s\n' "$USUARIO" "$CLAVE_USU" | S install -m600 /dev/stdin "$DEST/run/naranjos-instala.usuario"; unset CLAVE_USU
DISCO_N=$DISCO; ESP_N=$(pnum "$P_ESP")
S install -m700 /dev/stdin "$DEST/run/naranjos-instala-dentro.sh" << "DENTRO"
#!/bin/bash
set -uo pipefail
. /usr/lib/naranjos/naranjos-i18n.sh 2>/dev/null || _(){ printf '%s' "$1"; }
mal(){ echo "  ✘ $*" >&2; exit 1; }
paso(){ echo "  · $*"; }
paso "$(_ 'quitando lo de la sesión en vivo')"
userdel -r naranjos >/dev/null 2>&1 || true
rm -f /etc/sudoers.d/90-naranjos-vivo /usr/share/applications/naranjos-instala.desktop
sed -i '/^naranjos:/d' /etc/subuid /etc/subgid 2>/dev/null
[ -f /etc/greetd/config.toml ] && sed -i '/^\[initial_session\]/,/^\[/{/^\[initial_session\]/d;/^command/d;/^user/d}' /etc/greetd/config.toml
rm -f /etc/systemd/system/multi-user.target.wants/naranjos-llavero.service /etc/systemd/system/naranjos-llavero.service
printf '# NaranjOS · ajustes del initramfs (naranjos-initramfs)\n# Tras cambiar algo:  sudo naranjos-initramfs --todos\n\n# Módulos extra que meter, separados por espacios (p. ej. MODULOS="i915 amdgpu")\nMODULOS=""\n\n# Microcódigo del procesador: todos | este\nMICROCODIGO=todos\n' > /etc/naranjos/initramfs.conf
paso "$(_ 'llavero de pacman')"
rm -rf /etc/pacman.d/gnupg
{ pacman-key --init && pacman-key --populate naranjos; } >/dev/null 2>&1 || echo "  ! El llavero de pacman se creará al arrancar (pacman-key --init)"
paso "$(_ 'equipo, hora, idioma y teclado')"
# el idioma del sistema (y su locale, si no estaba hecho)
localedef --list-archive 2>/dev/null | grep -qix "${LOCAL/UTF-8/utf8}" \
  || localedef -i "${LOCAL%%.*}" -f UTF-8 "$LOCAL" >/dev/null 2>&1 || true
printf 'LANG=%s\n' "$LOCAL" > /etc/locale.conf
echo "$EQUIPO" > /etc/hostname
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$EQUIPO" > /etc/hosts
rm -f /etc/machine-id; systemd-machine-id-setup >/dev/null 2>&1
ln -sf "/usr/share/zoneinfo/$ZONA" /etc/localtime
if [ "$HORA_LOCAL" = 1 ]; then printf '0.0 0 0.0\n0\nLOCAL\n' > /etc/adjtime; else printf '0.0 0 0.0\n0\nUTC\n' > /etc/adjtime; fi
echo "ro rootwait" > /etc/naranjos/cmdline   # las opciones del kernel de este equipo (no las del que hizo la ISO)
touch /etc/vconsole.conf; sed -i '/^KEYMAP=/d' /etc/vconsole.conf; echo "KEYMAP=$KEYMAP" >> /etc/vconsole.conf
paso "$(_ 'usuario') $USUARIO"
/usr/bin/naranjos-sysusers >/dev/null 2>&1 || true
useradd -m -U -G wheel,video,audio,input,storage,plugdev -s /usr/bin/zsh -c "$NOMBRE" "$USUARIO" 2>/dev/null \
  || useradd -m -U -G wheel -s /bin/bash -c "$NOMBRE" "$USUARIO" || mal "No pude crear el usuario"
chpasswd < /run/naranjos-instala.usuario || mal "No pude poner la contraseña"
rm -f /run/naranjos-instala.usuario
passwd -l root >/dev/null 2>&1
grep -Eqs '^[[:space:]]*%wheel[[:space:]]' /etc/sudoers /etc/sudoers.d/* \
  || { echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-naranjos-wheel; chmod 440 /etc/sudoers.d/10-naranjos-wheel; }
printf '%s:100000:65536\n' "$USUARIO" >> /etc/subuid; printf '%s:100000:65536\n' "$USUARIO" >> /etc/subgid
if [ "$XKB" != es ]; then
  install -d -o "$USUARIO" -g "$USUARIO" "/home/$USUARIO/.config/naranjos"
  printf -- '-- teclado elegido al instalar (naranjos-instala)\nhl.config({ input = { kb_layout = "%s" } })\n' "$XKB" > "/home/$USUARIO/.config/naranjos/complementos.lua"
  chown "$USUARIO:$USUARIO" "/home/$USUARIO/.config/naranjos/complementos.lua"
fi
paso "$(_ 'clave MOK de este equipo')"
install -d -m700 /etc/naranjos/mok
openssl req -new -x509 -newkey rsa:2048 -nodes -days 36500 -sha256 -subj "/CN=NaranjOS MOK ($EQUIPO)/" \
  -keyout /etc/naranjos/mok/MOK.priv -out /etc/naranjos/mok/MOK.pem >/dev/null 2>&1 || mal "No pude crear la clave MOK"
openssl x509 -in /etc/naranjos/mok/MOK.pem -outform DER -out /etc/naranjos/mok/MOK.der || mal "No pude crear MOK.der"
chmod 600 /etc/naranjos/mok/MOK.priv
# kernel firmado, initramfs y arranque (con el shim 16.1: va también en firmwares estrictos)
mkdir -p /etc/naranjos; touch /etc/naranjos/arranque.conf
sed -i '/^SHIM16=/d' /etc/naranjos/arranque.conf; echo SHIM16=1 >> /etc/naranjos/arranque.conf
paso "$(_ 'kernel firmado')"; naranjos-kernel instala >/dev/null || mal "naranjos-kernel falló"
paso "initramfs"; naranjos-initramfs --todos >/tmp/initramfs.log 2>&1 || { tail -5 /tmp/initramfs.log; mal "naranjos-initramfs falló"; }
paso "$(_ 'arranque (GRUB firmado y menú)')"; naranjos-arranque instala --si || mal "naranjos-arranque falló"
install -m644 /etc/naranjos/mok/MOK.der /boot/efi/EFI/naranjos/NARANJOS-MOK.der
if [ "$MODO" = entero ]; then   # por si el firmware olvida la entrada: también como arranque por defecto del disco
  install -d /boot/efi/EFI/BOOT
  cp /boot/efi/EFI/naranjos/shimx64.efi /boot/efi/EFI/BOOT/BOOTX64.EFI
  cp /boot/efi/EFI/naranjos/grubx64.efi /boot/efi/EFI/naranjos/mmx64.efi /boot/efi/EFI/naranjos/NARANJOS-MOK.der /boot/efi/EFI/BOOT/
fi
paso "$(_ 'entrada en el firmware')"; efibootmgr -q -c -d "$DISCO_N" -p "$ESP_N" -L NaranjOS -l '\EFI\naranjos\shimx64.efi' >/dev/null 2>&1 \
  || echo "  ! No pude crear la entrada en el firmware (se puede arrancar desde EFI/naranjos/shimx64.efi)"
# modo de emergencia: root está bloqueado, así que sin esto no habría consola para arreglar nada
for s in emergency rescue; do
  install -d "/etc/systemd/system/$s.service.d"
  printf '[Service]\nEnvironment=SYSTEMD_SULOGIN_FORCE=1\n' > "/etc/systemd/system/$s.service.d/naranjos.conf"
done
# la foto «fábrica»: para «naranjos-fabrica» (restablecer o dejarlo para un nuevo dueño)
paso "$(_ 'foto de fábrica')"
fotos crea --sin-menu "fábrica: recién instalado" >/dev/null 2>&1 || echo "  ! No pude hacer la foto de fábrica (naranjos-fabrica no funcionará)"
exit 0
DENTRO
S env LANGUAGE="$LENGUA" LOCAL="$LOCAL" EQUIPO="$EQUIPO" ZONA="$ZONA" HORA_LOCAL="$HORA_LOCAL" KEYMAP="$KEYMAP" XKB="$XKB" NOMBRE="$NOMBRE" USUARIO="$USUARIO" \
  MODO="$MODO" DISCO_N="$DISCO_N" ESP_N="$ESP_N" PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin HOME=/root \
  chroot "$DEST" /bin/bash /run/naranjos-instala-dentro.sh || fin_mal "$(_ 'La configuración del sistema nuevo falló')"
bien "$(_f 'Usuario %s, clave MOK de %s, kernel firmado, initramfs y arranque' "$USUARIO" "$EQUIPO")"

deshaz
titulo "$(_ '¡NaranjOS está instalado!')"
echo "  $(_ '1. Apaga, quita el USB/DVD de NaranjOS y enciende.')"
echo "  $(_f '2. Al arrancar te pedirá la contraseña del disco y luego la de %s.' "$USUARIO")"
if [ "$SB" = 1 ]; then
  echo "  ${A}$(_ 'Con Secure Boot, la primera vez saldrá una pantalla azul (MokManager):')${Z}"
  echo "     $(_ '«Verification failed» → Enter · «Press any key to perform MOK management» → pulsa una tecla YA (10 s)')"
  echo "     $(_ '→ Enroll key from disk → la partición EFI → EFI → naranjos → NARANJOS-MOK.der → Continue → Yes → Reboot')"
fi
echo "  ${D}$(_ 'Si algún día quieres dejarlo como recién instalado: Super + Espacio → «Restablecer NaranjOS».')${Z}"
echo
read -rsn1 -p "$(_ 'Pulsa una tecla para cerrar…')"; echo
