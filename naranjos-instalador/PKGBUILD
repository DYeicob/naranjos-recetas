depends=('cryptsetup' 'btrfs-progs' 'e2fsprogs' 'dosfstools' 'util-linux' 'efibootmgr' 'openssl' 'sbsigntools' 'naranjos-arranque' 'naranjos-initramfs' 'naranjos-shim16' 'naranjos-fotos' 'foot' 'fuzzel' 'sudo' 'python')
makedepends=()
source=('naranjos-instala' 'naranjos-fabrica' 'naranjos-bienvenida' 'naranjos-bienvenida.service' 'naranjos-fabrica.desktop')
sha256sums=('a77d562a654049b614350805bdd0acc9c1fdaade0f836d9862d1015dcfff1ed1' '13fa58a82f30b88bb06009da06185bbf63e37fc3a1f459682865b4fa83d35695' '511c1500c4af13b699cb42a5a07035fde3d8e5cb79278a15bf2594dc1c19909e' '7f58c219a34d78068414f04cd2e7622a4d27bc1309e0629fe9a0c6553c314db0' 'a9ec55ddc50690fa1f1e2b80353dd0e07ad2fe641927e121eb4db5d164f951c8')
package() {
  local s
  for s in naranjos-instala naranjos-fabrica naranjos-bienvenida; do install -Dm755 "$s" "$pkgdir/usr/bin/$s"; done
  install -Dm644 naranjos-bienvenida.service "$pkgdir/usr/lib/systemd/system/naranjos-bienvenida.service"
  install -Dm644 naranjos-fabrica.desktop "$pkgdir/usr/share/applications/naranjos-fabrica.desktop"
}
