#!/usr/bin/bash
# zumo — gestor de paquetes de NaranjOS (usa pacman por dentro)
VERSION="0.2.0"

if [ -t 1 ]; then
  if [ "$TERM" = linux ]; then O=$'\e[0;33m'; else O=$'\e[1;38;5;208m'; fi
  B=$'\e[1m'; R=$'\e[1;31m'; G=$'\e[1;32m'; Z=$'\e[0m'
else O=; B=; R=; G=; Z=; fi
msg(){ printf '%s==>%s %s\n' "$O" "$Z" "$*"; }
okm(){ printf '%s  ✓%s %s\n' "$G" "$Z" "$*"; }
die(){ printf '%szumo:%s %s\n' "$R" "$Z" "$*" >&2; exit 1; }
SUDO=; [ "$(id -u)" -ne 0 ] && SUDO=sudo
hace_falta(){ [ $# -gt 0 ] || die "falta el nombre del paquete. Ejemplo: zumo $ORDEN firefox"; }

ayuda(){ cat << EOF
${O}zumo${Z} ${VERSION} · el gestor de paquetes de ${O}NaranjOS${Z}

${B}Uso:${Z} zumo <orden> [paquetes…]

${B}Instalar y quitar${Z}
  ${O}instala${Z}  | install   <paq…>   Instala paquetes (y sus dependencias)
  ${O}quita${Z}    | remove    <paq…>   Desinstala paquetes y lo que ya no haga falta
  ${O}local${Z}    | install-file <fich>  Instala un fichero .pkg.tar.zst

${B}Mantener el sistema al día${Z}
  ${O}actualiza${Z}| update              Actualiza todo el sistema
  ${O}limpia${Z}   | clean               Quita huérfanos y vacía la caché antigua

${B}Consultar${Z}
  ${O}busca${Z}    | search    <texto>   Busca en los repositorios
  ${O}info${Z}               <paq>     Información de un paquete
  ${O}lista${Z}    | list                Paquetes instalados
  ${O}archivos${Z} | files     <paq>     Ficheros que instaló un paquete
  ${O}de${Z}       | owns      <fich>    Qué paquete instaló un fichero
  ${O}huerfanos${Z}| orphans             Dependencias que ya nadie usa

${B}Para quien crea paquetes${Z}
  ${O}exprime${Z}  | build [-i] <receta…>  Construye, firma y añade al repositorio
                                 (-i: además lo instala). Las recetas se
                                 buscan en ~/naranjos-recetas

  ${O}version${Z}  | --version           Versión de zumo y de pacman
  ${O}ayuda${Z}    | help                Esta ayuda

${B}Ejemplos:${Z}  zumo busca editor   ·   zumo instala git   ·   zumo exprime -i wayland
EOF
}

# --- zumo exprime: construir + firmar + publicar en el repositorio local -----------------
exprime(){
  [ "$(id -u)" -ne 0 ] || die "'exprime' se usa con tu usuario normal, no como root."
  local REPO="${ZUMO_REPO:-/srv/zumo/naranjos-core}" RECETAS="${ZUMO_RECETAS:-$HOME/naranjos-recetas}"
  local CONF="${XDG_CONFIG_HOME:-$HOME/.config}/zumo/exprime.conf"
  # shellcheck disable=SC1090
  [ -r "$CONF" ] && . "$CONF"
  local DB="$REPO/$(basename "$REPO").db.tar.zst" INSTALA=0 r d nombres=() pkgs=()
  [ -d "$REPO" ] && [ -w "$REPO" ] || die "no puedo escribir en el repositorio $REPO"
  if [ -z "${GPGKEY:-}" ]; then
    GPGKEY=$(gpg --list-secret-keys --with-colons "NaranjOS Packager" 2>/dev/null | awk -F: '/^fpr/{print $10; exit}')
  fi
  [ -n "$GPGKEY" ] || die "no encuentro la clave de firma de NaranjOS (gpg)"
  export GPGKEY GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null)}"
  if [ "${1:-}" = -i ] || [ "${1:-}" = --instala ] || [ "${1:-}" = --install ]; then INSTALA=1; shift; fi
  [ $# -gt 0 ] || die "dime qué receta(s) exprimir. Ejemplo: zumo exprime wayland"

  msg "Refrescando la lista de paquetes…"
  sudo pacman -Sy >/dev/null || die "pacman -Sy falló"
  for r in "$@"; do
    d="$r"; [ -f "$d/PKGBUILD" ] || d="$RECETAS/$r"
    [ -f "$d/PKGBUILD" ] || die "no encuentro la receta '$r' (ni ./$r ni $RECETAS/$r)"
    d=$(cd "$d" && pwd)
    msg "Exprimiendo ${B}$(basename "$d")${Z}…"
    ( cd "$d" && PKGDEST="$REPO" makepkg -sf --sign --noconfirm ) || die "makepkg falló en '$(basename "$d")'"
    mapfile -t pkgs < <(cd "$d" && PKGDEST="$REPO" makepkg --packagelist)
    [ ${#pkgs[@]} -gt 0 ] || die "makepkg no dijo qué paquetes generó"
    repo-add --sign --key "$GPGKEY" --verify --remove "$DB" "${pkgs[@]}" >/dev/null \
      || die "repo-add falló con $(basename "$d")"
    rm -rf "$d/src" "$d/pkg"
    for p in "${pkgs[@]}"; do okm "$(basename "$p")"; done
    mapfile -t -O "${#nombres[@]}" nombres < <(cd "$d" && makepkg --printsrcinfo | awk '/^pkgname = /{print $3}')
    sudo pacman -Sy >/dev/null
  done
  if [ "$INSTALA" = 1 ]; then
    msg "Instalando: ${nombres[*]}"
    sudo pacman -S --needed "${nombres[@]}"
  fi
  okm "Listo. Para publicarlo en GitHub: naranjos-github.sh (desde Ubuntu)"
}

ORDEN="${1:-ayuda}"; shift || true
case "$ORDEN" in
  instala|install|i)          hace_falta "$@"; $SUDO pacman -S "$@" ;;
  quita|remove|rm)            hace_falta "$@"; $SUDO pacman -Rns "$@" ;;
  local|install-file)         hace_falta "$@"; $SUDO pacman -U "$@" ;;
  actualiza|update|up)        msg "Actualizando NaranjOS…"; $SUDO pacman -Syu "$@" ;;
  busca|search|s)             hace_falta "$@"; pacman -Ss "$@" ;;
  info)                       hace_falta "$@"
                              if pacman -Qq "$1" >/dev/null 2>&1; then pacman -Qi "$@"; else pacman -Si "$@"; fi ;;
  lista|list|ls)              pacman -Q "$@" ;;
  archivos|files)             hace_falta "$@"; pacman -Ql "$@" ;;
  de|owns)                    hace_falta "$@"; pacman -Qo "$@" ;;
  huerfanos|huérfanos|orphans) pacman -Qdt || msg "No hay huérfanos." ;;
  limpia|clean)               H=$(pacman -Qdtq 2>/dev/null || true)
                              if [ -n "$H" ]; then msg "Quitando huérfanos…"; $SUDO pacman -Rns $H; else msg "No hay huérfanos."; fi
                              msg "Vaciando la caché de versiones antiguas…"; $SUDO pacman -Sc ;;
  exprime|build)              exprime "$@" ;;
  version|--version|-V)       echo "${O}zumo${Z} ${VERSION} · NaranjOS"; pacman -V | grep -o 'Pacman v[0-9.]*' | head -n1 ;;
  ayuda|help|-h|--help)       ayuda ;;
  *)                          die "orden desconocida: '$ORDEN'. Mira 'zumo ayuda'." ;;
esac
