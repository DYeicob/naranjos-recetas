# Receta de zumo, el gestor de paquetes de NaranjOS
pkgname=zumo
pkgver=0.2.2
pkgrel=1
pkgdesc='Gestor de paquetes de NaranjOS'
arch=('any')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-3.0-or-later')
depends=('bash' 'pacman' 'sudo')
optdepends=('git: para bajar recetas con git pull')
source=('zumo')
sha256sums=('a5f2de8687a35af6c1e5133d1f0386ed5d0a779c7d7dd7a2cb8129a2b03449ff')

package() {
  install -Dm755 zumo "$pkgdir/usr/bin/zumo"
}
