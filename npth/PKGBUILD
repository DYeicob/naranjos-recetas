# Receta de NaranjOS — generada por naranjos-tanda-6f10.sh
pkgname=npth
pkgver=1.8
pkgrel=1
pkgdesc='Hilos para GnuPG (nPth)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('LGPL-2.1-or-later')
depends=('glibc')
makedepends=()
source=('https://www.gnupg.org/ftp/gcrypt/npth/npth-1.8.tar.bz2')
sha256sums=('8bd24b4f23a3065d6e5b26e98aba9ce783ea4fd781069c1b35d149694e90ca3e')
build() {
  cd npth-$pkgver
  ./configure --prefix=/usr
  make
}
package() {
  cd npth-$pkgver
  make DESTDIR="$pkgdir" install
}
