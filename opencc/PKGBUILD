pkgname=opencc
pkgver=1.4.2
pkgrel=1
pkgdesc='Convertir entre chino simplificado y tradicional'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('Apache-2.0')
depends=()
makedepends=('cmake' 'ninja' 'python')
source=('https://github.com/BYVoid/OpenCC/archive/ver.1.4.2/OpenCC-ver.1.4.2.tar.gz')
sha256sums=('8e5f5cf7fe195bd9b9be851adc9738c1ef7dc5c24441dd5878a56db4087a9a70')
build() { cd OpenCC-ver.$pkgver; cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -Wno-dev -DBUILD_OPENCC_JIEBA_PLUGIN=OFF -DENABLE_GTEST=OFF -DENABLE_BENCHMARK=OFF -DBUILD_DOCUMENTATION=OFF; ninja -C build; }
package() { cd OpenCC-ver.$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
