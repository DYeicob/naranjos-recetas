# Receta de NaranjOS — generada por naranjos-tanda-6o8.sh
pkgname=netavark
pkgver=2.1.0
pkgrel=1
pkgdesc='Red de los contenedores de Podman'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('Apache-2.0')
depends=('nftables')
makedepends=('rust')
source=('https://github.com/containers/netavark/archive/v2.1.0/netavark-2.1.0.tar.gz' 'https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-linux-x86_64.zip')
sha256sums=('96677048168ddd1abe313e4c2e17f1cace72b60ee1bac8ca12a4bd7dfcadfbbb' '121f6c7afe1d4d0e3ea6aab9432038599250134cbf4474cb1167d2c7decd4278')
# protoc (el compilador de protobuf de Google, ya hecho) solo se usa para compilar; no se instala
prepare() {
  cd netavark-$pkgver
  # protoc moderno ya no busca en «.»: se le dice dónde está el .proto
  sed -i 's|&\[Path::new("proto")\]|\&[Path::new("proto"), Path::new(".")]|' build.rs
  export CARGO_HOME="$srcdir/cargo"; cargo fetch --locked
}
build() {
  cd netavark-$pkgver
  chmod +x "$srcdir/bin/protoc"
  export CARGO_HOME="$srcdir/cargo" PROTOC="$srcdir/bin/protoc" PROTOC_INCLUDE="$srcdir/include"
  cargo build --release --frozen
}
package() {
  cd netavark-$pkgver
  install -Dm755 target/release/netavark "$pkgdir/usr/libexec/podman/netavark"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/netavark/LICENSE"
}
