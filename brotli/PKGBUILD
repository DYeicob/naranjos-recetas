# Receta de NaranjOS — generada por naranjos-tanda-5a5.sh a partir de BLFS 13.1-systemd
pkgname=brotli
pkgver=1.2.0
pkgrel=1
pkgdesc='Compresión Brotli'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('MIT')
depends=()
makedepends=('cmake')
source=('https://github.com/google/brotli/archive/v1.2.0/brotli-1.2.0.tar.gz')
sha256sums=('816c96e8e8f193b40151dad7e8ff37b1221d019dbcb9c35cd3fadbfe6477dfec')
build()   { cd brotli-$pkgver; cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -G Ninja; ninja -C build; }
package() { cd brotli-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
