# Receta de NaranjOS — generada por naranjos-tanda-5c2.sh
pkgname=fmt
pkgver=12.2.0
pkgrel=1
pkgdesc='Formateo de texto para C++'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('custom')
depends=()
makedepends=('cmake')
source=('https://github.com/fmtlib/fmt/archive/12.2.0/fmt-12.2.0.tar.gz')
sha256sums=('8b852bb5aa6e7d8564f9e81394055395dd1d1936d38dfd3a17792a02bebd7af0')
build()   { cd fmt-$pkgver; cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -W no-dev -G Ninja -D CMAKE_INSTALL_LIBDIR=/usr/lib -D BUILD_SHARED_LIBS=ON -D FMT_TEST=OFF; ninja -C build; }
package() { cd fmt-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
