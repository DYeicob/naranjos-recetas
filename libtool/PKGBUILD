check()   { cd libtool-$pkgver; make check || echo "libtool: alguna prueba falló"; }
package() {
  cd libtool-$pkgver
  make DESTDIR="$pkgdir" install
  rm -f "$pkgdir/usr/lib/libltdl.a"
}
