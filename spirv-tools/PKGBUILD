pkgname=spirv-tools
pkgver=1.4.357.0
pkgrel=1
pkgdesc='Herramientas de SPIR-V (Khronos)'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('Apache-2.0')
depends=()
makedepends=('cmake' 'spirv-headers')
source=('https://github.com/KhronosGroup/SPIRV-Tools/archive/vulkan-sdk-1.4.357.0/SPIRV-Tools-vulkan-sdk-1.4.357.0.tar.gz')
sha256sums=('d31e7109b6ef3559067e53e520870eafed7c9534d00db9728814b6df03fa4a5e')
build()   { cd SPIRV-Tools-vulkan-sdk-$pkgver
  cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -D SPIRV_WERROR=OFF \
        -D BUILD_SHARED_LIBS=ON -D SPIRV_TOOLS_BUILD_STATIC=OFF -D SPIRV-Headers_SOURCE_DIR=/usr -G Ninja
  ninja -C build; }
package() { cd SPIRV-Tools-vulkan-sdk-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
