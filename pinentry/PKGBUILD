pkgname=pinentry
pkgver=1.3.3
pkgrel=1
pkgdesc='Pide la contraseña de tus claves GnuPG'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-or-later')
depends=('libassuan' 'libgpg-error' 'ncurses')
makedepends=()
source=('https://www.gnupg.org/ftp/gcrypt/pinentry/pinentry-1.3.3.tar.bz2')
sha256sums=('c2970f16d6afb66ecddfca767d743936c86239bff936eed7fd7597a678414b63')
build() {
  cd pinentry-$pkgver
  ./configure --prefix=/usr --enable-pinentry-tty
  make
}
package() {
  cd pinentry-$pkgver
  make DESTDIR="$pkgdir" install
}
