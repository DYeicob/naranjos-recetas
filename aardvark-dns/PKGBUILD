# Receta de NaranjOS — generada por naranjos-tanda-6o8.sh
pkgname=aardvark-dns
pkgver=2.1.0
pkgrel=1
pkgdesc='DNS entre contenedores de Podman'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('Apache-2.0')
depends=()
makedepends=('rust')
source=('https://github.com/containers/aardvark-dns/archive/v2.1.0/aardvark-dns-2.1.0.tar.gz')
sha256sums=('daf871488603e659b0501224cf0731ac317809b1d1701fc061cb4f6ae39a894f')
prepare() { cd aardvark-dns-$pkgver; export CARGO_HOME="$srcdir/cargo"; cargo fetch --locked; }
build() { cd aardvark-dns-$pkgver; export CARGO_HOME="$srcdir/cargo"; cargo build --release --frozen; }
package() {
  cd aardvark-dns-$pkgver
  install -Dm755 target/release/aardvark-dns "$pkgdir/usr/libexec/podman/aardvark-dns"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/aardvark-dns/LICENSE"
}
