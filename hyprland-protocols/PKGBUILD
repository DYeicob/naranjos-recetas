pkgrel=1
pkgdesc='Protocolos Wayland de Hyprland'
arch=('any')
url='https://www.linuxfromscratch.org/blfs/'
license=('custom')
depends=()
makedepends=('cmake' )
source=('https://github.com/hyprwm/hyprland-protocols/archive/v0.8.0/hyprland-protocols-0.8.0.tar.gz')
