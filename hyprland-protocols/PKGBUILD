build()   { cd hyprland-protocols-$pkgver; cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -W no-dev -G Ninja; ninja -C build; }
package() { cd hyprland-protocols-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
