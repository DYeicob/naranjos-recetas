pkgname=fuzzel
pkgver=1.15.0
pkgrel=1
pkgdesc='Lanzador de aplicaciones y menús'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('MIT')
depends=('cairo' 'fcft' 'fontconfig' 'libpng' 'libxkbcommon' 'pixman' 'wayland')
makedepends=('scdoc' 'tllist' 'wayland-protocols')
source=('https://codeberg.org/dnkl/fuzzel/archive/1.15.0.tar.gz')
sha256sums=('95b6c022fc1f1c7ab586d47c1594417cc311bf41ea8f5f8b5641478da7b5cf3b')
build()   { cd fuzzel
  meson setup build --prefix=/usr --buildtype=plain -D enable-cairo=enabled -D png-backend=libpng -D svg-backend=nanosvg
  meson compile -C build; }
package() { cd fuzzel; DESTDIR="$pkgdir" meson install -C build; }
