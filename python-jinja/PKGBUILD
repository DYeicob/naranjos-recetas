pkgname=python-jinja
pkgver=3.1.6
pkgrel=1
pkgdesc='Plantillas Jinja2 (las usa systemd al compilar)'
arch=('any')
url='https://github.com/DYeicob/naranjos-recetas'
license=('BSD-3-Clause')
depends=('python' 'python-markupsafe')
makedepends=()
source=('https://pypi.org/packages/source/J/Jinja2/jinja2-3.1.6.tar.gz')
sha256sums=('0137fb05990d35f1275a587e9aee6d56da821fc83491a0fb838183be43f66d6d')
build() {
  cd jinja2-3.1.6
  pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}
package() {
  cd jinja2-3.1.6
  pip3 install --root="$pkgdir" --prefix=/usr --no-index --find-links dist --no-deps --no-warn-script-location                --ignore-installed Jinja2
}
