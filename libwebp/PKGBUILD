# Receta de NaranjOS — generada por naranjos-tanda-5a4.sh a partir de BLFS 13.1-systemd
pkgname=libwebp
pkgver=1.6.0
pkgrel=1
pkgdesc='Imágenes WebP'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('BSD-3-Clause')
depends=('libjpeg-turbo' 'libpng')
makedepends=()
source=('https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz')
sha256sums=('e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564')
build()   { cd libwebp-$pkgver
  ./configure --prefix=/usr --enable-libwebpmux --enable-libwebpdemux --enable-libwebpdecoder \
              --enable-libwebpextras --enable-swap-16bit-csp --disable-static
  make; }
package() { cd libwebp-$pkgver; make DESTDIR="$pkgdir" install; }
