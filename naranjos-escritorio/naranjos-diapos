#!/usr/bin/python3
# naranjos-diapos — presentaciones de NaranjOS desde un solo Markdown
#   naranjos-diapos charla.md          crea charla.html (una sola página, con los colores del tema) y la abre
#   naranjos-diapos nueva charla.md    crea un Markdown de ejemplo
# Separa las diapositivas con una línea «---». Flechas o espacio para pasar; F pantalla completa;
# para PDF: imprime la página desde el navegador (Ctrl + P → Guardar como PDF), una diapositiva por hoja.
import html, os, re, subprocess, sys

EJEMPLO = """# Mi charla
Con **NaranjOS**

---

## Puntos
- Uno
- Dos con `código`
- [Un enlace](https://github.com/DYeicob/naranjos-recetas)

---

## Imagen
![logo](/usr/share/naranjos/logo/naranjos-logo-plano-48.png)
"""

def colores():
    c = {"fondo": "121212", "texto": "e8e8e8", "acento": "ff8700"}
    f = os.path.expanduser("~/.config/naranjos/tema/colores")
    try:
        for l in open(f):
            m = re.match(r'COLOR_(FONDO|TEXTO|ACENTO)="?#?([0-9a-fA-F]{6})', l)
            if m: c[m.group(1).lower()] = m.group(2)
    except OSError: pass
    return c

def linea(t):
    t = html.escape(t)
    t = re.sub(r"!\[([^\]]*)\]\(([^)]+)\)", r'<img alt="\1" src="\2">', t)
    t = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', t)
    t = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", t)
    t = re.sub(r"\*([^*]+)\*", r"<i>\1</i>", t)
    t = re.sub(r"`([^`]+)`", r"<code>\1</code>", t)
    return t

def diapo(md):
    out, lista, codigo = [], False, False
    for l in md.splitlines():
        if l.startswith("```"):
            out.append("</pre>" if codigo else "<pre>"); codigo = not codigo; continue
        if codigo: out.append(html.escape(l)); continue
        m = re.match(r"(#{1,3})\s+(.*)", l)
        if re.match(r"\s*[-*]\s+", l):
            if not lista: out.append("<ul>"); lista = True
            out.append("<li>%s</li>" % linea(re.sub(r"^\s*[-*]\s+", "", l))); continue
        if lista: out.append("</ul>"); lista = False
        if m: out.append("<h%d>%s</h%d>" % (len(m.group(1)), linea(m.group(2)), len(m.group(1))))
        elif l.strip(): out.append("<p>%s</p>" % linea(l))
    if lista: out.append("</ul>")
    return "\n".join(out)

def construye(src):
    md = open(src, encoding="utf-8").read()
    partes = [p for p in re.split(r"(?m)^---\s*$", md) if p.strip()]
    c = colores()
    secciones = "\n".join('<section class="d">%s</section>' % diapo(p) for p in partes)
    titulo = html.escape(os.path.splitext(os.path.basename(src))[0])
    return f"""<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><title>{titulo}</title><style>
html,body{{margin:0;background:#{c['fondo']};color:#{c['texto']};font-family:"JetBrains Mono","DejaVu Sans",sans-serif}}
.d{{display:none;box-sizing:border-box;width:100vw;height:100vh;padding:7vh 9vw;flex-direction:column;justify-content:center;font-size:3.2vh}}
.d.on{{display:flex}} h1{{font-size:8vh;color:#{c['acento']};margin:0 0 3vh}} h2{{font-size:6vh;color:#{c['acento']};margin:0 0 3vh}}
h3{{color:#{c['acento']}}} a{{color:#{c['acento']}}} code,pre{{background:#0006;border-radius:8px;padding:.2em .4em}} pre{{padding:1em;overflow:auto}}
img{{max-width:80%;max-height:55vh;align-self:center}} li{{margin:.6em 0}} li::marker{{color:#{c['acento']}}}
#n{{position:fixed;right:2vw;bottom:2vh;opacity:.6;font-size:2vh}}
@media print{{@page{{size:landscape;margin:0}} .d{{display:flex!important;page-break-after:always}} #n{{display:none}}}}
</style></head><body>{secciones}<div id="n"></div><script>
let i=0;const d=document.querySelectorAll('.d');const n=document.getElementById('n');
function v(k){{i=Math.max(0,Math.min(d.length-1,k));d.forEach((e,j)=>e.classList.toggle('on',j==i));n.textContent=(i+1)+' / '+d.length;location.hash=i+1}}
document.addEventListener('keydown',e=>{{if(['ArrowRight',' ','PageDown','l'].includes(e.key))v(i+1);if(['ArrowLeft','PageUp','h'].includes(e.key))v(i-1);
if(e.key=='f')document.documentElement.requestFullscreen()}});document.addEventListener('click',()=>v(i+1));v((parseInt(location.hash.slice(1))||1)-1);
</script></body></html>"""

def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "ayuda"):
        print(open(__file__).read().split("\nimport", 1)[0].replace("# ", "").replace("#!/usr/bin/python3\n", "")); return 1
    if a[0] == "nueva":
        dst = a[1] if len(a) > 1 else "presentacion.md"
        if os.path.exists(dst): print("Ya existe:", dst); return 1
        open(dst, "w", encoding="utf-8").write(EJEMPLO); print("✔", dst); return 0
    src = a[0]
    out = os.path.splitext(src)[0] + ".html"
    open(out, "w", encoding="utf-8").write(construye(src))
    print("✔", out)
    subprocess.Popen(["xdg-open", out], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0

sys.exit(main())
