post_install() {
  echo "  NaranjOS: escritorio instalado. Cada usuario recibe su configuración al iniciar sesión"
  echo "            (o ya mismo con: naranjos-config-usuario). Manual: naranjos-ayuda"
}
post_upgrade() {
  # que las sesiones de Hyprland abiertas relean la configuración ya actualizada
  local d uid sig u
  for d in /run/user/*/hypr/*/; do
    [ -S "$d.socket.sock" ] || continue
    uid=$(stat -c %u "$d"); sig=$(basename "$d"); u=$(id -nu "$uid" 2>/dev/null) || continue
    runuser -u "$u" -- env XDG_RUNTIME_DIR="/run/user/$uid" HYPRLAND_INSTANCE_SIGNATURE="$sig" \
      hyprctl reload >/dev/null 2>&1 && echo "  NaranjOS: escritorio de $u recargado"
  done
  return 0
}
