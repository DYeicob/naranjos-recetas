# textos traducibles (dominio «naranjos»); si aún no está naranjos-idiomas, en español
. /usr/lib/naranjos/naranjos-i18n.sh 2>/dev/null || _(){ printf '%s' "$1"; }
post_install() {
  echo "  $(_ 'NaranjOS: escritorio instalado. Cada usuario recibe su configuración al iniciar sesión')"
  echo "            $(_ '(o ya mismo con: naranjos-config-usuario). Manual: naranjos-ayuda')"
}
post_upgrade() {
  # que las sesiones de Hyprland abiertas relean la configuración ya actualizada
  local d uid sig u
  for d in /run/user/*/hypr/*/; do
    [ -S "$d.socket.sock" ] || continue
    uid=$(stat -c %u "$d"); sig=$(basename "$d"); u=$(id -nu "$uid" 2>/dev/null) || continue
    # nuevos ficheros de configuración del usuario (sin pisar lo que haya cambiado)
    sudo -u "$u" -H naranjos-config-usuario >/dev/null 2>&1 || true
    # sus carpetas personales (Descargas, Documentos…) en su idioma
    sudo -u "$u" -H sh -c '. /etc/locale.conf; [ -r "$HOME/.config/locale.conf" ] && . "$HOME/.config/locale.conf"; export LANG LANGUAGE; naranjos-carpetas' >/dev/null 2>&1 || true
    if sudo -u "$u" env XDG_RUNTIME_DIR="/run/user/$uid" HYPRLAND_INSTANCE_SIGNATURE="$sig" \
         hyprctl reload >/dev/null 2>&1; then
      printf '  %s\n' "$(printf "$(_ 'NaranjOS: escritorio de %s recargado')" "$u")"
    else
      printf '  %s\n' "$(printf "$(_ 'NaranjOS: no pude recargar el escritorio de %s; hazlo tú con Super + Shift + R')" "$u")"
    fi
  done
  return 0
}
