#!/bin/bash
# naranjos-sistema — menú de bloquear / cerrar sesión / suspender / reiniciar / apagar (Super + Escape)
op=$(printf '%s\n' \
  $'  Bloquear' $'  Cerrar sesión' $'  Suspender' $'  Reiniciar' $'  Apagar' |
  fuzzel --dmenu --prompt "NaranjOS ❯ " --lines 5 --width 24) || exit 0
energia(){ systemctl "$1" 2>/dev/null || sudo -n /usr/bin/systemctl "$1"; }
case "$op" in
  *Bloquear)  pidof hyprlock || hyprlock ;;
  *sesión)    hyprctl dispatch 'hl.dsp.exit()' ;;
  *Suspender) energia suspend ;;
  *Reiniciar) energia reboot ;;
  *Apagar)    energia poweroff ;;
esac
