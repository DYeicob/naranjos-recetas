}

SECCIONES=(aplicaciones utilidades aspecto ajustes seguridad sistema capturas ayuda energia)
titulo(){
  case "$1" in
    aplicaciones) echo "󰀻  $(_ 'Aplicaciones')" ;; utilidades) echo "󰠱  $(_ 'Utilidades')" ;; aspecto) echo "󰏘  $(_ 'Aspecto')" ;;
    ajustes) echo "  $(_ 'Ajustes')" ;; seguridad) echo "󰒃  $(_ 'Seguridad')" ;;
    sistema) echo "  $(_ 'Sistema')" ;; capturas) echo "󰄀  $(_ 'Capturas')" ;;
    ayuda) echo "󰋖  $(_ 'Ayuda')" ;; energia) echo "  $(_ 'Energía')" ;;
  esac
}

naranjos-tema-nuevo(){
  local n c
  n=$(fuzzel --dmenu --prompt "$(_ 'Nombre del tema') ❯ " --lines 0 --width 40 < /dev/null) || exit 0
  c=$(printf '%s\n' "ff8700 $(_ 'naranja')" "8a2be2 $(_ 'violeta')" "00bfa5 $(_ 'turquesa')" "e91e63 $(_ 'frambuesa')" "607d8b $(_ 'pizarra')" |
      fuzzel --dmenu --prompt "$(_ 'Color (o escribe uno, p. ej. 3d9bff)') ❯ " --lines 5 --width 50) || exit 0
  naranjos-tema crea "$n" "${c%% *}" >/dev/null 2>&1 || naranjos-notifica "$(_ 'No pude crear el tema')"
}
elige(){ # elige <prompt> [volver] → ejecuta la acción elegida; con «volver», Esc vuelve al menú principal
  local i
  if ! i=$(printf '%s\n' "${ETIQ[@]}" | fuzzel --dmenu --index --prompt "$1 ❯ " --width 46 --lines 14); then
    [ "${2:-}" = volver ] && exec "$0"
    exit 0
  fi
  [[ "$i" =~ ^[0-9]+$ ]] && [ "$i" -lt ${#ACC[@]} ] || exit 0
  eval "${ACC[$i]}"
}

menu_seccion(){
  local s="$1" n a
  ETIQ=(); ACC=()                       # solo lo de la sección (y, arriba, volver)
  mete "󰁍  $(_ 'Volver')" "exec \"\$0\""
  if [ "$s" = aplicaciones ]; then
    while IFS=$'\t' read -r n a; do mete "   $n" "setsid -f gio launch \"$a\" >/dev/null 2>&1"; done < <(aplicaciones)
  else
    "seccion_$s"
  fi
  elige "$(titulo "$s" | sed 's/^[^ ]* *//')" volver
}

principal(){
  local s n a pref
  for s in "${SECCIONES[@]}"; do mete "$(titulo "$s")  ›" "menu_seccion $s"; done
  # todo lo demás, para encontrarlo escribiendo
  for s in utilidades aspecto ajustes seguridad sistema capturas ayuda energia; do
    pref=$(titulo "$s" | sed 's/^[^ ]* *//')
    local antes=${#ETIQ[@]}
    "seccion_$s"
    for ((n = antes; n < ${#ETIQ[@]}; n++)); do ETIQ[n]="${ETIQ[n]}   · $pref"; done
  done
  while IFS=$'\t' read -r n a; do mete "   $n" "setsid -f gio launch \"$a\" >/dev/null 2>&1"; done < <(aplicaciones)
  elige "NaranjOS"
}

case "${1:-}" in
  "")  principal ;;
  aplicaciones|utilidades|aspecto|ajustes|seguridad|sistema|capturas|ayuda|energia) menu_seccion "$1" ;;
  lista) principal() { :; }; for s in "${SECCIONES[@]}"; do [ "$s" = aplicaciones ] || "seccion_$s"; done; printf '%s\n' "${ETIQ[@]}"; aplicaciones | cut -f1 ;;
  *) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
