#!/bin/bash
# naranjos-menu — el menú de NaranjOS (Super + Espacio) (fase 6k2)
#   Arriba, las secciones; debajo, TODO lo demás (aplicaciones y cada opción de cada sección),
#   así que basta con empezar a escribir: «lima», «wifi», «firefox», «apagar»…
#   naranjos-menu [aplicaciones|aspecto|ajustes|seguridad|sistema|capturas|ayuda|energia]
set -uo pipefail
if [ -r /usr/lib/naranjos/naranjos-i18n.sh ]; then . /usr/lib/naranjos/naranjos-i18n.sh; else _(){ printf '%s' "$1"; }; fi

ETIQ=(); ACC=()
mete(){ ETIQ+=("$1"); ACC+=("$2"); }

# en una terminal flotante, esperando una tecla al final
terminal(){ # terminal <título> <orden de bash>
  setsid -f foot --app-id=naranjos-tui -T "$1" bash -c "$2"'; echo; read -rsn1 -p "$0"' "$(_ 'Pulsa una tecla para cerrar…')" >/dev/null 2>&1
}
energia(){ systemctl "$1" 2>/dev/null || sudo -n /usr/bin/systemctl "$1"; }

# --- aplicaciones (.desktop visibles), «nombre<TAB>fichero» ordenado ---------------------------------
aplicaciones(){
  local d dirs=() ids=() idioma=${LANG:-es_ES.UTF-8}; idioma=${idioma%%.*}; idioma=${idioma%%_*}
  IFS=: read -ra dirs <<< "${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for d in "${dirs[@]}"; do
    [ -d "$d/applications" ] && ids+=("$d/applications")
  done
  [ ${#ids[@]} -gt 0 ] || return 0
  # (en el orden de XDG: lo del usuario manda sobre lo del sistema)
  find "${ids[@]}" -maxdepth 2 -name '*.desktop' -print0 2>/dev/null | xargs -r -0 awk -v L="$idioma" '
    function suelta() { id = previo; sub(".*/", "", id); if (previo != "" && app && ok && !(id in visto)) { visto[id] = 1; printf "%s\t%s\n", (nl != "" ? nl : n), previo } }
    FNR == 1 { suelta(); previo = FILENAME; sec = 0; n = ""; nl = ""; ok = 1; app = 0 }
    /^\[/ { sec = ($0 == "[Desktop Entry]"); next }
    !sec { next }
    /^Type=/ { app = ($0 == "Type=Application") }
    /^NoDisplay=true/ || /^Hidden=true/ { ok = 0 }
    /^Name=/ { n = substr($0, 6) }
    index($0, "Name[" L "]=") == 1 { nl = substr($0, index($0, "=") + 1) }
    END { suelta() }
  ' | sort -f -t$'\t' -k1,1
}

seccion_aspecto(){
  local t n a
  a=$(naranjos-tema actual 2>/dev/null || echo naranja)
  for t in naranja sanguina lima pomelo limon brisa; do
    n=$(sed -n 's/^NOMBRE=//p' "/usr/share/naranjos/temas/$t/colores" 2>/dev/null | tr -d '"')
    [ -n "$n" ] || continue
    if [ "$t" = "$a" ]; then mete "●  $(_ 'Tema'): $n" "naranjos-tema pon $t"
    else mete "󰏘  $(_ 'Tema'): $n" "naranjos-tema pon $t"; fi
  done
  mete "󰔎  $(_ 'Modo claro / oscuro')"            "naranjos-tema modo"
  mete "󰸉  $(_ 'Siguiente fondo')"                 "naranjos-tema fondo siguiente"
  mete "󰏘  $(_ 'Crear mi tema…')"                 "naranjos-tema-nuevo"
  mete "󰉼  $(_ 'Apariencia (todo)')…"             "naranjos-apariencia menu"
  mete "󱂬  $(_ 'Dock: mostrar / ocultar')"        "naranjos-dock alterna"
  mete "󰐃  $(_ 'Dock: fijar una app')"           "naranjos-dock fija"
  mete "󰐄  $(_ 'Dock: quitar una app')"          "naranjos-dock quita"
  mete "󰖯  $(_ 'Barras de título: sí / no')"     "naranjos-barras alterna"
  mete "󰕧  $(_ 'Fondo en movimiento: sí / no')"  "naranjos-fondo-video alterna"
  mete "󰕧  $(_ 'Animación al cambiar de tema: sí / no')"  "naranjos-fondo-video intro alterna"
  mete "中  $(_ 'Escritura: chino, japonés, coreano')"  "naranjos-escritura menu"
  mete "󰌾  $(_ 'Contraseñas (KeePassXC)')"       "naranjos-contrasenas"
  mete "󰓦  $(_ 'Sincronizar carpetas (Syncthing)')"  "naranjos-sincroniza abre"
  mete "󰕴  $(_ 'Modo escritorio (flotante + dock)')" "naranjos-disposicion escritorio activa"
  mete "󰕴  $(_ 'Modo mosaico')"                   "naranjos-disposicion escritorio apaga"
  mete "󰖔  $(_ 'Luz nocturna')…"                  "naranjos-noche menu"
  mete "󰍜  $(_ 'Mostrar / ocultar la barra')"     "pkill -SIGUSR1 -x waybar || setsid -f waybar"
  mete "󰍹  $(_ 'Pantalla, texto y barra')…"       "naranjos-pantalla menu"
  mete "󰨮  $(_ 'Temas en VS Code')"               "terminal \"VS Code\" 'naranjos-tema vscode'"
  mete "󰦛  $(_ 'Restablecer una configuración')…" "naranjos-restablece menu"
}
