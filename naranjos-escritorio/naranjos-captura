#!/bin/bash
# naranjos-captura [region|pantalla] — guarda en la carpeta de imágenes y copia al portapapeles
set -u
. /usr/lib/naranjos/naranjos-i18n.sh
img=$(naranjos_carpeta PICTURES)
[ "$img" != "$HOME" ] || img="$HOME/$(_ 'Imágenes')"
dir="$img/$(_ 'Capturas')"; mkdir -p "$dir"
f="$dir/$(_ 'captura')-$(date +%Y%m%d-%H%M%S).png"
case "${1:-region}" in
  region)   g=$(slurp -b 12121288 -c ff8700ff -w 2) || exit 0; grim -g "$g" "$f" ;;
  pantalla) grim "$f" ;;
  *) echo "$(_ 'Uso:') naranjos-captura [region|pantalla]"; exit 1 ;;
esac
wl-copy --type image/png < "$f"
naranjos-notifica "$(_ 'Captura guardada')" "${f/#$HOME/\~} · $(_ 'también está en el portapapeles')"
