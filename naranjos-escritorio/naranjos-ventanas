#!/usr/bin/env python3
# naranjos-ventanas — NaranjOS recuerda en qué escritorio dejaste cada aplicación y la vuelve a abrir allí
#   naranjos-ventanas vigila     (lo arranca Hyprland al entrar)
#   naranjos-ventanas lista      lo que recuerda
#   naranjos-ventanas olvida     borra lo recordado
# Las reglas salen en ~/.config/naranjos/ventanas.lua (lo carga la configuración de Hyprland).
import json, os, re, socket, subprocess, sys, pathlib

CONF = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "naranjos"
REGLAS = CONF / "ventanas.lua"
DATOS = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "naranjos" / "ventanas.json"
NUNCA = {"naranjos-tui", "foot", "fuzzel", "hyprland-share-picker", ""}   # las que van donde estés

def carga():
    try: return json.loads(DATOS.read_text())
    except Exception: return {}

def guarda(d):
    DATOS.parent.mkdir(parents=True, exist_ok=True); DATOS.write_text(json.dumps(d, indent=1, ensure_ascii=False))
    CONF.mkdir(parents=True, exist_ok=True)
    l = ["-- NaranjOS · naranjos-ventanas: cada aplicación vuelve a su escritorio (no lo edites)"]
    for i, (c, ws) in enumerate(sorted(d.items())):
        l.append('hl.window_rule({ name = "naranjos-ventana-%d", match = { class = "^%s$" }, workspace = "%s silent" })'
                 % (i, re.escape(c).replace(chr(92), chr(92) * 2).replace('"', ''), ws))
    REGLAS.write_text("\n".join(l) + "\n")

def vigila():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig: sys.exit("Hyprland no está en marcha")
    s = socket.socket(socket.AF_UNIX); s.connect(f"{os.environ['XDG_RUNTIME_DIR']}/hypr/{sig}/.socket2.sock")
    vent, d, buf = {}, carga(), b""
    if not REGLAS.exists(): guarda(d)
    # las ventanas que ya están abiertas
    try:
        for c in json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout):
            vent[c["address"].removeprefix("0x")] = [c["class"], str(c["workspace"]["name"])]
    except Exception: pass
    while True:
        r = s.recv(4096)
        if not r: break
        buf += r
        while b"\n" in buf:
            linea, buf = buf.split(b"\n", 1)
            ev, _, dat = linea.decode(errors="replace").partition(">>")
            if ev == "openwindow":
                a, ws, cl = (dat.split(",", 3) + ["", "", ""])[:3]
                vent[a] = [cl, ws]
            elif ev == "movewindowv2":
                a, _, ws = (dat.split(",", 2) + ["", ""])[:3]
                if a in vent: vent[a][1] = ws
            elif ev == "closewindow":
                cl, ws = vent.pop(dat, ["", ""])
                if cl in NUNCA or ws.startswith("special") or not ws: continue
                if d.get(cl) != ws:
                    d[cl] = ws; guarda(d)
                    subprocess.run(["hyprctl", "reload"], capture_output=True)

a = sys.argv[1] if len(sys.argv) > 1 else "lista"
if a == "vigila": vigila()
elif a == "olvida": guarda({}); print("✔")
else:
    for c, ws in sorted(carga().items()): print(f"  {c:30} → {ws}")
