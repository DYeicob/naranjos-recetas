#!/bin/bash
# naranjos-notifica [--urgente] <título> [texto] — aviso de escritorio sin dependencias (D-Bus directo)
#   --urgente: no se va solo (borde rojo); hay que cerrarlo con un clic. Para amenazas y fallos graves.
urg=1; tiempo=5000
if [ "${1:-}" = "--urgente" ]; then urg=2; tiempo=0; shift; fi
busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
  org.freedesktop.Notifications Notify susssasa{sv}i \
  "NaranjOS" 0 "" "${1:-NaranjOS}" "${2:-}" 0 1 urgency y "$urg" "$tiempo" >/dev/null 2>&1 || true
