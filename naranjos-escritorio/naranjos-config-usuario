#!/bin/bash
# naranjos-config-usuario — copia a tu carpeta la configuración de NaranjOS que te falte.
# Nunca pisa tus ficheros (salvo el hyprland.lua AUTOGENERADO por Hyprland, que se guarda como copia).
#   --forzar   vuelve a poner TODA la configuración de NaranjOS (guarda copia .anterior de lo tuyo)
set -u
S=/etc/skel
forzar=0; [ "${1:-}" = "--forzar" ] && forzar=1
for f in .config/hypr/hyprland.lua .config/hypr/hyprpaper.conf .config/hypr/hyprlock.conf \
         .config/hypr/hypridle.conf .config/mako/config .config/fuzzel/fuzzel.ini \
         .config/foot/foot.ini .config/waybar/config.jsonc .config/waybar/style.css \
         .config/gtk-3.0/settings.ini .zshrc; do
  [ -f "$S/$f" ] || continue
  d="$HOME/$f"
  if [ -f "$d" ] && [ "$f" = .config/hypr/hyprland.lua ] && grep -q 'autogenerated' "$d" && ! grep -q 'naranjos' "$d"; then
    mv -f "$d" "$d.hyprland-original"
  fi
  if [ "$forzar" = 1 ] && [ -f "$d" ]; then mv -f "$d" "$d.anterior"; fi
  if [ ! -e "$d" ]; then mkdir -p "$(dirname "$d")"; cp "$S/$f" "$d"; fi
done
