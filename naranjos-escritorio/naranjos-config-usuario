#!/bin/bash
# naranjos-config-usuario — copia a tu carpeta la configuración de NaranjOS que te falte.
# Nunca pisa tus ficheros (salvo el hyprland.lua AUTOGENERADO por Hyprland, que se guarda como copia).
#   --forzar   vuelve a poner TODA la configuración de NaranjOS (guarda copia .anterior de lo tuyo)
set -u
S=/etc/skel
forzar=0; [ "${1:-}" = "--forzar" ] && forzar=1
for f in .config/hypr/hyprland.lua .config/hypr/hyprpaper.conf .config/hypr/hyprlock.conf \
         .config/hypr/hypridle.conf .config/mako/config .config/fuzzel/fuzzel.ini \
         .config/foot/foot.ini .config/waybar/config.jsonc .config/waybar/style.css \
         .config/gtk-3.0/settings.ini .config/gtk-3.0/gtk.css .zshrc \
         .config/nvim/init.lua .config/btop/btop.conf; do
  [ -f "$S/$f" ] || continue
  d="$HOME/$f"
  if [ -f "$d" ] && [ "$f" = .config/hypr/hyprland.lua ] && grep -q 'autogenerated' "$d" && ! grep -q 'naranjos' "$d"; then
    mv -f "$d" "$d.hyprland-original"
  fi
  if [ "$forzar" = 1 ] && [ -f "$d" ]; then mv -f "$d" "$d.anterior"; fi
  # versión antigua sin cambios del usuario → se cambia por la nueva
  if [ -f "$d" ] && ! cmp -s "$d" "$S/$f" && \
     grep -qx "$(sha256sum < "$d" | cut -d" " -f1)  $f" /usr/share/naranjos/versiones-antiguas.sha256 2>/dev/null; then
    cp "$S/$f" "$d"
  fi
  if [ ! -e "$d" ]; then mkdir -p "$(dirname "$d")"; cp "$S/$f" "$d"; fi
done
# tema cítrico: si aún no hay ninguno, el de NaranjOS (Naranja)
if [ ! -e "$HOME/.config/naranjos/tema" ] && command -v naranjos-tema >/dev/null 2>&1; then
  naranjos-tema pon naranja --sin-recargar >/dev/null 2>&1 || true
fi
# iconos del tema (6k3b): si el tema ya estaba puesto de antes, se vuelve a poner para que coja los iconos
if command -v naranjos-tema >/dev/null 2>&1 && [ -e "$HOME/.config/naranjos/tema" ] && \
   ! grep -q '^gtk-icon-theme-name=NaranjOS-iconos-' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null; then
  naranjos-tema pon "$(naranjos-tema actual)" --sin-recargar >/dev/null 2>&1 || true
fi
# GSettings (6k3c): GTK en Wayland lee iconos, cursor y modo oscuro de aquí (vía el portal), no de settings.ini
if command -v naranjos-tema >/dev/null 2>&1 && command -v gsettings >/dev/null 2>&1 && \
   [ -e /usr/lib/gio/modules/libdconfsettings.so ] && [ -e "$HOME/.config/naranjos/tema" ] && \
   ! gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | grep -q 'NaranjOS-iconos-'; then
  naranjos-tema pon "$(naranjos-tema actual)" >/dev/null 2>&1 || true
fi
# Thunar como en NaranjOS, una sola vez (lo que ya tuviera guardado Thunar no pisa esto después)
M="$HOME/.config/naranjos/.thunar-6k3b"
if [ ! -e "$M" ] && command -v xfconf-query >/dev/null 2>&1; then
  for p in "last-menubar-visible bool false" "last-statusbar-visible bool false" \
           "last-icon-view-zoom-level string THUNAR_ZOOM_LEVEL_75_PERCENT" "shortcuts-icon-size string THUNAR_ICON_SIZE_24" \
           "misc-symbolic-icons-in-toolbar bool true" "misc-small-toolbar-icons bool true"; do
    set -- $p
    xfconf-query -c thunar -p "/$1" -n -t "$2" -s "$3" >/dev/null 2>&1 || xfconf-query -c thunar -p "/$1" -s "$3" >/dev/null 2>&1 || true
  done
  mkdir -p "${M%/*}"; touch "$M"
fi
# (6o) ficheros de naranjos-pantalla (la barra, la terminal y el lanzador los incluyen), complementos y btop
command -v naranjos-pantalla >/dev/null 2>&1 && naranjos-pantalla prepara >/dev/null 2>&1
mkdir -p "$HOME/.config/naranjos"; [ -e "$HOME/.config/naranjos/complementos.lua" ] || : > "$HOME/.config/naranjos/complementos.lua"
[ -e "$HOME/.config/btop/themes/naranjos.theme" ] || { mkdir -p "$HOME/.config/btop/themes"; ln -sfn "$HOME/.config/naranjos/tema/btop.theme" "$HOME/.config/btop/themes/naranjos.theme"; }
exit 0
