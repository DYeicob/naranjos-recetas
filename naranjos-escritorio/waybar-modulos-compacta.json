{
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": {
      "default": "󰐊"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "max-length": 32,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip-format": "{artist} · {title}"
  },
  "hyprland/window": {
    "max-length": 48,
    "separate-outputs": true,
    "format": ""
  },
  "custom/naranjos": {
    "format": "",
    "tooltip": false,
    "on-click": "naranjos-menu"
  },
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "  ✕",
    "format-icons": [
      "",
      "",
      ""
    ],
    "scroll-step": 5,
    "max-volume": 100,
    "tooltip-format": "{node_name} · {volume}%",
    "on-click": "naranjos-tui sonido",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "bluetooth": {
    "format": "",
    "format-off": "  ✕",
    "format-disabled": "",
    "format-no-controller": "",
    "format-connected": "",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "naranjos-tui bluetooth"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "  ✕",
    "tooltip-format": "{ifname} · {ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}",
    "on-click": "naranjos-tui wifi"
  },
  "backlight": {
    "format": "",
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
    "tooltip-format": "{percent}%"
  },
  "battery": {
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon}",
    "format-charging": "",
    "format-plugged": "",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{capacity}% · {timeTo}"
  },
  "cpu": {
    "format": "",
    "interval": 5,
    "tooltip-format": "CPU {usage}%"
  },
  "memory": {
    "format": "",
    "interval": 10,
    "tooltip-format": "{percentage}% · {used:0.1f} / {total:0.1f} GiB"
  }
}
