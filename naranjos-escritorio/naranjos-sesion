#!/bin/sh
# naranjos-sesion — arranca el escritorio NaranjOS con el entorno completo
# (la pantalla de inicio de sesión no carga /etc/profile por sí sola: sin esto no hay PATH,
#  ni aplicaciones de Flatpak en el lanzador, ni configuración nueva del usuario)
[ -r /etc/profile ] && . /etc/profile
[ -r "$HOME/.profile" ] && . "$HOME/.profile"
# Idioma: /etc/profile pone C.UTF-8 cuando viene de la consola (y greetd arranca desde ella).
# Aquí manda el idioma del sistema y, si lo elegiste con naranjos-idioma, el tuyo.
for f in /etc/locale.conf "$HOME/.config/locale.conf"; do
  [ -r "$f" ] && { set -a; . "$f"; set +a; }
done
unset f
# tus carpetas personales (Descargas, Documentos…) en tu idioma, si aún no existen
command -v naranjos-carpetas >/dev/null 2>&1 && naranjos-carpetas >/dev/null 2>&1
# inicio bonito (naranjos-inicio): la sesión arranca bloqueada
if [ "${1:-}" = --bloqueada ]; then export NARANJOS_BLOQUEO_INICIAL=1; shift; fi
exec start-hyprland "$@" >/dev/null 2>&1
