// NaranjOS · barra superior (~/.config/waybar/config.jsonc)
// Tras editar: Super + Shift + B dos veces, o cierra sesión y vuelve a entrar.
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,

  "modules-left":   ["image#naranjos", "custom/naranjos", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["custom/peel", "custom/noche", "bluetooth", "wireplumber", "network", "backlight", "battery", "cpu", "memory", "tray", "custom/sistema"],

  "image#naranjos": {
    "path": "/usr/share/naranjos/logo/naranjos-logo-plano-48.png",
    "size": 20,
    "tooltip": false,
    "on-click": "naranjos-menu"
  },
  "custom/naranjos": {
    "format": "NaranjOS",
    "tooltip": false,
    "on-click": "naranjos-menu"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },
  "hyprland/window": {
    "max-length": 48,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d %B · %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": { "today": "<span color='#ff8700'><b>{}</b></span>" }
    }
  },
  "wireplumber": {
    "format": "{icon}  {volume}%",
    "format-muted": "\uf026  ✕",
    "format-icons": ["\uf026", "\uf027", "\uf028"],
    "scroll-step": 5,
    "max-volume": 100,
    "tooltip-format": "{node_name}",
    "on-click": "naranjos-tui sonido",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "bluetooth": {
    "format": "\uf294",
    "format-off": "\uf294  ✕",
    "format-disabled": "",
    "format-no-controller": "",
    "format-connected": "\uf294  {device_alias}",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "naranjos-tui bluetooth"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "",
    "format-disconnected": "  ✕",
    "tooltip-format": "{ifname} · {ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}",
    "on-click": "naranjos-tui wifi"
  },
  "backlight": {
    "format": "  {percent}%",
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },
  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}"
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 5
  },
  "memory": {
    "format": "  {percentage}%",
    "interval": 10,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },
  "custom/peel": {
    "exec": "naranjos-peel barra",
    "return-type": "json",
    "interval": 30,
    "on-click": "naranjos-tui seguridad",
    "on-click-right": "naranjos-tui vpn"
  },
  "custom/noche": {
    "exec": "naranjos-noche barra",
    "return-type": "json",
    "interval": 60,
    "signal": 9,
    "on-click": "naranjos-noche alterna",
    "on-click-right": "naranjos-noche menu"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/sistema": {
    "format": "",
    "tooltip": false,
    "on-click": "naranjos-sistema"
  }
}
