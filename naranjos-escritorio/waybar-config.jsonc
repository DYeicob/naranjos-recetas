// NaranjOS · barra superior (~/.config/waybar/config.jsonc)
// Tras editar: Super + Shift + B dos veces, o cierra sesión y vuelve a entrar.
// El aspecto de los módulos con números (sonido, red, brillo, batería, CPU, memoria, título, música)
// lo pone naranjos-pantalla en ~/.config/naranjos/pantalla/waybar.jsonc: normal en pantallas anchas y
// compacto (solo iconos; los números al pasar el ratón) en las estrechas. Ver: naranjos-pantalla barra compacta
// Si defines aquí uno de esos módulos, manda lo tuyo.
{
  "layer": "top",
  "include": ["~/.config/naranjos/pantalla/waybar.jsonc"],   // posición: naranjos-pantalla barra …
  "height": 32,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,

  "modules-left":   ["image#naranjos", "custom/naranjos", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock", "custom/reloj"],
  "modules-right":  ["mpris", "custom/actualizaciones", "custom/remoto", "custom/portal", "custom/grabando", "custom/dictado", "custom/despierto", "custom/tailscale", "custom/tiempo", "custom/peel", "custom/noche", "bluetooth", "wireplumber", "wireplumber#micro", "hyprland/language", "network", "backlight", "battery", "cpu", "memory", "tray", "custom/notificaciones", "custom/sistema"],

  "wireplumber#micro": {
    "node-type": "Audio/Source",
    "format": "󰍬",
    "format-muted": "󰍭",
    "tooltip-format": "{node_name} · {volume}%",
    "on-click": "naranjos-osd micro"
  },
  "hyprland/language": { "format": "{short}", "on-click": "hyprctl switchxkblayout all next" },
  "custom/actualizaciones": { "exec": "naranjos-actualizaciones", "return-type": "json", "interval": 3600, "signal": 15, "on-click": "foot --app-id=naranjos-tui -e bash -c 'naranjos actualiza; read -rsn1'" },
  "custom/notificaciones": { "exec": "naranjos-notificaciones barra", "return-type": "json", "interval": 60, "signal": 16, "on-click": "naranjos-notificaciones nomolestar", "on-click-right": "naranjos-notificaciones historial" },
  "custom/reloj": { "exec": "naranjos-reloj barra", "return-type": "json", "interval": 30, "signal": 17, "on-click": "naranjos-reloj ver", "on-click-right": "naranjos-reloj añade" },
  "custom/remoto": { "exec": "naranjos-remoto barra", "return-type": "json", "interval": 30, "signal": 18 },
  "custom/portal": { "exec": "naranjos-red-panel barra", "return-type": "json", "interval": 30, "on-click": "naranjos-red-panel portal" },

  "image#naranjos": {
    "path": "/usr/share/naranjos/logo/naranjos-logo-plano-48.png",
    "size": 20,
    "tooltip": false,
    "on-click": "naranjos-menu"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d %B · %H:%M · semana %V}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": { "today": "<span color='#ff8700'><b>{}</b></span>" }
    }
  },
  "custom/peel": {
    "exec": "naranjos-peel barra",
    "return-type": "json",
    "interval": 30,
    "on-click": "naranjos-tui seguridad",
    "on-click-right": "naranjos-tui vpn"
  },
  "custom/noche": {
    "exec": "naranjos-noche barra",
    "return-type": "json",
    "interval": 60,
    "signal": 9,
    "on-click": "naranjos-noche alterna",
    "on-click-right": "naranjos-noche menu"
  },
  "custom/grabando": {
    "exec": "naranjos-captura barra",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "naranjos-captura video"
  },
  "custom/dictado": {
    "exec": "naranjos-dictado barra",
    "return-type": "json",
    "interval": "once",
    "signal": 11,
    "on-click": "naranjos-dictado"
  },
  "custom/tiempo": {
    "exec": "naranjos-tiempo barra",
    "return-type": "json",
    "interval": 1800,
    "signal": 12,
    "on-click": "foot --app-id=naranjos-tui -T NaranjOS sh -c 'naranjos-tiempo; read -r _'",
    "on-click-right": "naranjos-tiempo menu"
  },
  "custom/despierto": {
    "exec": "naranjos-despierto barra",
    "return-type": "json",
    "interval": "once",
    "signal": 13,
    "on-click": "naranjos-despierto"
  },
  "custom/tailscale": {
    "exec": "naranjos-tailscale barra",
    "return-type": "json",
    "interval": 60,
    "signal": 14,
    "on-click": "foot --app-id=naranjos-tui -T Tailscale sh -c 'naranjos-tailscale; read -r _'"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/sistema": {
    "format": "",
    "tooltip": false,
    "on-click": "naranjos-sistema"
  }
}
