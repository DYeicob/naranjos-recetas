#!/bin/bash
# naranjos-tui <wifi|bluetooth|sonido|seguridad|vpn|usb|idioma> — abre el menú en una ventana flotante
. /usr/lib/naranjos/naranjos-i18n.sh
case "${1:-}" in
  wifi)      exec foot --app-id=naranjos-tui -T "WiFi"             impala ;;
  bluetooth) exec foot --app-id=naranjos-tui -T "Bluetooth"        bluetui ;;
  sonido)    exec foot --app-id=naranjos-tui -T "$(_ 'Sonido')"    wiremix ;;
  seguridad) exec foot --app-id=naranjos-tui -T "$(_ 'Seguridad')" bash -c 'naranjos-peel; echo; read -rsn1 -p "$1"' _ "$(_ 'Pulsa una tecla para cerrar…')" ;;
  vpn)       exec foot --app-id=naranjos-tui -T "VPN"              bash -c 'naranjos-peel vpn alterna; echo; read -rsn1 -p "$1"' _ "$(_ 'Pulsa una tecla para cerrar…')" ;;
  usb)       exec foot --app-id=naranjos-tui -T "USB"              bash -c 'naranjos-peel usb menu; echo; read -rsn1 -p "$1"' _ "$(_ 'Pulsa una tecla para cerrar…')" ;;
  idioma)    exec foot --app-id=naranjos-tui -T "$(_ 'Idioma')"    naranjos-idioma menu-terminal ;;
  *) echo "$(_ 'Uso:') naranjos-tui wifi|bluetooth|sonido|seguridad|vpn|usb|idioma"; exit 1 ;;
esac
