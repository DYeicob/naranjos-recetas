#!/bin/bash
# naranjos-atajos — chuleta de atajos en pantalla (Super + K), en tu idioma
. /usr/lib/naranjos/naranjos-i18n.sh
f=atajos.txt; [ "${1:-}" = tmux ] && f=atajos-tmux.txt
fuzzel --dmenu --prompt "$(_ 'Atajos') ❯ " --width 70 --lines 22 \
  < "$(naranjos_traducido /usr/share/naranjos $f)" >/dev/null || true
