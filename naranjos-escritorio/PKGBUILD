install=naranjos-escritorio.install
backup=('etc/tuigreet/config.toml')
package() {
  local S="$pkgdir/etc/skel"
  install -Dm644 naranjos.lua     "$pkgdir/usr/share/naranjos/hypr/naranjos.lua"
  install -Dm644 atajos.txt       "$pkgdir/usr/share/naranjos/atajos.txt"
  install -Dm644 atajos-en.txt    "$pkgdir/usr/share/naranjos/en/atajos.txt"
  install -Dm644 manual.md        "$pkgdir/usr/share/doc/naranjos/manual.md"
  install -Dm644 manual-en.md     "$pkgdir/usr/share/doc/naranjos/en/manual.md"
  install -Dm644 versiones-antiguas.sha256 "$pkgdir/usr/share/naranjos/versiones-antiguas.sha256"
  install -Dm644 tuigreet.toml    "$pkgdir/etc/tuigreet/config.toml"
  install -Dm644 mimeapps.list    "$pkgdir/etc/xdg/mimeapps.list"
  install -Dm644 thunar.xml       "$pkgdir/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/thunar.xml"
  install -Dm644 thunar-volman.xml "$pkgdir/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/thunar-volman.xml"
  install -Dm644 hyprland.lua     "$S/.config/hypr/hyprland.lua"
  install -Dm644 hyprpaper.conf   "$S/.config/hypr/hyprpaper.conf"
  install -Dm644 hyprlock.conf    "$S/.config/hypr/hyprlock.conf"
  install -Dm644 hypridle.conf    "$S/.config/hypr/hypridle.conf"
  install -Dm644 mako.conf        "$S/.config/mako/config"
  install -Dm644 fuzzel.ini       "$S/.config/fuzzel/fuzzel.ini"
  install -Dm644 foot.ini         "$S/.config/foot/foot.ini"
  install -Dm644 waybar-config.jsonc "$S/.config/waybar/config.jsonc"
  install -Dm644 waybar-style.css   "$S/.config/waybar/style.css"
  install -Dm644 gtk3-settings.ini  "$S/.config/gtk-3.0/settings.ini"
  install -Dm644 gtk3-gtk.css       "$S/.config/gtk-3.0/gtk.css"
  install -Dm644 nvim-init.lua      "$S/.config/nvim/init.lua"
  install -Dm644 btop.conf          "$S/.config/btop/btop.conf"
  # emojis: datos de Unicode CLDR (licencia Unicode-3.0)
  install -Dm644 emojis.tsv         "$pkgdir/usr/share/naranjos/emojis.tsv"
  install -Dm644 salvapantallas.py  "$pkgdir/usr/lib/naranjos/salvapantallas.py"
  # greetd espera a que acabe la pantalla de arranque y la deja quieta hasta que sale el escritorio
  install -Dm644 greetd-plymouth.conf "$pkgdir/usr/lib/systemd/system/greetd.service.d/naranjos-plymouth.conf"
  for s in naranjos naranjos-red-panel naranjos-dock naranjos-disposicion naranjos-apariencia naranjos-notificaciones naranjos-reloj naranjos-actualizaciones naranjos-diapos naranjos-recorta naranjos-qr naranjos-remoto naranjos-camara naranjos-anchos naranjos-cuelgues naranjos-ia naranjos-menu naranjos-osd naranjos-noche naranjos-notifica naranjos-captura naranjos-sistema naranjos-atajos naranjos-ayuda naranjos-config-usuario naranjos-tui naranjos-navegador naranjos-sesion naranjos-carpetas naranjos-portapapeles naranjos-emoji naranjos-dictado naranjos-recuerda naranjos-tiempo naranjos-pantalla naranjos-restablece naranjos-ventanas naranjos-complementos naranjos-webapp naranjos-llave naranjos-utiles naranjos-despierto naranjos-salvapantallas naranjos-apps naranjos-tailscale naranjos-inicio naranjos-bloqueo-inicial; do
    install -Dm755 "$s" "$pkgdir/usr/bin/$s"
  done
  install -Dm644 naranjos-escritorio.sh "$pkgdir/etc/profile.d/naranjos-escritorio.sh"
  install -Dm644 _naranjos          "$pkgdir/usr/share/zsh/site-functions/_naranjos"
  install -Dm644 naranjos.bash      "$pkgdir/usr/share/bash-completion/completions/naranjos"
  install -Dm644 dock.css           "$pkgdir/usr/share/naranjos/dock.css"
  install -Dm644 fuzzel-galeria.ini "$pkgdir/usr/share/naranjos/fuzzel-galeria.ini"
  install -Dm644 atajos-tmux.txt    "$pkgdir/usr/share/naranjos/atajos-tmux.txt"
  install -Dm644 atajos-tmux-en.txt "$pkgdir/usr/share/naranjos/en/atajos-tmux.txt"
  install -Dm644 tmux.conf          "$S/.config/tmux/tmux.conf"
}
