arch=('any')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-3.0-or-later')
depends=('hyprland' 'hyprsunset' 'glib2' 'naranjos-temas' 'hyprpaper' 'hyprlock' 'hypridle' 'mako' 'fuzzel' 'foot' 'grim' 'slurp' 'wl-clipboard' 'brightnessctl' 'naranjos-fondos' 'naranjos-zsh' 'ttf-jetbrains-mono-nerd' 'less' 'waybar' 'adwaita-icon-theme' 'naranjos-red' 'pipewire' 'wireplumber' 'polkit' 'impala' 'bluetui' 'wiremix' 'tuigreet' 'flatpak' 'naranjos-portales' 'naranjos-cursor' 'naranjos-peel' 'naranjos-entorno' 'sudo' 'naranjos-idiomas')
source=('naranjos-menu' 'naranjos-osd' 'naranjos-noche' 'atajos-en.txt' 'atajos.txt' 'foot.ini' 'fuzzel.ini' 'gtk3-gtk.css' 'gtk3-settings.ini' 'hypridle.conf' 'hyprland.lua' 'hyprlock.conf' 'hyprpaper.conf' 'mako.conf' 'manual-en.md' 'manual.md' 'naranjos-atajos' 'naranjos-ayuda' 'naranjos-captura' 'naranjos-carpetas' 'naranjos-config-usuario' 'naranjos-escritorio.sh' 'naranjos.lua' 'naranjos-navegador' 'naranjos-notifica' 'naranjos-sesion' 'naranjos-sistema' 'naranjos-tui' 'tuigreet.toml' 'versiones-antiguas.sha256' 'waybar-config.jsonc' 'waybar-style.css')
