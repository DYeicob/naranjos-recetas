depends=('hyprland' 'hyprpaper' 'hyprlock' 'hypridle' 'mako' 'fuzzel' 'foot' 'grim' 'slurp' 'wl-clipboard' 'brightnessctl' 'naranjos-fondos' 'naranjos-zsh' 'ttf-jetbrains-mono-nerd' 'less' 'waybar' 'adwaita-icon-theme' 'naranjos-red' 'pipewire' 'wireplumber' 'polkit' 'impala' 'bluetui' 'wiremix' 'tuigreet' 'flatpak' 'naranjos-portales')
source=('atajos.txt' 'foot.ini' 'fuzzel.ini' 'gtk3-settings.ini' 'hypridle.conf' 'hyprland.lua' 'hyprlock.conf' 'hyprpaper.conf' 'mako.conf' 'manual.md' 'naranjos-atajos' 'naranjos-ayuda' 'naranjos-captura' 'naranjos-config-usuario' 'naranjos-escritorio.sh' 'naranjos.lua' 'naranjos-navegador' 'naranjos-notifica' 'naranjos-sistema' 'naranjos-tui' 'tuigreet.toml' 'versiones-antiguas.sha256' 'waybar-config.jsonc' 'waybar-style.css')
