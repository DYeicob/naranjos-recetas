install=naranjos-escritorio.install
backup=('etc/tuigreet/config.toml')
package() {
  local S="$pkgdir/etc/skel"
  install -Dm644 naranjos.lua     "$pkgdir/usr/share/naranjos/hypr/naranjos.lua"
  install -Dm644 atajos.txt       "$pkgdir/usr/share/naranjos/atajos.txt"
  install -Dm644 atajos-en.txt    "$pkgdir/usr/share/naranjos/en/atajos.txt"
  install -Dm644 manual.md        "$pkgdir/usr/share/doc/naranjos/manual.md"
  install -Dm644 manual-en.md     "$pkgdir/usr/share/doc/naranjos/en/manual.md"
  install -Dm644 versiones-antiguas.sha256 "$pkgdir/usr/share/naranjos/versiones-antiguas.sha256"
  install -Dm644 tuigreet.toml    "$pkgdir/etc/tuigreet/config.toml"
  install -Dm644 hyprland.lua     "$S/.config/hypr/hyprland.lua"
  install -Dm644 hyprpaper.conf   "$S/.config/hypr/hyprpaper.conf"
  install -Dm644 hyprlock.conf    "$S/.config/hypr/hyprlock.conf"
  install -Dm644 hypridle.conf    "$S/.config/hypr/hypridle.conf"
  install -Dm644 mako.conf        "$S/.config/mako/config"
  install -Dm644 fuzzel.ini       "$S/.config/fuzzel/fuzzel.ini"
  install -Dm644 foot.ini         "$S/.config/foot/foot.ini"
  install -Dm644 waybar-config.jsonc "$S/.config/waybar/config.jsonc"
  install -Dm644 waybar-style.css   "$S/.config/waybar/style.css"
  install -Dm644 gtk3-settings.ini  "$S/.config/gtk-3.0/settings.ini"
  install -Dm644 gtk3-gtk.css       "$S/.config/gtk-3.0/gtk.css"
  for s in naranjos-notifica naranjos-captura naranjos-sistema naranjos-atajos naranjos-ayuda naranjos-config-usuario naranjos-tui naranjos-navegador naranjos-sesion naranjos-carpetas; do
    install -Dm755 "$s" "$pkgdir/usr/bin/$s"
  done
  install -Dm644 naranjos-escritorio.sh "$pkgdir/etc/profile.d/naranjos-escritorio.sh"
}
