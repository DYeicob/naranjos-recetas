source=('thunar-volman.xml' 'thunar.xml' 'mimeapps.list' 'naranjos-menu' 'naranjos-osd' 'naranjos-noche' 'atajos-en.txt' 'atajos.txt' 'foot.ini' 'fuzzel.ini' 'gtk3-gtk.css' 'gtk3-settings.ini' 'hypridle.conf' 'hyprland.lua' 'hyprlock.conf' 'hyprpaper.conf' 'mako.conf' 'manual-en.md' 'manual.md' 'naranjos-atajos' 'naranjos-ayuda' 'naranjos-captura' 'naranjos-carpetas' 'naranjos-config-usuario' 'naranjos-escritorio.sh' 'naranjos.lua' 'naranjos-navegador' 'naranjos-notifica' 'naranjos-sesion' 'naranjos-sistema' 'naranjos-tui' 'tuigreet.toml' 'versiones-antiguas.sha256' 'waybar-config.jsonc' 'waybar-style.css')
