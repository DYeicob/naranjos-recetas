# Receta de NaranjOS — generada por naranjos-tanda-6r2.sh
pkgname=json-c
pkgver=0.19
pkgrel=1
pkgdesc='Biblioteca JSON en C (la usan cryptsetup y libnvme)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('MIT')
depends=()
makedepends=('cmake')
source=('https://s3.amazonaws.com/json-c_releases/releases/json-c-0.19.tar.gz')
sha256sums=('37ad0249902e301bd9052bf712e511fcc6acff4ecaad4b5900aad9ce564e26de')
build() {
  cmake -S json-c-$pkgver -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -D BUILD_STATIC_LIBS=OFF
  cmake --build build
}
package() { DESTDIR="$pkgdir" cmake --install build; }
