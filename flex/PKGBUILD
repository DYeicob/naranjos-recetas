# Receta de NaranjOS — generada por naranjos-tanda-6f2.sh
pkgname=flex
pkgver=2.6.4
pkgrel=1
pkgdesc='Generador de analizadores léxicos (flex y lex)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('BSD-2-Clause')
depends=('glibc' 'm4')
makedepends=()
source=('https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz')
sha256sums=('e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995')
build()   { cd flex-$pkgver; ./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/flex-$pkgver; make; }
check()   { cd flex-$pkgver; make check; }
package() {
  cd flex-$pkgver
  make DESTDIR="$pkgdir" install
  ln -sf flex   "$pkgdir/usr/bin/lex"
  ln -sf flex.1 "$pkgdir/usr/share/man/man1/lex.1"
}
