# Receta de NaranjOS — generada por naranjos-tanda-5a4.sh a partir de BLFS 13.1-systemd
pkgname=libjpeg-turbo
pkgver=3.2.0
pkgrel=1
pkgdesc='Biblioteca JPEG optimizada'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('custom')
depends=()
makedepends=('cmake' 'nasm')
source=('https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/3.2.0/libjpeg-turbo-3.2.0.tar.gz')
sha256sums=('6f30092cef9fb839779646608f4ee14ae3cbac989c47fa05e841b0841f09878e')
provides=('libjpeg')
build()   { cd libjpeg-turbo-$pkgver
  cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=RELEASE -D ENABLE_STATIC=FALSE \
        -D CMAKE_INSTALL_DEFAULT_LIBDIR=lib -D CMAKE_SKIP_INSTALL_RPATH=ON \
        -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/libjpeg-turbo-$pkgver
  make -C build; }
package() { cd libjpeg-turbo-$pkgver; make -C build DESTDIR="$pkgdir" install; }
