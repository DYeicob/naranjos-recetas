# Receta de NaranjOS — generada por naranjos-tanda-6r2.sh
pkgname=udisks2
pkgver=2.11.2
pkgrel=1
pkgdesc='Montar USB y discos sin ser root (udisks2)'
install=udisks2.install
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-or-later' 'LGPL-2.0-or-later')
depends=('libblockdev' 'libgudev' 'polkit' 'libatasmart' 'acl' 'systemd' 'util-linux')
makedepends=()
source=('https://github.com/storaged-project/udisks/releases/download/udisks-2.11.2/udisks-2.11.2.tar.bz2')
sha256sums=('18630a8aad806bea0bc626ce97e71e50ec82c742956ac1c834a4275f8f22207b')
backup=('etc/udisks2/udisks2.conf')
build() {
  cd udisks-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static \
    --enable-available-modules --disable-introspection --disable-man --disable-gtk-doc
  make
}
package() { cd udisks-$pkgver; make DESTDIR="$pkgdir" install; }
