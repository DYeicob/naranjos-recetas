post_install() {
  getent passwd greeter >/dev/null || /usr/sbin/useradd -r -M -d /var/lib/greetd -s /bin/bash -G video greeter
  install -dm755 -o greeter -g greeter /var/lib/greetd
  echo "  NaranjOS: para usar la pantalla de inicio de sesión:  sudo systemctl enable greetd"
}
post_upgrade() { post_install; }
