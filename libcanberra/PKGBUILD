pkgname=libcanberra
pkgver=0.30
pkgrel=1
pkgdesc='Sonidos de eventos del escritorio'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('LGPL-2.1-or-later')
depends=('libvorbis' 'libtool')
makedepends=()
source=('https://0pointer.de/lennart/projects/libcanberra/libcanberra-0.30.tar.xz' 'https://www.linuxfromscratch.org/patches/blfs/13.1/libcanberra-0.30-wayland-1.patch')
sha256sums=('c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72' 'e48ce8f952c2b71e38866b95aa21e02437924ed6f9c4409b64e8e4cb392b9013')
prepare() { cd libcanberra-$pkgver; patch -Np1 -i "$srcdir/libcanberra-$pkgver-wayland-1.patch"; }
build()   { cd libcanberra-$pkgver; ./configure --prefix=/usr --disable-oss --disable-gtk --disable-gtk3; make; }
package() { cd libcanberra-$pkgver; make DESTDIR="$pkgdir" docdir=/usr/share/doc/libcanberra-$pkgver install; }
