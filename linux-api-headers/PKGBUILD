# Receta de NaranjOS — generada por naranjos-tanda-6r1.sh
pkgname=linux-api-headers
pkgver=7.3.5
pkgrel=1
pkgdesc='Cabeceras del kernel Linux para compilar programas (/usr/include)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-only')
depends=()
makedepends=()
source=('https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.3.5.tar.xz')
sha256sums=('8f293f83d54f0b7b9be56863ebc5e4ea79d73e530b4ae55c572be97ef39f0990')
build() {
  cd linux-$pkgver
  make mrproper
  make headers
  find usr/include -type f ! -name '*.h' -delete
}
package() {
  cd linux-$pkgver
  install -d "$pkgdir/usr"
  cp -r usr/include "$pkgdir/usr/"
}
