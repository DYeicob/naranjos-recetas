# Receta de NaranjOS — generada por naranjos-tanda-6f5.sh
pkgname=sqlite
pkgver=3.53.4
pkgrel=1
pkgdesc='Base de datos SQLite'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('blessing')
depends=('readline' 'zlib')
makedepends=()
source=('https://sqlite.org/2026/sqlite-autoconf-3530400.tar.gz' 'https://sqlite.org/2026/sqlite-doc-3530400.zip')
sha256sums=('0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c' 'a1d0f5de57485d062796ed7e67daff0758b50d00001a0f233a2c15aaf40bbdc8')
build() {
  cd sqlite-autoconf-3530400
  ./configure --prefix=/usr --disable-static --enable-fts{4,5} \
              CPPFLAGS="-D SQLITE_ENABLE_COLUMN_METADATA=1 -D SQLITE_ENABLE_UNLOCK_NOTIFY=1 \
                        -D SQLITE_ENABLE_DBSTAT_VTAB=1 -D SQLITE_SECURE_DELETE=1"
  make LDFLAGS.rpath=""
}
package() {
  cd sqlite-autoconf-3530400
  make DESTDIR="$pkgdir" install
  install -d "$pkgdir/usr/share/doc/sqlite-$pkgver"
  cp -R ../sqlite-doc-3530400/. "$pkgdir/usr/share/doc/sqlite-$pkgver"
}
