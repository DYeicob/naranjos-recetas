package() {
  local t f
  for t in naranja sanguina lima pomelo limon brisa azahar sanguina-claro lima-claro pomelo-claro limon-claro brisa-claro; do
    for f in colores hyprland.lua waybar.css fuzzel.ini mako.conf foot.ini hyprlock.conf gtk.css btop.theme nvim.lua vscode.json; do
      install -Dm644 "$t--$f" "$pkgdir/usr/share/naranjos/temas/$t/$f"
    done
  done
  install -Dm755 naranjos-tema "$pkgdir/usr/bin/naranjos-tema"
  install -Dm644 tema-generador.py "$pkgdir/usr/lib/naranjos/tema-generador.py"
  # extensión de VS Code / VSCodium con todos los temas (naranjos-tema vscode la instala en tu usuario)
  local V="$pkgdir/usr/share/naranjos/vscode/naranjos-temas"
  install -Dm644 vscode-package.json "$V/package.json"
  for t in naranja sanguina lima pomelo limon brisa azahar sanguina-claro lima-claro pomelo-claro limon-claro brisa-claro; do install -Dm644 "$t--vscode.json" "$V/themes/$t.json"; done
  # iconos de cada tema: Papirus con las carpetas del color del tema (NaranjOS-iconos-<tema>)
  bash genera-iconos /usr/share/icons "$pkgdir/usr/share/icons"
}
