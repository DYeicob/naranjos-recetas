package() {
  local t f
  for t in naranja sanguina lima pomelo limon brisa azahar; do
    for f in colores hyprland.lua waybar.css fuzzel.ini mako.conf foot.ini hyprlock.conf gtk.css; do
      install -Dm644 "$t--$f" "$pkgdir/usr/share/naranjos/temas/$t/$f"
    done
  done
  install -Dm755 naranjos-tema "$pkgdir/usr/bin/naranjos-tema"
  # iconos de cada tema: Papirus con las carpetas del color del tema (NaranjOS-iconos-<tema>)
  bash genera-iconos /usr/share/icons "$pkgdir/usr/share/icons"
}
