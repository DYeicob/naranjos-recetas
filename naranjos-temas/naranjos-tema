#!/bin/bash
# naranjos-tema — los temas cítricos de NaranjOS (fase 6k1)
#   naranjos-tema                 el tema puesto y la lista
#   naranjos-tema lista           los temas que hay
#   naranjos-tema pon <tema>      cambia de tema (bordes, barra, lanzador, avisos, terminal, bloqueo, GTK y fondo)
#   naranjos-tema siguiente       pasa al siguiente
#   naranjos-tema menu            elegirlo en un menú (Super + Ctrl + T)
#   naranjos-tema revisa          qué ficheros tuyos de ~/.config no siguen el tema
#   naranjos-tema fondo [siguiente] otro fondo del tema (Super + Ctrl + Espacio)
#   naranjos-tema modo [claro|oscuro]  el mismo cítrico en claro u oscuro (Super + Ctrl + Mayús + T)
#   naranjos-tema vscode          los temas de NaranjOS en VS Code / VSCodium
#   naranjos-tema crea "Mi tema" 8a2be2   un tema tuyo a partir de un color (oscuro y claro); borra <tema> lo quita
# El tema elegido es un enlace: ~/.config/naranjos/tema → /usr/share/naranjos/temas/<tema>
set -uo pipefail
if [ -r /usr/lib/naranjos/naranjos-i18n.sh ]; then . /usr/lib/naranjos/naranjos-i18n.sh; else _(){ printf '%s' "$1"; }; fi
O=$'\e[1;38;5;208m'; G=$'\e[1;32m'; R=$'\e[1;31m'; A=$'\e[1;33m'; D=$'\e[2m'; Z=$'\e[0m'
[ -t 1 ] || { O=; G=; R=; A=; D=; Z=; }
TEMAS=${NARANJOS_TEMAS:-/usr/share/naranjos/temas}
CONF=${XDG_CONFIG_HOME:-$HOME/.config}
ENLACE=$CONF/naranjos/tema
ORDEN=(naranja sanguina lima pomelo limon brisa azahar)
CLAROS=(azahar sanguina-claro lima-claro pomelo-claro limon-claro brisa-claro)   # (6o) versiones claras
pareja(){ # el mismo cítrico en el otro modo
  case "$1" in naranja) echo azahar ;; azahar) echo naranja ;; *-claro) echo "${1%-claro}" ;; *) echo "$1-claro" ;; esac
}
die(){ printf '%snaranjos-tema:%s %s\n' "$R" "$Z" "$1" >&2; exit 1; }

[ "$(id -u)" != 0 ] || die "$(_ 'Cada usuario elige su tema: ejecútalo sin sudo.')"

actual(){ local d; d=$(readlink "$ENLACE" 2>/dev/null) || { echo naranja; return; }; basename "$d"; }
# (6o7) temas tuyos: ~/.local/share/naranjos/temas/<tema> (naranjos-tema crea)
MIOS="${XDG_DATA_HOME:-$HOME/.local/share}/naranjos/temas"
dir_de(){ if [ -r "$MIOS/$1/colores" ]; then echo "$MIOS/$1"; else echo "$TEMAS/$1"; fi; }
for _d in "$MIOS"/*/colores; do
  [ -r "$_d" ] || continue; _t=$(basename "$(dirname "$_d")")
  case "$_t" in *-claro) CLAROS+=("$_t") ;; *) ORDEN+=("$_t") ;; esac
done; unset _d _t
nombre(){ sed -n 's/^NOMBRE=//p' "$(dir_de "$1")/colores" 2>/dev/null | tr -d '"'; }
existe(){ [ -r "$(dir_de "$1")/colores" ]; }

lista(){
  local t a; a=$(actual)
  printf '%sNaranjOS · %s%s\n' "$O" "$(_ 'temas')" "$Z"
  for t in "${ORDEN[@]}" "${CLAROS[@]:1}"; do
    existe "$t" || continue
    if [ "$t" = "$a" ]; then printf '  %s● %-15s%s %s\n' "$O" "$t" "$Z" "$(nombre "$t")"
    else printf '  ○ %-15s %s%s%s\n' "$t" "$D" "$(nombre "$t")" "$Z"; fi
  done
}

# ficheros de ~/.config que deberían seguir el tema, y la marca que lo demuestra
SIGUEN=(
  "hypr/hyprlock.conf|naranjos/tema/hyprlock.conf"
  "mako/config|naranjos/tema/mako.conf"
  "fuzzel/fuzzel.ini|naranjos/tema/fuzzel.ini"
  "foot/foot.ini|naranjos/tema/foot.ini"
  "waybar/style.css|naranjos/tema/waybar.css"
  "gtk-3.0/gtk.css|naranjos/tema/gtk.css"
)
revisa(){
  local e f m malos=0
  for e in "${SIGUEN[@]}"; do
    f=${e%%|*}; m=${e#*|}
    if [ -f "$CONF/$f" ] && ! grep -q "$m" "$CONF/$f"; then
      [ $malos = 0 ] && printf '%s!%s %s\n' "$A" "$Z" "$(_ 'Estos ficheros tuyos no siguen el tema (los cambiaste):')"
      echo "    ~/.config/$f"; malos=$((malos + 1))
    fi
  done
  if [ $malos -gt 0 ]; then
    echo "  $(_ 'Para ponerlos como los de NaranjOS (se guarda copia .anterior):') naranjos-config-usuario --forzar"
    return 1
  fi
  return 0
}

# el fondo: solo se cambia si el tuyo es uno de NaranjOS (si pusiste otra imagen, se respeta)
pon_fondo(){  # pon_fondo <imagen> [--siempre]
  local fondo="$1" f="$CONF/hypr/hyprpaper.conf" m ok=0
  [ -f "$f" ] || return 0
  if [ "${2:-}" = --siempre ]; then
    sed -i -E "0,/^[[:space:]]*path[[:space:]]*=/s|^([[:space:]]*path[[:space:]]*=[[:space:]]*).*|\1$fondo|" "$f"
  else
    grep -qE '^[[:space:]]*path[[:space:]]*=[[:space:]]*/usr/share/backgrounds/naranjos/' "$f" || return 0
    sed -i -E "s|^([[:space:]]*path[[:space:]]*=[[:space:]]*)/usr/share/backgrounds/naranjos/[^[:space:]]*|\1$fondo|" "$f"
  fi
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 0
  # en caliente, por IPC (sin reiniciar hyprpaper): pantalla a pantalla
  if pgrep -x hyprpaper >/dev/null; then
    for m in $(hyprctl monitors 2>/dev/null | sed -n 's/^Monitor \([^ ]*\) .*/\1/p'); do
      hyprctl hyprpaper wallpaper "$m, $fondo, cover" >/dev/null 2>&1 && ok=1
    done
    hyprctl hyprpaper wallpaper ", $fondo, cover" >/dev/null 2>&1 && ok=1
  fi
  # si no está o no hace caso: se (re)lanza desde Hyprland, que es quien debe arrancarlo
  if [ $ok = 0 ]; then
    pkill -x hyprpaper 2>/dev/null; sleep 0.5
    hyprctl dispatch 'hl.dsp.exec_cmd("hyprpaper")' >/dev/null 2>&1 || setsid -f hyprpaper >/dev/null 2>&1
  fi
}

# el cursor del tema (Hyprland, GTK y el resto de programas)
pon_cursor(){
  local c="$1" f="$CONF/gtk-3.0/settings.ini" d="$HOME/.local/share/icons/default"
  [ -n "$c" ] && [ -d "/usr/share/icons/$c" ] || return 0
  [ -f "$f" ] && sed -i "s/^gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$c/" "$f"
  gs cursor-theme "$c"; gs cursor-size 24
  mkdir -p "$d"
  printf '[Icon Theme]\nName=Default\nComment=Cursor del tema de NaranjOS (naranjos-tema)\nInherits=%s\n' "$c" > "$d/index.theme"
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl setcursor "$c" 24 >/dev/null 2>&1
  return 0
}

# GTK en Wayland lee el aspecto de GSettings (dconf) a través del portal: sin esto, settings.ini no manda
gs(){
  command -v gsettings >/dev/null 2>&1 || return 0
  gsettings writable org.gnome.desktop.interface "$1" >/dev/null 2>&1 || return 0
  gsettings set org.gnome.desktop.interface "$1" "$2" >/dev/null 2>&1 || true
}

# iconos del tema (Papirus con las carpetas de su color)
pon_iconos(){
  [ -n "$1" ] && [ -d "/usr/share/icons/$1" ] && gs icon-theme "$1"
  local i="$1" f="$CONF/gtk-3.0/settings.ini"
  [ -n "$i" ] && [ -d "/usr/share/icons/$i" ] && [ -f "$f" ] || return 0
  if grep -q '^gtk-icon-theme-name=' "$f"; then sed -i "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$i/" "$f"
  else sed -i "/^\[Settings\]/a gtk-icon-theme-name=$i" "$f"; fi
}

# GTK 3: claro u oscuro según el tema
pon_gtk(){
  local claro="$1" f="$CONF/gtk-3.0/settings.ini" v=1
  [ "$claro" = 1 ] && v=0
  if [ "$v" = 1 ]; then gs color-scheme prefer-dark; gs gtk-theme Adwaita-dark; else gs color-scheme default; gs gtk-theme Adwaita; fi
  [ -f "$f" ] || return 0
  if grep -q '^gtk-application-prefer-dark-theme=' "$f"; then
    sed -i "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$v/" "$f"
  else
    sed -i "/^\[Settings\]/a gtk-application-prefer-dark-theme=$v" "$f"
  fi
}

recarga(){
  [ -n "${WAYLAND_DISPLAY:-}" ] || return 0
  hyprctl reload >/dev/null 2>&1 || true
  pkill -SIGUSR2 -x waybar 2>/dev/null || true
  makoctl reload >/dev/null 2>&1 || true
}

pon(){
  local t="${1:-}" quieto="${2:-}"
  [ -n "$t" ] || die "$(_ 'Dime qué tema:') naranjos-tema pon <tema>   ($(_ 'mira:') naranjos-tema lista)"
  t=$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]' | sed 's/ó/o/g; s/á/a/g')
  existe "$t" || die "$(_ 'No existe el tema') «$t» ($(_ 'mira:') naranjos-tema lista)"
  local FONDO="" CLARO=0 CURSOR=NaranjOS ICONOS=""
  # shellcheck disable=SC1090
  . "$(dir_de "$t")/colores"
  mkdir -p "$CONF/naranjos"
  ln -sfn "$(dir_de "$t")" "$ENLACE"
  pon_gtk "$CLARO"
  pon_iconos "$ICONOS"
  # (6o) btop sigue el tema: su tema «naranjos» apunta siempre al tema puesto
  mkdir -p "$CONF/btop/themes"; ln -sfn "$ENLACE/btop.theme" "$CONF/btop/themes/naranjos.theme"
  [ "$quieto" = --sin-recargar ] && return 0
  recarga
  pon_cursor "$CURSOR"
  [ -n "$FONDO" ] && pon_fondo "$FONDO"
  command -v notify-send >/dev/null && [ -n "${WAYLAND_DISPLAY:-}" ] && \
    notify-send -a NaranjOS -i naranjos "$(_ 'Tema'): $(nombre "$t")" "$(_ 'Las terminales nuevas ya salen con el tema.')" 2>/dev/null
  printf '%s✔%s %s %s\n' "$G" "$Z" "$(_ 'Tema puesto:')" "$(nombre "$t")"
  revisa >/dev/null || revisa || true
}

# otro fondo del tema puesto (los naranjos-0N.jpg de su carpeta), en orden
fondo(){
  local t FONDO="" dir act l=() i sig
  t=$(actual); . "$(dir_de "$t")/colores"
  dir=$(dirname "$FONDO")
  mapfile -t l < <(ls "$dir"/naranjos-0[0-9].jpg 2>/dev/null | sort)
  [ ${#l[@]} -gt 0 ] || die "$(_ 'No encuentro fondos en') $dir"
  act=$(sed -nE 's/^[[:space:]]*path[[:space:]]*=[[:space:]]*//p' "$CONF/hypr/hyprpaper.conf" 2>/dev/null | head -n1)
  sig=${l[0]}
  for i in "${!l[@]}"; do [ "${l[$i]}" = "$act" ] && sig=${l[$(( (i + 1) % ${#l[@]} ))]}; done
  pon_fondo "$sig" --siempre
  printf '%s✔%s %s %s\n' "$G" "$Z" "$(_ 'Fondo:')" "$(basename "$sig")"
}

# claro / oscuro sin cambiar de cítrico
modo(){
  local a o; a=$(actual); o=$(pareja "$a")
  case "${1:-alterna}" in
    claro|light)  grep -qx 'CLARO=1' "$(dir_de "$a")/colores" 2>/dev/null && return 0 ;;
    oscuro|dark)  grep -qx 'CLARO=1' "$(dir_de "$a")/colores" 2>/dev/null || return 0 ;;
  esac
  existe "$o" || die "$(_ 'No existe el tema') «$o»"
  pon "$o"
}

# los temas de NaranjOS en VS Code / VSCodium (si los tienes)
vscode(){
  local s=/usr/share/naranjos/vscode/naranjos-temas d hay=0
  for d in "$HOME/.vscode/extensions" "$HOME/.vscode-oss/extensions" \
           "$HOME/.var/app/com.vscodium.codium/data/codium/extensions" "$HOME/.var/app/com.visualstudio.code/data/vscode/extensions"; do
    [ -d "${d%/extensions}" ] || continue
    mkdir -p "$d"; rm -rf "$d/naranjos.naranjos-temas-"*; cp -r "$s" "$d/naranjos.naranjos-temas-1.0.0"; hay=1
    printf '%s✔%s %s\n' "$G" "$Z" "${d/#$HOME/\~}"
  done
  [ "$hay" = 1 ] || printf '%s\n' "$(_ 'No encuentro VS Code ni VSCodium en tu usuario')"
}

# un tema nuevo a partir de un color (oscuro y claro)
crea(){
  local n="${1:-}" c="${2:-}" id
  [ -n "$n" ] && [[ "${c#\#}" =~ ^[0-9a-fA-F]{6}$ ]] || die "$(_ 'Uso:') naranjos-tema crea \"$(_ 'Mi tema')\" ff8700"
  id=$(printf '%s' "$n" | tr '[:upper:]' '[:lower:]' | sed 's/ó/o/g;s/á/a/g;s/é/e/g;s/í/i/g;s/ú/u/g;s/ñ/n/g' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')
  [ -n "$id" ] || die "$(_ 'Ese nombre no vale')"
  [ -r "$TEMAS/$id/colores" ] && die "$(_ 'Ya hay un tema de NaranjOS con ese nombre')"
  python3 -I /usr/lib/naranjos/tema-generador.py "$MIOS/$id" "$id" "$n" "${c#\#}" >/dev/null || die "$(_ 'No pude crear el tema')"
  python3 -I /usr/lib/naranjos/tema-generador.py "$MIOS/$id-claro" "$id-claro" "$n ($(_ 'claro'))" "${c#\#}" claro >/dev/null
  printf '%s✔%s %s %s · %s\n' "$G" "$Z" "$(_ 'Tema creado:')" "$n" "${MIOS/#$HOME/\~}/$id"
  printf '  %s\n' "$(_ 'Retócalo a tu gusto: cambia los COLOR_… de «colores» y los demás ficheros de esa carpeta.')"
  ORDEN+=("$id"); CLAROS+=("$id-claro")
  pon "$id"
}
borra_mio(){
  local id="${1:-}"; [ -n "$id" ] && [ -d "$MIOS/$id" ] || die "$(_ 'No tienes un tema con ese nombre')"
  [ "$(actual)" = "$id" ] || [ "$(actual)" = "$id-claro" ] && pon naranja --sin-recargar >/dev/null
  rm -rf -- "${MIOS:?}/$id" "${MIOS:?}/$id-claro"; printf '%s✔%s %s\n' "$G" "$Z" "$(_ 'Tema borrado')"
}

siguiente(){
  local a i n=${#ORDEN[@]}; a=$(actual)
  for i in "${!ORDEN[@]}"; do [ "${ORDEN[$i]}" = "$a" ] && { pon "${ORDEN[$(( (i + 1) % n ))]}"; return; }; done
  pon naranja
}

menu(){
  local a t l=() i sel
  a=$(actual)
  for t in "${ORDEN[@]}"; do
    existe "$t" || continue
    if [ "$t" = "$a" ]; then l+=("● $(nombre "$t")"); else l+=("   $(nombre "$t")"); fi
  done
  sel=$(printf '%s\n' "${l[@]}" | fuzzel --dmenu --index --prompt "$(_ 'Tema') ❯ " --lines "${#l[@]}" --width 30) || exit 0
  i=0
  for t in "${ORDEN[@]}"; do existe "$t" || continue; [ "$i" = "$sel" ] && { pon "$t"; return; }; i=$((i + 1)); done
}

case "${1:-}" in
  ""|estado)       lista ;;
  lista|list|ls)   lista ;;
  pon|set|usa)     shift; pon "${1:-}" "${2:-}" ;;
  siguiente|next)  siguiente ;;
  menu)            menu ;;
  modo|mode)       shift; modo "${1:-alterna}" ;;
  crea|new)        shift; crea "$@" ;;
  borra|delete)    shift; borra_mio "$@" ;;
  vscode|code)     vscode ;;
  actual|current)  actual ;;
  fondo|wallpaper) fondo ;;
  revisa|check)    revisa && printf '%s✔%s %s\n' "$G" "$Z" "$(_ 'Todo sigue el tema.')" ;;
  ayuda|help|-h|--help)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) pon "$1" ;;
esac
