makedepends=()
source=('https://github.com/openwall/john/archive/ea6b98c095559785903a10d51c47d90aafcc52c8/john-ea6b98c095559785903a10d51c47d90aafcc52c8.tar.gz')
sha256sums=('7cb9fe23ba637101f0634d2040ab299040985eea21fce58bfd47d2fd02ceefbc')
_commit=ea6b98c095559785903a10d51c47d90aafcc52c8
build() {
  cd john-$_commit/src
  export CFLAGS="$CFLAGS -std=gnu17 -Wno-error"
  ./configure --disable-native-tests --disable-opencl
  make -s
}
package() {
  cd john-$_commit
  install -d "$pkgdir/usr/lib/john" "$pkgdir/usr/bin"
  cp -a run/. "$pkgdir/usr/lib/john/"
  printf '#!/bin/sh\nexec /usr/lib/john/john "$@"\n' > "$pkgdir/usr/bin/john"; chmod 755 "$pkgdir/usr/bin/john"
  install -Dm644 doc/LICENSE -t "$pkgdir/usr/share/licenses/john/"
}
