# Receta de NaranjOS — generada por naranjos-tanda-6f3.sh
pkgname=expat
pkgver=2.8.3
pkgrel=1
pkgdesc='Biblioteca para leer XML (expat)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('MIT')
depends=('glibc')
makedepends=()
source=('https://github.com/libexpat/libexpat/releases/download/R_2_8_3/expat-2.8.3.tar.xz')
sha256sums=('f6256df90c906773d344da084402b7d3e4f22ed41b1a59c989098a83d3ea0c85')
build()   { cd expat-$pkgver; ./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/expat-$pkgver; make; }
check()   { cd expat-$pkgver; make check || echo "expat: alguna prueba falló"; }
package() {
  cd expat-$pkgver
  make DESTDIR="$pkgdir" install
  install -d "$pkgdir/usr/share/doc/expat-$pkgver"
  install -m644 doc/*.{html,css} "$pkgdir/usr/share/doc/expat-$pkgver"
}
