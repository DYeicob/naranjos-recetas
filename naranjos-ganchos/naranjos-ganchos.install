# NaranjOS · aplica ya lo que faltaba (p. ej. el usuario rtkit) y vuelve a arrancar lo que falló por eso
post_install() {
  /usr/bin/naranjos-sysusers || true
  systemd-tmpfiles --create >/dev/null 2>&1 || true
  udevadm control --reload >/dev/null 2>&1 || true
  if systemctl is-failed --quiet rtkit-daemon.service 2>/dev/null; then
    systemctl reset-failed rtkit-daemon.service >/dev/null 2>&1; systemctl restart rtkit-daemon.service >/dev/null 2>&1 || true
  fi
  return 0
}
post_upgrade() { post_install; }
