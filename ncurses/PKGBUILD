# Receta de NaranjOS — generada por naranjos-tanda-6f7.sh
pkgname=ncurses
pkgver=6.6
pkgrel=1
pkgdesc='Biblioteca de terminal (ncurses)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('MIT-open-group')
depends=('glibc' 'gcc-libs')
makedepends=()
source=('https://invisible-mirror.net/archives/ncurses/ncurses-6.6.tar.gz')
sha256sums=('355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11')
build() {
  cd ncurses-$pkgver
  ./configure --prefix=/usr --mandir=/usr/share/man --with-shared --without-debug --without-normal \
              --with-cxx-shared --enable-pc-files --with-pkg-config-libdir=/usr/lib/pkgconfig
  make
}
package() {
  cd ncurses-$pkgver
  make DESTDIR="$pkgdir" install
  sed -e 's/^#if.*XOPEN.*$/#if 1/' -i "$pkgdir/usr/include/curses.h"
  local lib
  for lib in ncurses form panel menu; do
    ln -sf lib${lib}w.so "$pkgdir/usr/lib/lib${lib}.so"
    ln -sf ${lib}w.pc    "$pkgdir/usr/lib/pkgconfig/${lib}.pc"
  done
  ln -sf libncursesw.so "$pkgdir/usr/lib/libcurses.so"
  install -d "$pkgdir/usr/share/doc/ncurses-$pkgver"
  cp -R doc/. "$pkgdir/usr/share/doc/ncurses-$pkgver"
}
