pkgname=libsigcpp2
pkgver=2.12.1
pkgrel=1
pkgdesc='libsigc++ 2: señales para C++'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('custom')
depends=()
makedepends=()
source=('https://download.gnome.org/sources/libsigc++/2.12/libsigc++-2.12.1.tar.xz')
sha256sums=('a9dbee323351d109b7aee074a9cb89ca3e7bcf8ad8edef1851f4cf359bd50843')
provides=('libsigc++' 'libsigc++2')
prepare() { cd libsigc++-$pkgver; sed -i "s/'system',//" meson.build; }
build()   { cd libsigc++-$pkgver; meson setup build --prefix=/usr --buildtype=plain; meson compile -C build; }
package() { cd libsigc++-$pkgver; DESTDIR="$pkgdir" meson install -C build; }
