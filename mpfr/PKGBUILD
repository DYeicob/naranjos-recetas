# Receta de NaranjOS — generada por naranjos-tanda-6f3.sh
pkgname=mpfr
pkgver=4.2.2
pkgrel=1
pkgdesc='Coma flotante de precisión arbitraria (MPFR)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('LGPL-3.0-or-later')
depends=('gmp')
makedepends=()
source=('https://ftpmirror.gnu.org/mpfr/mpfr-4.2.2.tar.xz')
sha256sums=('b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01')
build() {
  cd mpfr-$pkgver
  ./configure --prefix=/usr --disable-static --enable-thread-safe --docdir=/usr/share/doc/mpfr-$pkgver
  make
  make html
}
check()   { cd mpfr-$pkgver; make check; }
package() { cd mpfr-$pkgver; make DESTDIR="$pkgdir" install install-html; }
