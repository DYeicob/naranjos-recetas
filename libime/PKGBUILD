pkgname=libime
pkgver=1.1.17
pkgrel=1
pkgdesc='Motor de entrada para chino (pinyin) de fcitx5'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('LGPL-2.1-or-later')
depends=('fcitx5' 'boost' 'zstd')
makedepends=('extra-cmake-modules' 'cmake' 'ninja' 'python')
source=('https://github.com/fcitx/libime/archive/1.1.17/libime-1.1.17.tar.gz' 'https://github.com/kpu/kenlm/archive/4cb443e60b7bf2c0ddf3c745378f76cb59e254e5/kenlm-4cb443e60b7bf2c0ddf3c745378f76cb59e254e5.tar.gz')
sha256sums=('6af056717edf99be8d4b83717de01b6404398d2fc47a301b609ca7d31331cafb' '11df4f929b175f0b3bd26be7a5a83b3c17cdefa83baecab0b6e69f77430184ea')
prepare() { cd libime-$pkgver; rm -rf src/libime/core/kenlm; cp -r ../kenlm-4cb443e60b7bf2c0ddf3c745378f76cb59e254e5 src/libime/core/kenlm; }
# los diccionarios los baja CMake de download.fcitx-im.org y comprueba su sha256 (hace falta red al compilar)
build() { cd libime-$pkgver; cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -Wno-dev -DENABLE_TEST=Off -DENABLE_DOC=Off; ninja -C build; }
package() { cd libime-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
