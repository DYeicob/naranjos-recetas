#!/bin/bash
# naranjos-zram — memoria de intercambio comprimida en la RAM (zram), como en Omarchy
#   naranjos-zram activa | apaga | estado    (lo activa solo el servicio naranjos-zram al arrancar)
# Tamaño: la mitad de la RAM (máximo 16 GB), con zstd. Se usa antes que el swap del disco.
set -uo pipefail
case "${1:-estado}" in
  activa)
    [ -e /dev/zram0 ] || modprobe zram num_devices=1 || exit 1
    swapon --show=NAME --noheadings | grep -q zram0 && exit 0
    mem=$(awk '/MemTotal/ {print $2}' /proc/meminfo); t=$(( mem / 2 )); [ "$t" -gt 16777216 ] && t=16777216
    zramctl --reset /dev/zram0 2>/dev/null
    zramctl /dev/zram0 --algorithm zstd --size "${t}KiB" && mkswap -q /dev/zram0 && swapon -p 100 /dev/zram0
    sysctl -q vm.swappiness=180 vm.page-cluster=0 2>/dev/null; true ;;
  apaga) swapoff /dev/zram0 2>/dev/null; zramctl --reset /dev/zram0 2>/dev/null; true ;;
  estado) zramctl 2>/dev/null; swapon --show ;;
  *) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
