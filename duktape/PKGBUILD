prepare() { cd duktape-$pkgver; sed -i 's/-Os/-O2/' Makefile.sharedlibrary; }
build()   { cd duktape-$pkgver; make -f Makefile.sharedlibrary INSTALL_PREFIX=/usr; }
package() { cd duktape-$pkgver; make -f Makefile.sharedlibrary INSTALL_PREFIX=/usr DESTDIR="$pkgdir" install; }
