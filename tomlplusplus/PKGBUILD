pkgname=tomlplusplus
pkgver=3.4.0
pkgrel=1
pkgdesc='Lector de ficheros TOML para C++'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('custom')
depends=()
makedepends=()
source=('https://github.com/marzer/tomlplusplus/archive/v3.4.0/tomlplusplus-3.4.0.tar.gz')
sha256sums=('8517f65938a4faae9ccf8ebb36631a38c1cadfb5efa85d9a72e15b9e97d25155')
build()   { cd tomlplusplus-$pkgver
  meson setup build --prefix=/usr --buildtype=plain -D build_lib=true -D default_library=shared
  meson compile -C build; }
package() { cd tomlplusplus-$pkgver; DESTDIR="$pkgdir" meson install -C build; }
