# Paquete propio de NaranjOS — generado por naranjos-tanda-6q.sh (NO editar a mano)
pkgname=naranjos-red
pkgver=0.2.0
pkgrel=1
pkgdesc='Red de NaranjOS: WiFi con iwd + systemd-networkd o con NetworkManager, hora por internet y arranque sin esperas'
arch=('any')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-3.0-or-later')
depends=('iwd' 'python')
optdepends=('networkmanager: panel de red completo (sudo naranjos-red usa networkmanager)')
source=('naranjos-red' '25-naranjos-wifi.network' 'timesyncd-naranjos.conf' 'wait-online-naranjos.conf')
sha256sums=('d4ee3fa6772a82a671f997a092e6b2af92df1cf200ea918b31e813543e3492f2' '922dd826a671214cc61f4f80f6230997036ca67e2d2f04ada01c649b56e66516' '08eed1a553f7491236f12a959d25fbf9d01f0ce796f2221e74a95323ec6ddaaf' 'abc824e80e301be7855d4b5c2b7e9e5eff6508e597bec534da2fd0f51b62b305')
install=naranjos-red.install
package() {
  install -Dm755 naranjos-red "$pkgdir/usr/bin/naranjos-red"
  install -Dm644 25-naranjos-wifi.network  "$pkgdir/usr/lib/systemd/network/25-naranjos-wifi.network"
  install -Dm644 timesyncd-naranjos.conf   "$pkgdir/usr/lib/systemd/timesyncd.conf.d/naranjos.conf"
  install -Dm644 wait-online-naranjos.conf "$pkgdir/usr/lib/systemd/system/systemd-networkd-wait-online.service.d/naranjos.conf"
}
