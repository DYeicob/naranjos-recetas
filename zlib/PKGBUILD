# Receta de NaranjOS — generada por naranjos-tanda-6f2.sh
pkgname=zlib
pkgver=1.3.2
pkgrel=1
pkgdesc='Biblioteca de compresión zlib'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('Zlib')
depends=('glibc')
makedepends=()
source=('https://zlib.net/fossils/zlib-1.3.2.tar.gz')
sha256sums=('bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16')
build()   { cd zlib-$pkgver; ./configure --prefix=/usr; make; }
check()   { cd zlib-$pkgver; make check; }
package() {
  cd zlib-$pkgver
  make DESTDIR="$pkgdir" install
  rm -f "$pkgdir/usr/lib/libz.a"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
