post_install() {
  # las apps que usan ALSA directamente (speaker-test, juegos…) suenan a través de PipeWire
  mkdir -p /etc/alsa/conf.d
  for f in 50-pipewire.conf 99-pipewire-default.conf; do
    [ -e /usr/share/alsa/alsa.conf.d/$f ] && ln -sf /usr/share/alsa/alsa.conf.d/$f /etc/alsa/conf.d/$f
  done
  return 0
}
post_upgrade() { post_install; }
