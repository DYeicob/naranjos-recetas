#!/usr/bin/bash
# /init del initramfs de NaranjOS (lo crea naranjos-initramfs)
# Prepara lo justo para encontrar y montar la raíz, y le pasa el testigo al systemd del sistema.
# Opciones del kernel que entiende:
#   root=UUID=… | PARTUUID=… | LABEL=… | PARTLABEL=… | /dev/…   rootfstype=…   rootflags=…
#   ro | rw   rootwait   rootdelay=<s>   init=<ruta>   rd.break (shell antes de arrancar)   rd.debug
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
mount -t proc     proc /proc -o nosuid,nodev,noexec
mount -t sysfs    sys  /sys  -o nosuid,nodev,noexec
mount -t devtmpfs dev  /dev  -o mode=0755,nosuid
mount -t tmpfs    run  /run  -o nosuid,nodev,mode=0755
exec </dev/console >/dev/console 2>&1

N=$'\e[1;38;5;208m'; Z=$'\e[0m'
di(){ echo "${N}NaranjOS:${Z} $*"; }

raiz="" tipo="" flags="" modo=ro espera=10 retraso=0 programa=/sbin/init parar=0
read -r -a args < /proc/cmdline
for a in "${args[@]}"; do
  case "$a" in
    root=*)       raiz=${a#root=} ;;
    rootfstype=*) tipo=${a#rootfstype=} ;;
    rootflags=*)  flags=${a#rootflags=} ;;
    ro)           modo=ro ;;
    rw)           modo=rw ;;
    rootwait)     espera=300 ;;
    rootdelay=*)  retraso=${a#rootdelay=} ;;
    init=*)       programa=${a#init=} ;;
    rd.break)     parar=1 ;;
    rd.debug)     set -x ;;
  esac
done

emergencia(){
  echo
  di "$1"
  echo "  (es) Tienes una consola para arreglarlo; escribe «exit» para reintentar."
  echo "  (en) You have a shell to fix it; type \"exit\" to try again."
  setsid -c bash -i 2>/dev/null || bash -i
}

# teclado (para escribir la contraseña del disco cifrado)
if [ -r /etc/vconsole.conf ] && command -v loadkeys >/dev/null; then
  KEYMAP=$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf | tr -d '"')
  [ -n "$KEYMAP" ] && loadkeys -q "$KEYMAP" 2>/dev/null
fi

# udev carga los módulos de los discos y crea /dev/disk/by-*
/usr/lib/systemd/systemd-udevd --daemon --resolve-names=never
udevadm trigger --type=subsystems --action=add
udevadm trigger --type=devices --action=add
udevadm settle --timeout=30

[ "$retraso" -gt 0 ] 2>/dev/null && sleep "$retraso"

dispositivo(){
  case "$raiz" in
    UUID=*)      echo "/dev/disk/by-uuid/${raiz#UUID=}" ;;
    PARTUUID=*)  echo "/dev/disk/by-partuuid/${raiz#PARTUUID=}" ;;
    LABEL=*)     echo "/dev/disk/by-label/${raiz#LABEL=}" ;;
    PARTLABEL=*) echo "/dev/disk/by-partlabel/${raiz#PARTLABEL=}" ;;
    *)           echo "$raiz" ;;
  esac
}

while :; do
  [ -n "$raiz" ] || { emergencia "Falta root= en la línea del kernel / root= is missing"; continue; }
  dev=$(dispositivo); t=0
  until [ -b "$dev" ]; do
    # por si udev no ha creado el enlace: que lo busque blkid
    d=$(blkid -l -o device -t "$raiz" 2>/dev/null) && [ -b "$d" ] && { dev=$d; break; }
    [ "$t" = 1 ] && di "esperando al disco $raiz… / waiting for $raiz…"
    [ "$t" -ge $((espera * 2)) ] && break
    sleep 0.5; t=$((t + 1)); udevadm settle --timeout=2
  done
  [ -b "$dev" ] || { emergencia "No encuentro el disco $raiz / Cannot find $raiz"; continue; }

  # disco cifrado con LUKS: se pide la contraseña
  if [ "$(blkid -o value -s TYPE "$dev")" = crypto_LUKS ]; then
    if ! command -v cryptsetup >/dev/null; then emergencia "Disco cifrado pero falta cryptsetup / missing cryptsetup"; continue; fi
    modprobe -q dm_crypt
    di "el disco está cifrado / the disk is encrypted"
    until [ -b /dev/mapper/naranjos-raiz ]; do
      cryptsetup open --tries 3 "$dev" naranjos-raiz || emergencia "No se pudo abrir el disco cifrado / Could not unlock the disk"
    done
    dev=/dev/mapper/naranjos-raiz
  fi

  [ -n "$tipo" ] || tipo=$(blkid -o value -s TYPE "$dev")
  [ -n "$tipo" ] && modprobe -q "$tipo" 2>/dev/null
  if mount ${tipo:+-t "$tipo"} -o "$modo${flags:+,$flags}" "$dev" /sysroot; then
    if [ -e "/sysroot$programa" ] || [ -L "/sysroot$programa" ]; then break; fi
    umount /sysroot
    emergencia "En $dev no está $programa / $programa not found on $dev"
  else
    emergencia "No se pudo montar $dev / Could not mount $dev"
  fi
  tipo=""
done

[ "$parar" = 1 ] && emergencia "rd.break: la raíz está en /sysroot / root is mounted at /sysroot"

# udev se apaga: el del sistema toma el relevo
udevadm control --exit
udevadm info --cleanup-db >/dev/null 2>&1
exec switch_root /sysroot "$programa" "$@"
