#!/usr/bin/bash
# /init del initramfs de NaranjOS (lo crea naranjos-initramfs)
# Prepara lo justo para encontrar y montar la raíz, y le pasa el testigo al systemd del sistema.
# Opciones del kernel que entiende:
#   root=UUID=… | PARTUUID=… | LABEL=… | PARTLABEL=… | /dev/…   rootfstype=…   rootflags=…
#   ro | rw   rootwait   rootdelay=<s>   init=<ruta>   rd.break (shell antes de arrancar)   rd.debug
#   naranjos.vivo=<etiqueta>  NaranjOS en vivo (la ISO): busca el medio con esa etiqueta, monta su
#                      naranjos/x86_64/raiz.sfs y le pone encima un overlay en memoria
#   naranjos.foto=<n>  arranca una foto del sistema (naranjos-fotos): la foto es de solo lectura y
#                      se le pone encima un overlay en memoria; lo que cambie se pierde al apagar
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
mount -t proc     proc /proc -o nosuid,nodev,noexec
mount -t sysfs    sys  /sys  -o nosuid,nodev,noexec
mount -t devtmpfs dev  /dev  -o mode=0755,nosuid
mount -t tmpfs    run  /run  -o nosuid,nodev,mode=0755
exec </dev/console >/dev/console 2>&1

N=$'\e[1;38;5;208m'; Z=$'\e[0m'
di(){ if command -v plymouth >/dev/null && plymouth --ping 2>/dev/null; then plymouth display-message --text="$*"; else echo "${N}NaranjOS:${Z} $*"; fi; }

vivo="" raiz="" tipo="" flags="" modo=ro espera=10 retraso=0 programa=/sbin/init parar=0 foto=""
read -r -a args < /proc/cmdline
for a in "${args[@]}"; do
  case "$a" in
    root=*)       raiz=${a#root=} ;;
    rootfstype=*) tipo=${a#rootfstype=} ;;
    rootflags=*)  flags=${a#rootflags=} ;;
    ro)           modo=ro ;;
    rw)           modo=rw ;;
    rootwait)     espera=300 ;;
    rootdelay=*)  retraso=${a#rootdelay=} ;;
    init=*)       programa=${a#init=} ;;
    rd.break)     parar=1 ;;
    rd.debug)     set -x ;;
    naranjos.foto=*) foto=${a#naranjos.foto=} ;;
    naranjos.vivo=*) vivo=${a#naranjos.vivo=} ;;
  esac
done

emergencia(){
  command -v plymouth >/dev/null && plymouth --ping 2>/dev/null && plymouth quit
  echo
  di "$1"
  echo "  (es) Tienes una consola para arreglarlo; escribe «exit» para reintentar."
  echo "  (en) You have a shell to fix it; type \"exit\" to try again."
  setsid -c bash -i 2>/dev/null || bash -i
}

# teclado (para escribir la contraseña del disco cifrado)
if [ -r /etc/vconsole.conf ] && command -v loadkeys >/dev/null; then
  KEYMAP=$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf); KEYMAP=${KEYMAP//\"/}   # sin «tr»: no va en el initramfs
  [ -n "$KEYMAP" ] && loadkeys -q "$KEYMAP" 2>/dev/null
fi

# udev carga los módulos de los discos y crea /dev/disk/by-*
SYSTEMD_LOG_LEVEL=err /usr/lib/systemd/systemd-udevd --daemon --resolve-names=never >/dev/null 2>&1
udevadm trigger --type=subsystems --action=add
udevadm trigger --type=devices --action=add

# la pantalla de arranque de NaranjOS (Plymouth), con «splash» en la línea del kernel
splash=0
for a in "${args[@]}"; do [ "$a" = splash ] && splash=1; done
if [ "$splash" = 1 ] && command -v plymouthd >/dev/null; then
  mkdir -p /run/plymouth
  plymouthd --mode=boot --pid-file=/run/plymouth/pid --attach-to-session && plymouth show-splash
fi
hay_splash(){ plymouth --ping 2>/dev/null; }

udevadm settle --timeout=30
# los controladores de discos, a mano (udev no siempre los carga solo en el initramfs: en QEMU no cargó ni
# ahci ni virtio): SATA/AHCI, NVMe, virtio, USB y CD/DVD. Los que no hacen falta no molestan (0.6.2)
for m in ahci ata_piix sd_mod sr_mod cdrom nvme virtio_pci virtio_blk virtio_scsi xhci_pci ehci_pci uhci_hcd ohci_pci \
         usb_storage uas; do modprobe -q "$m" 2>/dev/null; done
udevadm settle --timeout=10

[ "$retraso" -gt 0 ] 2>/dev/null && sleep "$retraso"
[ -n "$foto" ] && modo=ro

dispositivo(){
  case "$raiz" in
    UUID=*)      echo "/dev/disk/by-uuid/${raiz#UUID=}" ;;
    PARTUUID=*)  echo "/dev/disk/by-partuuid/${raiz#PARTUUID=}" ;;
    LABEL=*)     echo "/dev/disk/by-label/${raiz#LABEL=}" ;;
    PARTLABEL=*) echo "/dev/disk/by-partlabel/${raiz#PARTLABEL=}" ;;
    *)           echo "$raiz" ;;
  esac
}

# NaranjOS en vivo (la ISO): el medio, por su etiqueta; la raíz, su squashfs; los cambios, en memoria
if [ -n "$vivo" ]; then
  V=/run/naranjos-vivo
  for m in isofs squashfs overlay loop; do modprobe -q "$m" 2>/dev/null; done
  mkdir -p "$V/medio" "$V/abajo" "$V/arriba"
  while :; do
    d=""; t=0
    until d=$(blkid -l -o device -t "LABEL=$vivo" 2>/dev/null) && [ -b "$d" ]; do
      [ "$t" = 2 ] && di "buscando el USB o DVD de NaranjOS… / looking for the NaranjOS USB or DVD…"
      [ "$t" -ge 120 ] && break
      sleep 0.5; t=$((t + 1)); udevadm settle --timeout=2
    done
    [ -b "$d" ] || { emergencia "No encuentro el medio de NaranjOS ($vivo) / Cannot find the NaranjOS medium ($vivo)"; continue; }
    mount -o ro "$d" "$V/medio" 2>/dev/null || mount -t iso9660 -o ro "$d" "$V/medio" \
      || { emergencia "No se pudo montar $d / Could not mount $d"; continue; }
    if mount -o ro,loop "$V/medio/naranjos/x86_64/raiz.sfs" "$V/abajo"; then break; fi
    umount "$V/medio"
    emergencia "No se pudo abrir naranjos/x86_64/raiz.sfs / Could not open the live root"
  done
  mount -t tmpfs -o mode=0755,size=75% naranjos-vivo "$V/arriba"
  mkdir -p "$V/arriba/cambios" "$V/arriba/trabajo"
  until mount -t overlay naranjos-vivo -o "lowerdir=$V/abajo,upperdir=$V/arriba/cambios,workdir=$V/arriba/trabajo" /sysroot; do
    emergencia "No se pudo montar la raíz en vivo / Could not mount the live root"
  done
  printf 'dev=%s\n' "$d" > /run/naranjos-vivo.estado
  di "NaranjOS en vivo: lo que cambies se pierde al apagar / live session: changes are lost at shutdown"
fi

while [ -z "$vivo" ]; do
  [ -n "$raiz" ] || { emergencia "Falta root= en la línea del kernel / root= is missing"; continue; }
  dev=$(dispositivo); t=0
  until [ -b "$dev" ]; do
    # por si udev no ha creado el enlace: que lo busque blkid
    d=$(blkid -l -o device -t "$raiz" 2>/dev/null) && [ -b "$d" ] && { dev=$d; break; }
    [ "$t" = 1 ] && di "esperando al disco $raiz… / waiting for $raiz…"
    [ "$t" -ge $((espera * 2)) ] && break
    sleep 0.5; t=$((t + 1)); udevadm settle --timeout=2
  done
  [ -b "$dev" ] || { emergencia "No encuentro el disco $raiz / Cannot find $raiz"; continue; }

  # disco cifrado con LUKS: se pide la contraseña
  if [ "$(blkid -o value -s TYPE "$dev")" = crypto_LUKS ]; then
    if ! command -v cryptsetup >/dev/null; then emergencia "Disco cifrado pero falta cryptsetup / missing cryptsetup"; continue; fi
    modprobe -q dm_crypt
    di "el disco está cifrado / the disk is encrypted"
    until [ -b /dev/mapper/naranjos-raiz ]; do
      if hay_splash; then
        plymouth ask-for-password --prompt="Contraseña del disco · Disk password" --number-of-tries=3 \
          --command="cryptsetup open $dev naranjos-raiz --key-file=-" || emergencia "No se pudo abrir el disco cifrado / Could not unlock the disk"
      else
        cryptsetup open --tries 3 "$dev" naranjos-raiz || emergencia "No se pudo abrir el disco cifrado / Could not unlock the disk"
      fi
    done
    dev=/dev/mapper/naranjos-raiz
  fi

  [ -n "$tipo" ] || tipo=$(blkid -o value -s TYPE "$dev")
  [ -n "$tipo" ] && modprobe -q "$tipo" 2>/dev/null
  if mount ${tipo:+-t "$tipo"} -o "$modo${flags:+,$flags}" "$dev" /sysroot; then
    if [ -e "/sysroot$programa" ] || [ -L "/sysroot$programa" ]; then break; fi
    umount /sysroot
    emergencia "En $dev no está $programa / $programa not found on $dev"
  else
    emergencia "No se pudo montar $dev / Could not mount $dev"
  fi
  tipo=""
done

# una foto: debajo, la foto (solo lectura); encima, los cambios en memoria (tmpfs)
if [ -n "$foto" ]; then
  F=/run/naranjos-foto.d
  modprobe -q overlay 2>/dev/null
  mkdir -p "$F/abajo" "$F/arriba"
  mount --move /sysroot "$F/abajo"
  mount -t tmpfs -o mode=0755 naranjos-foto "$F/arriba"
  mkdir -p "$F/arriba/cambios" "$F/arriba/trabajo"
  until mount -t overlay naranjos-foto -o "lowerdir=$F/abajo,upperdir=$F/arriba/cambios,workdir=$F/arriba/trabajo" /sysroot; do
    emergencia "No se pudo montar la foto $foto / Could not mount snapshot $foto"
  done
  # la raíz ya está montada: que systemd no la vuelva a montar según el fstab (el resto, sí)
  if [ -f /sysroot/etc/fstab ]; then
    grep -v -E '^[[:space:]]*[^#[:space:]]+[[:space:]]+/[[:space:]]' /sysroot/etc/fstab > /run/fstab.foto || true
    cat /run/fstab.foto > /sysroot/etc/fstab
  fi
  printf 'n=%s\ndev=%s\n' "$foto" "$dev" > /run/naranjos-foto
  di "foto $foto del sistema: lo que cambies se pierde al apagar / snapshot $foto: changes are lost at shutdown"
fi

[ "$parar" = 1 ] && emergencia "rd.break: la raíz está en /sysroot / root is mounted at /sysroot"

# udev se apaga: el del sistema toma el relevo
udevadm control --exit
udevadm info --cleanup-db >/dev/null 2>&1
hay_splash && plymouth update-root-fs --new-root-dir=/sysroot
exec switch_root /sysroot "$programa" "$@"
