# caché de iconos de Papirus (miles de ficheros: sin caché, las aplicaciones tardan en abrir)
post_install() {
  local t
  for t in Papirus Papirus-Dark Papirus-Light; do
    [ -d "/usr/share/icons/$t" ] && gtk-update-icon-cache -q -f -t "/usr/share/icons/$t" 2>/dev/null
  done
  return 0
}
post_upgrade() { post_install; }
