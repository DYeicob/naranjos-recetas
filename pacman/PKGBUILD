# Receta de pacman para NaranjOS (motor de zumo)
pkgname=pacman
pkgver=7.1.0
pkgrel=1
pkgdesc='Motor de paquetes de NaranjOS (zumo lo usa por dentro)'
arch=('x86_64')
url='https://pacman.archlinux.page/'
license=('GPL-2.0-or-later')
depends=('bash' 'glibc' 'libarchive' 'curl' 'gpgme' 'openssl' 'gnupg' 'fakeroot')
makedepends=('meson' 'ninja')
backup=('etc/pacman.conf' 'etc/makepkg.conf' 'etc/makepkg.conf.d/naranjos.conf')
source=('pacman-7.1.0.tar.xz' 'pacman.conf' 'naranjos.conf')
sha256sums=('abed8e61942a78717821c914c5a8675e4bbbfddd0673a72d5d83b114edd14f99'
            '92a69d450e75601b8a9d3474f549377bd5faa0ed3ea3b04c872bbe940c8285a9'
            '5a06e9d8ed714e6785a447a8246a14faaf6e6c47cc4a6cfb03a4dc1a2d8eb3c2')

build() {
  cd "pacman-package-manager-7.1.0"
  meson setup build \
        --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --buildtype=plain \
        -D scriptlet-shell=/usr/bin/bash \
        -D ldconfig=/usr/sbin/ldconfig \
        -D doc=disabled -D crypto=openssl -D gpgme=enabled -D curl=enabled
  meson compile -C build
}

package() {
  cd "pacman-package-manager-7.1.0"
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 "$srcdir/pacman.conf"  "$pkgdir/etc/pacman.conf"
  install -Dm644 "$srcdir/naranjos.conf" "$pkgdir/etc/makepkg.conf.d/naranjos.conf"
}
