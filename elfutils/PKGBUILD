# Receta de NaranjOS — generada por naranjos-tanda-6f7.sh
pkgname=elfutils
pkgver=0.195
pkgrel=1
pkgdesc='Biblioteca para leer ficheros ELF (libelf)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-or-later' 'LGPL-3.0-or-later')
depends=('zlib' 'zstd' 'xz' 'bzip2')
makedepends=()
source=('https://sourceware.org/ftp/elfutils/0.195/elfutils-0.195.tar.bz2')
sha256sums=('37629fdf7f1f3dc2818e138fca2b8094177d6c2d0f701d3bb650a561218dc026')
provides=('libelf')
build() {
  cd elfutils-$pkgver
  ./configure --prefix=/usr --disable-debuginfod --enable-libdebuginfod=dummy
  make -C lib
  make -C libelf
}
package() {
  cd elfutils-$pkgver
  make -C libelf DESTDIR="$pkgdir" install
  install -Dm644 config/libelf.pc "$pkgdir/usr/lib/pkgconfig/libelf.pc"
  rm -f "$pkgdir/usr/lib/libelf.a"
}
