# Receta de NaranjOS — generada por naranjos-tanda-5a4.sh a partir de BLFS 13.1-systemd
pkgname=pango
pkgver=1.58.2
pkgrel=1
pkgdesc='Dibujo de texto internacional'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('LGPL-2.1-or-later')
depends=('cairo' 'fontconfig' 'fribidi' 'glib2' 'harfbuzz' 'libxft')
makedepends=()
source=('https://download.gnome.org/sources/pango/1.58/pango-1.58.2.tar.xz')
sha256sums=('342385b6ca3b7c73455d7c80a13b7dbe4489e00bc3bd4c5bd6ed4dce421e374a')
build()   { cd pango-$pkgver
  meson setup build --prefix=/usr --buildtype=plain --wrap-mode=nofallback -D introspection=disabled
  meson compile -C build; }
package() { cd pango-$pkgver; DESTDIR="$pkgdir" meson install -C build; }
