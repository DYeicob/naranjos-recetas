pkgname=python-setuptools
pkgver=84.0.0
pkgrel=1
pkgdesc='Herramientas para instalar módulos de Python (setuptools)'
arch=('any')
url='https://github.com/DYeicob/naranjos-recetas'
license=('MIT')
depends=('python' )
makedepends=()
source=('https://pypi.org/packages/source/s/setuptools/setuptools-84.0.0.tar.gz')
sha256sums=('f4695c21257f0d9b537ec2692c941d02ee143b7cc1276941349a546573b2ef73')
build() {
  cd setuptools-84.0.0
  pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}
package() {
  cd setuptools-84.0.0
  pip3 install --root="$pkgdir" --prefix=/usr --no-index --find-links dist --no-deps --no-warn-script-location                --ignore-installed setuptools
}
