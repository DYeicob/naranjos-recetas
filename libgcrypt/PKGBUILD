# Receta de NaranjOS — generada por naranjos-tanda-6f10.sh
pkgname=libgcrypt
pkgver=1.12.2
pkgrel=1
pkgdesc='Criptografía de GnuPG (cifrado, firmas, sumas)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('LGPL-2.1-or-later')
depends=('libgpg-error')
makedepends=()
source=('https://www.gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-1.12.2.tar.bz2')
sha256sums=('7ce33c2492221a0436f96a8500215e9f3e3dcb5fd26a757cd415e7a843babd5e')
build() {
  cd libgcrypt-$pkgver
  ./configure --prefix=/usr
  make
}
package() {
  cd libgcrypt-$pkgver
  make DESTDIR="$pkgdir" install
  install -dm755 "$pkgdir/usr/share/doc/libgcrypt-$pkgver"
  install -m644 README doc/{README.apichanges,fips*,libgcrypt*} "$pkgdir/usr/share/doc/libgcrypt-$pkgver"
}
