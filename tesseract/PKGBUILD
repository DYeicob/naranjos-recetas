# Receta de NaranjOS — generada por naranjos-tanda-6o.sh
pkgname=tesseract
pkgver=5.5.4
pkgrel=1
pkgdesc='Reconocimiento de texto en imágenes (OCR), sin internet'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('Apache-2.0')
depends=('leptonica' )
makedepends=('cmake')
source=('https://github.com/tesseract-ocr/tesseract/archive/5.5.4/tesseract-5.5.4.tar.gz')
sha256sums=('a8dbf8b8c8ee427ff6ad1d99116502feaf59440af1adb893caf60a6576826cf4')
build() {
  cmake -S tesseract-$pkgver -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_BUILD_TYPE=Release \
    -D BUILD_SHARED_LIBS=ON -D BUILD_TRAINING_TOOLS=OFF -D GRAPHICS_DISABLED=ON -D DISABLE_CURL=ON -D DISABLE_ARCHIVE=ON \
    -D DISABLE_TIFF=ON -D ENABLE_NATIVE=OFF -D OPENMP_BUILD=OFF -D ENABLE_CCACHE=OFF
  cmake --build build
}
package() { DESTDIR="$pkgdir" cmake --install build; }
