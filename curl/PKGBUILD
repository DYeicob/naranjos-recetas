# Receta de NaranjOS — generada por naranjos-tanda-6f9.sh
pkgname=curl
pkgver=8.23.0
pkgrel=1
pkgdesc='Descargas por internet (lo usan zumo, git, Flatpak…)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('curl')
depends=('openssl' 'zlib' 'zstd' 'brotli' 'libpsl' 'libidn2' 'nghttp2' 'make-ca')
makedepends=()
source=('https://github.com/curl/curl/releases/download/curl-8_23_0/curl-8.23.0.tar.xz')
sha256sums=('8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5')
build() {
  cd curl-$pkgver
  ./configure --prefix=/usr --disable-static --with-openssl --with-ca-path=/etc/ssl/certs
  make
}
package() {
  cd curl-$pkgver
  make DESTDIR="$pkgdir" install
  rm -rf docs/examples/.deps
  find docs \( -name Makefile\* -o -name \*.1 -o -name \*.3 -o -name CMakeLists.txt \) -delete
  install -d "$pkgdir/usr/share/doc"
  cp -R docs -T "$pkgdir/usr/share/doc/curl-$pkgver"
}
