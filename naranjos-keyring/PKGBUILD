sha256sums=('5e9fec68c5704418a2e35817b901996da4a3273a89483663e16014e3bd25edcf' 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' 'cfb0cdf19344418bd7007039d10d65920c9f9fcd122355a1f99005e7a186816e')
install=naranjos-keyring.install
package() {
  local K="$pkgdir/usr/share/pacman/keyrings"
  install -Dm644 naranjos.gpg     "$K/naranjos.gpg"
  install -Dm644 naranjos-trusted "$K/naranjos-trusted"
  install -Dm644 naranjos-revoked "$K/naranjos-revoked"
}
