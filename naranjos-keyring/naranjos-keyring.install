# textos traducibles (dominio «naranjos»); si aún no está naranjos-idiomas, en español
. /usr/lib/naranjos/naranjos-i18n.sh 2>/dev/null || _(){ printf '%s' "$1"; }
# La clave con la que NaranjOS firma sus paquetes pasa al llavero de pacman
post_install() {
  if [ -d /etc/pacman.d/gnupg ]; then
    pacman-key --populate naranjos >/dev/null 2>&1 && echo "  ✔ $(_ 'llavero de NaranjOS al día')" \
      || echo "  ! $(_ 'no se pudo actualizar el llavero: sudo pacman-key --populate naranjos')"
  else
    echo "  ! $(_ 'pacman aún no tiene llavero: sudo pacman-key --init && sudo pacman-key --populate naranjos')"
  fi
}
post_upgrade() {
  post_install
}
