# Receta de NaranjOS — generada por naranjos-tanda-5a2.sh a partir de BLFS 13.1-systemd
pkgname=spirv-llvm-translator
pkgver=22.1.5
pkgrel=1
pkgdesc='Traductor entre SPIR-V y LLVM (lo usa el driver iris de Intel)'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('NCSA')
depends=('llvm' 'spirv-tools' 'libxml2')
makedepends=('cmake' 'spirv-headers')
source=('https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/v22.1.5/SPIRV-LLVM-Translator-22.1.5.tar.gz')
sha256sums=('3c6dffb4b8d67f5c544370e0c869ec7d22c013d4bb798f24655ec903f26cc5d5')
build()   { cd SPIRV-LLVM-Translator-$pkgver
  cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -D BUILD_SHARED_LIBS=ON \
        -D CMAKE_SKIP_INSTALL_RPATH=ON -D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr -G Ninja
  ninja -C build; }
package() { cd SPIRV-LLVM-Translator-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
