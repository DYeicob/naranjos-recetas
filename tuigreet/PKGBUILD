prepare() { cd tuigreet-$pkgver; cargo fetch --locked; }
build()   { cd tuigreet-$pkgver; cargo build --frozen --release; }
package() { cd tuigreet-$pkgver
  install -Dm755 target/release/tuigreet "$pkgdir/usr/bin/tuigreet"
}
