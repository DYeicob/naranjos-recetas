  pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}
package() {
  cd markupsafe-3.0.3
  pip3 install --root="$pkgdir" --prefix=/usr --no-index --find-links dist --no-deps --no-warn-script-location                --ignore-installed MarkupSafe
}
