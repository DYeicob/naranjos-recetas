# Receta de NaranjOS — generada por naranjos-tanda-6f5.sh
pkgname=iproute2
pkgver=7.1.0
pkgrel=1
pkgdesc='Herramientas de red del kernel (ip, ss, tc…)'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-or-later')
depends=('libcap' 'libelf')
makedepends=()
source=('https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-7.1.0.tar.xz')
sha256sums=('fd9fa1b95809417157ca83dd72957e3261bdbce896353cb936f80af0b33a4b5c')
prepare() { cd iproute2-$pkgver; sed -i /ARPD/d Makefile; rm -f man/man8/arpd.8; }
build()   { cd iproute2-$pkgver; make NETNS_RUN_DIR=/run/netns; }
package() {
  cd iproute2-$pkgver
  make SBINDIR=/usr/sbin DESTDIR="$pkgdir" install
  install -Dm644 COPYING README* -t "$pkgdir/usr/share/doc/iproute2-$pkgver"
}
