pkgname=hyprland-guiutils
pkgver=0.2.2
pkgrel=2
pkgdesc='Diálogos de Hyprland'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('BSD-3-Clause')
depends=('hyprlang' 'hyprtoolkit' 'hyprutils' 'libdrm' 'pixman')
makedepends=('cmake' )
source=('https://github.com/hyprwm/hyprland-guiutils/archive/v0.2.2/hyprland-guiutils-0.2.2.tar.gz')
sha256sums=('16f92a6c5a22ac58e1fc313f6b202c188da45e804e1f21ff57dfd0da5c1a01b7')
build()   { cd hyprland-guiutils-$pkgver; cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -W no-dev -G Ninja; ninja -C build; }
package() { cd hyprland-guiutils-$pkgver; DESTDIR="$pkgdir" ninja -C build install
  rm -f "$pkgdir"/usr/bin/hyprland-{welcome,donate-screen,update-screen}; }
