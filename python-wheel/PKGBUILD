# Receta de NaranjOS — generada por naranjos-tanda-6f6.sh
pkgname=python-wheel
pkgver=0.48.0
pkgrel=1
pkgdesc='Formato wheel de Python'
arch=('any')
url='https://github.com/DYeicob/naranjos-recetas'
license=('MIT')
depends=('python' 'python-packaging')
makedepends=()
source=('https://pypi.org/packages/source/w/wheel/wheel-0.48.0.tar.gz')
sha256sums=('94800765601e9171bf5d58d066e640662842bcedcbab982b2c90787a2c987322')
build() {
  cd wheel-0.48.0
  pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}
package() {
  cd wheel-0.48.0
  pip3 install --root="$pkgdir" --prefix=/usr --no-index --find-links dist --no-deps --no-warn-script-location                --ignore-installed wheel
}
