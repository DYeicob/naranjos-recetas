# Receta de NaranjOS — generada por naranjos-tanda-6r2.sh
pkgname=lvm2
pkgver=2.03.42
pkgrel=1
pkgdesc='LVM2 y device-mapper (volúmenes lógicos; lo necesita cryptsetup)'
provides=('device-mapper')
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-only' 'LGPL-2.1-only')
depends=('libaio' 'systemd' 'util-linux')
makedepends=()
source=('https://sourceware.org/ftp/lvm2/LVM2.2.03.42.tgz')
sha256sums=('352703ef5b72ebb22d4f250284a29b89fe64d4049c6bf64c693f9af486c8081e')
backup=('etc/lvm/lvm.conf' 'etc/lvm/lvmlocal.conf')
build() {
  cd LVM2.$pkgver
  PATH+=:/usr/sbin ./configure --prefix=/usr --enable-cmdlib --enable-pkgconfig --enable-udev_sync
  make
}
package() {
  cd LVM2.$pkgver
  make DESTDIR="$pkgdir" install
  make DESTDIR="$pkgdir" install_systemd_units
  # /var/lock está obsoleto y bloquea el arranque (BLFS)
  sed -e '/locking_dir =/{s/#//;s/var/run/}' -i "$pkgdir/etc/lvm/lvm.conf"
}
