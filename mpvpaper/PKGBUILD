pkgname=mpvpaper
pkgver=1.9
pkgrel=1
pkgdesc='Un vídeo como fondo de escritorio en Wayland'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-3.0-or-later')
depends=('mpv' 'wayland' 'mesa')
makedepends=('meson' 'ninja' 'wayland-protocols')
source=('https://github.com/GhostNaN/mpvpaper/archive/1.9/mpvpaper-1.9.tar.gz')
