license=('custom')
depends=()
makedepends=('cmake')
source=('https://github.com/abseil/abseil-cpp/archive/20260817.0/abseil-cpp-20260817.0.tar.gz')
sha256sums=('f7e05179df39c45434cad433f5783840bb3788ef322976f9138bc6b72b3a107d')
build()   { cd abseil-cpp-$pkgver
  cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -W no-dev -G Ninja -D CMAKE_CXX_STANDARD=17 -D BUILD_SHARED_LIBS=ON -D ABSL_BUILD_TESTING=OFF -D ABSL_PROPAGATE_CXX_STD=ON
  ninja -C build; }
package() { cd abseil-cpp-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
