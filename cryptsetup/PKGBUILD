# Receta de NaranjOS — generada por naranjos-tanda-6r2.sh
pkgname=cryptsetup
pkgver=2.8.7
pkgrel=1
pkgdesc='Cifrado de discos con LUKS'
arch=('x86_64')
url='https://github.com/DYeicob/naranjos-recetas'
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('json-c' 'lvm2' 'popt' 'openssl' 'util-linux')
makedepends=()
source=('https://www.kernel.org/pub/linux/utils/cryptsetup/v2.8/cryptsetup-2.8.7.tar.xz')
sha256sums=('e776f0d381e86ca61042c457069491fe8e0ac286780c7c3b1e4f9921abc961da')
build() {
  cd cryptsetup-$pkgver
  ./configure --prefix=/usr --disable-static --disable-ssh-token --disable-asciidoc
  make
}
package() { cd cryptsetup-$pkgver; make DESTDIR="$pkgdir" install; }
