build()   { cd hyprcursor-$pkgver; cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -W no-dev -G Ninja; ninja -C build; }
package() { cd hyprcursor-$pkgver; DESTDIR="$pkgdir" ninja -C build install; }
