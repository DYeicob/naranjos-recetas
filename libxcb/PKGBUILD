pkgname=libxcb
pkgver=1.17.0
pkgrel=1
pkgdesc='Interfaz C de X11 (XCB)'
arch=('x86_64')
url='https://www.linuxfromscratch.org/blfs/'
license=('custom')
depends=('libxau' 'libxdmcp')
makedepends=('xcb-proto' 'xorg-util-macros')
source=('https://xorg.freedesktop.org/archive/individual/lib/libxcb-1.17.0.tar.xz')
sha256sums=('599ebf9996710fea71622e6e184f3a8ad5b43d0e5fa8c4e407123c88a59a6d55')
build()   { cd libxcb-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --without-doxygen --docdir='${datadir}'/doc/libxcb-$pkgver
  LC_ALL=en_US.UTF-8 make; }
package() { cd libxcb-$pkgver; make DESTDIR="$pkgdir" install; }
